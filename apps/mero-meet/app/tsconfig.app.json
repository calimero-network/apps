{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // `e2e/shots` is TSX that STANDS IN for production modules, so it belongs in
  // the type graph. mero-stream learned this the expensive way: its harness sat
  // outside the typecheck, three mocks drifted out of step with the code they
  // replace, the build still succeeded, and the screenshots quietly documented
  // an empty state instead of the app.
  "include": ["src", "e2e/shots"]
}
