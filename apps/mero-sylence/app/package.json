{
  "name": "mero-sylence",
  "private": true,
  "version": "0.1.0",
  "description": "Sylence — meeting transcripts and action items from a browser extension, on Calimero (component SDK, CalimeroClient)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "(test -f ../extension/dist/manifest.json || pnpm --filter mero-sylence-extension build) && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "icons": "node scripts/gen-icons.mjs",
    "og": "node scripts/gen-og.mjs",
    "codegen": "meroctl app codegen --abi ../logic/res/abi.json --lang ts --name mero-sylence -o src/generated",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@calimero-apps/connect": "workspace:*",
    "@calimero-apps/glass": "workspace:*",
    "@calimero-apps/names": "workspace:*",
    "@calimero-apps/node-served": "workspace:*",
    "@calimero-apps/passkey": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:component",
    "@calimero-network/mero-react": "catalog:component",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "4.3.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@calimero-apps/test-setup": "workspace:*",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "fflate": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "mero-sylence-extension": "workspace:*",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
