{
  "abiVersion": 1,
  "errors": {
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "message": "string"
    },
    "Refused": {
      "message": "string"
    }
  },
  "events": {
    "ActionChanged": {
      "id": "string",
      "meetingId": "string"
    },
    "InsightsChanged": {
      "meetingId": "string"
    },
    "MeetingChanged": {
      "id": "string"
    },
    "TranscriptChanged": {
      "from": "u32",
      "meetingId": "string",
      "to": "u32"
    }
  },
  "methods": {
    "addAction": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds an action item to a meeting and returns its id. Anyone who reaches the app.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "text",
          "string"
        ],
        [
          "assignee",
          "string"
        ],
        [
          "sourceSeq",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "appendSegments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Stores a batch of segments. Numbers already stored are skipped, so a\nbatch can be resent safely. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "segments",
          "list<SegmentInput>"
        ]
      ],
      "public": false,
      "returns": "AppendResult"
    },
    "attachAudio": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Gives the meeting its recording: blob `blob`, which the caller uploaded\nto the app first. Replaces any earlier one (whose blob the node then\ncollects). The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "blob",
          "BlobRef"
        ],
        [
          "mime",
          "string"
        ],
        [
          "durationMs",
          "u32"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "deleteMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a meeting, its action items and up to 1,000 of its segments,\nand returns how many segments remain. The meeting is gone from every\nlist at once; call again until `remaining` is 0. Its recorder or the\ninstance's owner.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "DeleteResult"
    },
    "dropSegments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes the segments numbered `fromSeq` up to (not including)\n`beforeSeq`, at most 1,000 a call. The extension appends a transcript\nredone after the call from `nextSeq` on, then drops the live one\n(`fromSeq` 0), which marks the meeting `revised`; if the upload fails\nhalfway it drops what it sent instead. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "fromSeq",
          "u32"
        ],
        [
          "beforeSeq",
          "u32"
        ]
      ],
      "public": false,
      "returns": "DropResult"
    },
    "editAction": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rewrites an action item and who it is for. Anyone who reaches the app.",
      "kind": "call",
      "params": [
        [
          "actionId",
          "string"
        ],
        [
          "text",
          "string"
        ],
        [
          "assignee",
          "string"
        ]
      ],
      "public": false,
      "returns": "ActionView"
    },
    "editSegment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Corrects one segment's text. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "seq",
          "u32"
        ],
        [
          "text",
          "string"
        ]
      ],
      "public": false,
      "returns": "SegmentView"
    },
    "endMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Ends the recording. `durationMs` is the length the extension measured.\nEnding an ended meeting changes nothing. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "durationMs",
          "u32"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "getMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One meeting.",
      "kind": "view",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "insights": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A meeting's people insights, if any were saved.",
      "kind": "view",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<Insights>"
    },
    "listActions": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A meeting's action items, oldest first.",
      "kind": "view",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<ActionView>"
    },
    "listMeetings": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every meeting, newest first.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<MeetingView>"
    },
    "markNotified": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Notes that everyone in the call was told it is recorded: the extension\nposted the notice in the call's chat. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "myAccount": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The calling account.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "nameSegments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Names the speakers of lines already saved, as the page works them out\nfrom the recording (\"Voice 1\", \"Voice 2\" for a call whose page showed no\nnames). At most 500 lines a call; a line that is not there, or already\nhas that name, is skipped. Answers how many lines changed. The recorder\nor the instance's owner.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "names",
          "list<SegmentName>"
        ]
      ],
      "public": false,
      "returns": "u32"
    },
    "openActions": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every action item not yet done, across meetings, newest meeting first.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<ActionView>"
    },
    "recordingsLeft": {
      "allowSystem": false,
      "confirm": false,
      "doc": "How many more recordings the caller may keep (see [`MAX_RECORDINGS_PER_ACCOUNT`]).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "u32"
    },
    "removeAction": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes an action item. Its author, the meeting's recorder or the\ninstance's owner.",
      "kind": "call",
      "params": [
        [
          "actionId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "removeAudio": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes the meeting's recording; the transcript stays. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "renameMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Renames a meeting. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "title",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "search": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Meetings whose title, and lines whose text, contain every word of\n`query` (any case), newest meeting first and lines in order; at most\n`limit` hits (1–100).",
      "kind": "view",
      "params": [
        [
          "query",
          "string"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "SearchResult"
    },
    "setActionDone": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Ticks an action item off, or back on. Anyone who reaches the app.",
      "kind": "call",
      "params": [
        [
          "actionId",
          "string"
        ],
        [
          "done",
          "bool"
        ]
      ],
      "public": false,
      "returns": "ActionView"
    },
    "setInsights": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Saves what the page worked out about each person, replacing what was\nthere. No people clears them. The recorder or the instance's owner.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "insights",
          "InsightsInput"
        ]
      ],
      "public": false,
      "returns": "option<Insights>"
    },
    "setSpeakerName": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Names speaker `label` (\"Speaker 1\") as `name` (\"Eve\") in this meeting;\nan empty name removes it. The recorder or the instance's owner.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "label",
          "string"
        ],
        [
          "name",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "setSummary": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replaces a meeting's summary (free text, may be empty). The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "summary",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "startMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Starts recording a meeting and returns its id. The caller is its recorder.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ],
        [
          "platform",
          "string"
        ],
        [
          "url",
          "string"
        ],
        [
          "model",
          "string"
        ],
        [
          "language",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "transcript": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Segments from number `fromSeq` on, in order, at most `limit` (1–500).",
      "kind": "view",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "fromSeq",
          "u32"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "TranscriptPage"
    }
  },
  "state": {
    "fields": {
      "actions": "unorderedMap",
      "audioOwner": "unorderedMap",
      "byTime": "set",
      "deleting": "set",
      "insights": "unorderedMap",
      "meetingActions": "set",
      "meetings": "unorderedMap",
      "openActions": "set",
      "recorded": "set",
      "segments": "unorderedMap"
    },
    "search": {
      "actions": [],
      "audioOwner": [],
      "byTime": [],
      "deleting": [],
      "insights": [],
      "meetingActions": [],
      "meetings": [],
      "openActions": [],
      "recorded": [],
      "segments": []
    },
    "version": 1
  },
