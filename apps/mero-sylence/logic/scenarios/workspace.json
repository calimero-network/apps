[
  { "as": "bob", "op": "call", "method": "startMeeting",
    "args": { "title": "Pricing review", "platform": "zoom", "url": "", "model": "moonshine-base", "language": "en" },
    "save": "first" },
  { "as": "cy", "op": "call", "method": "startMeeting",
    "args": { "title": "Standup", "platform": "teams", "url": "", "model": "whisper-base", "language": "" },
    "save": "second" },
  { "as": "bob", "op": "call", "method": "appendSegments",
    "args": { "meetingId": "$first", "segments": [
      { "seq": 0, "startMs": 0, "endMs": 2000, "speaker": "you", "text": "The new pricing page ships Friday" } ] },
    "expect": { "ok": { "added": 1, "skipped": 0, "nextSeq": 1 } } },
  { "as": "cy", "op": "call", "method": "appendSegments",
    "args": { "meetingId": "$second", "segments": [
      { "seq": 0, "startMs": 0, "endMs": 1800, "speaker": "others", "name": "Eve", "text": "I fixed the login bug" },
      { "seq": 1, "startMs": 2000, "endMs": 3900, "speaker": "you", "text": "Eve, can you review it today?" } ] },
    "expect": { "ok": { "added": 2, "skipped": 0, "nextSeq": 2 } } },
  { "as": "bob", "op": "call", "method": "appendSegments",
    "args": { "meetingId": "$second", "segments": [] },
    "expect": { "error": "Forbidden" } },
  { "as": "bob", "op": "view", "method": "transcript",
    "args": { "meetingId": "$first", "fromSeq": 0, "limit": 50 },
    "expect": { "ok": { "segments": [ { "seq": 0, "startMs": 0, "endMs": 2000, "speaker": "you", "name": "", "text": "The new pricing page ships Friday", "edited": false } ], "next": null } } },
  { "as": "bob", "op": "view", "method": "transcript",
    "args": { "meetingId": "$second", "fromSeq": 0, "limit": 1 },
    "expect": { "ok": { "segments": [ { "seq": 0, "startMs": 0, "endMs": 1800, "speaker": "others", "name": "Eve", "text": "I fixed the login bug", "edited": false } ], "next": 1 } } },
  { "as": "cy", "op": "call", "method": "addAction",
    "args": { "meetingId": "$second", "text": "Review the login fix today", "assignee": "Eve", "sourceSeq": 1 },
    "save": "review" },
  { "as": "bob", "op": "view", "method": "search", "args": { "query": "pricing friday", "limit": 20 } },
  { "as": "bob", "op": "view", "method": "search", "args": { "query": "nothing like this", "limit": 20 },
    "expect": { "ok": { "hits": [], "more": false } } },
  { "as": "bob", "op": "view", "method": "search", "args": { "query": "  ", "limit": 20 },
    "expect": { "ok": { "hits": [], "more": false } } },
  { "as": "bob", "op": "call", "method": "endMeeting", "args": { "meetingId": "$first", "durationMs": 2000 } },
  { "as": "cy", "op": "call", "method": "endMeeting", "args": { "meetingId": "$second", "durationMs": 3900 } },
  { "as": "cy", "op": "call", "method": "deleteMeeting", "args": { "meetingId": "$first" },
    "expect": { "error": "Forbidden" } },
  { "as": "bob", "op": "call", "method": "deleteMeeting", "args": { "meetingId": "$first" },
    "expect": { "ok": { "remaining": 0 } } },
  { "as": "bob", "op": "view", "method": "search", "args": { "query": "pricing", "limit": 20 },
    "expect": { "ok": { "hits": [], "more": false } } },
  { "as": "cy", "op": "call", "method": "deleteMeeting", "args": { "meetingId": "$second" },
    "expect": { "ok": { "remaining": 0 } } },
  { "as": "bob", "op": "view", "method": "openActions", "args": {}, "expect": { "ok": [] } },
  { "as": "bob", "op": "view", "method": "listMeetings", "args": {}, "expect": { "ok": [] } }
]
