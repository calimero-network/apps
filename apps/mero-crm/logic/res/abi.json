{
  "abiVersion": 1,
  "errors": {
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "id": "string",
      "what": "string"
    }
  },
  "events": {
    "ActivityChanged": {
      "id": "string"
    },
    "AutomationFired": {
      "automationId": "string",
      "dealId": "string"
    },
    "AutomationsChanged": {},
    "ContactChanged": {
      "id": "string"
    },
    "DealCreated": {
      "id": "string",
      "stageId": "string"
    },
    "DealDeleted": {
      "id": "string"
    },
    "DealMoved": {
      "id": "string",
      "stageId": "string"
    },
    "DealStatusChanged": {
      "id": "string",
      "status": "string"
    },
    "DealUpdated": {
      "id": "string"
    },
    "NoteChanged": {
      "dealId": "string",
      "id": "string"
    },
    "SettingsChanged": {},
    "StagesChanged": {}
  },
  "methods": {
    "addActivity": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Schedules a call, meeting, task, email or deadline, on a deal, a person,\nboth or neither. Returns its id. `kind` is one of `call`, `meeting`,\n`task`, `email`, `deadline`. Emits `ActivityChanged`.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "option<string>"
        ],
        [
          "contactId",
          "option<string>"
        ],
        [
          "kind",
          "string"
        ],
        [
          "subject",
          "string"
        ],
        [
          "dueAt",
          "u64"
        ],
        [
          "owner",
          "option<string>"
        ],
        [
          "note",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "addAutomation": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a rule that schedules a follow-up activity whenever a deal enters a\nstage. In full: \"When a deal enters `stageId`, schedule a `kind`\nactivity called `subject`, due in `dueInDays` days (at most 365).\" At\nmost 10 per stage. Returns the rule's id. Emits `AutomationsChanged`.",
      "kind": "call",
      "params": [
        [
          "stageId",
          "string"
        ],
        [
          "kind",
          "string"
        ],
        [
          "subject",
          "string"
        ],
        [
          "dueInDays",
          "u32"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "addNote": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a note to a deal. The caller is recorded as its author, and its id\nis returned. The note must not be blank and is at most 10,000\ncharacters. Emits `NoteChanged`.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "addStage": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a stage at the end of the pipeline. Returns its id. Takes a name of\n1 to 120 characters and a win probability of 0 to 100; a pipeline holds\nat most 12 stages. Emits `StagesChanged`.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "probability",
          "u32"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "createContact": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a person to the address book. The caller is recorded as their\ncreator, and their id is returned. A name of 1 to 120 characters, the\nother fields at most 120, an email that looks like one (or empty). Emits\n`ContactChanged`.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "email",
          "string"
        ],
        [
          "phone",
          "string"
        ],
        [
          "organization",
          "string"
        ],
        [
          "jobTitle",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "createDeal": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a new deal to a stage of the pipeline. The caller is recorded as\nits creator, and its id is returned. Runs the stage's automations.\n`NotFound` for an unknown stage or contact; `Invalid` for a blank title\nor a field over 120 characters. Emits `DealCreated`, then\n`AutomationFired` per rule that ran.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ],
        [
          "value",
          "u64"
        ],
        [
          "organization",
          "string"
        ],
        [
          "contactId",
          "option<string>"
        ],
        [
          "stageId",
          "string"
        ],
        [
          "owner",
          "option<string>"
        ],
        [
          "expectedClose",
          "option<u64>"
        ],
        [
          "source",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "deleteActivity": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes an activity. Emits `ActivityChanged`.",
      "kind": "call",
      "params": [
        [
          "activityId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteAutomation": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a follow-up rule. Emits `AutomationsChanged`.",
      "kind": "call",
      "params": [
        [
          "automationId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteContact": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes a person from the address book. Only their creator may: anyone\nelse gets `Forbidden`. Deals keep their history but lose the link. Emits\n`ContactChanged`.",
      "kind": "call",
      "params": [
        [
          "contactId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteDeal": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a deal together with its activities and notes. Only its creator\nmay: anyone else gets `Forbidden`. Emits `DealDeleted`.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteNote": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a note from a deal. Only its author may: anyone else gets\n`Forbidden`. Emits `NoteChanged`.",
      "kind": "call",
      "params": [
        [
          "noteId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteStage": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes a stage and its automations from the pipeline. Refused\n(`Invalid`) while any open deal sits in it, and for the last remaining\nstage: a pipeline always has somewhere to put a deal. A closed deal that\nclosed from it and is reopened later is shown in the first stage. Emits\n`StagesChanged`.",
      "kind": "call",
      "params": [
        [
          "stageId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getDeal": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows one deal with its person, activities and notes. Activities come by\ndue date and notes newest first, at most 1,000 of each. `NotFound` for\nan unknown deal.",
      "kind": "view",
      "params": [
        [
          "dealId",
          "string"
        ]
      ],
      "public": false,
      "returns": "DealDetail"
    },
    "getSettings": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows the currency and the number of idle days after which an open deal\ncounts as rotting.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "Settings"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Sets up a new CRM with a five-stage pipeline, US dollars as the currency\nand a 14-day rotting threshold. The node runs it once, as the owner,\nwhen the app is created.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "listActivities": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists scheduled activities by due date. Can be narrowed to one deal\nand/or by whether they are done. At most the first 1,000.",
      "kind": "view",
      "params": [
        [
          "dealId",
          "option<string>"
        ],
        [
          "done",
          "option<bool>"
        ]
      ],
      "public": false,
      "returns": "list<ActivityView>"
    },
    "listAutomations": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the follow-up rules that run when a deal enters a stage. Oldest\nfirst (at most 12 stages × 10 rules).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<AutomationView>"
    },
    "listContacts": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists everyone in the address book with their deal totals. By name, at\nmost the first 1,000.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<ContactView>"
    },
    "listDeals": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists deals, newest first, optionally narrowed by status, stage or\nowner. The filters are exact matches on `status`, `stageId` and `owner`\n(`null` for no filter), and at most the newest 1,000 matches come back.",
      "kind": "view",
      "params": [
        [
          "status",
          "option<string>"
        ],
        [
          "stageId",
          "option<string>"
        ],
        [
          "owner",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "list<DealView>"
    },
    "listStages": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the stages of the pipeline, in order.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<StageView>"
    },
    "markLost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Closes a deal as lost and records why. The reason is at most 120\ncharacters. Emits `DealStatusChanged`.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "string"
        ],
        [
          "reason",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "markWon": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Closes a deal as won. Emits `DealStatusChanged`.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "moveDeal": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Moves an open deal to another stage. Runs that stage's automations.\nMoving to the stage it is already in is a no-op; a closed deal is\n`Invalid`. Emits `DealMoved`, then `AutomationFired` per rule that ran.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "string"
        ],
        [
          "stageId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "reopenDeal": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Puts a closed deal back on the board, in the stage it closed from, or in\nthe first stage if that one was deleted. An open deal is left as it is.\nEmits `DealStatusChanged`.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "reorderStages": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Puts the stages of the pipeline in a new order. `stageIds` must name\nevery stage exactly once (else `Invalid`). Emits `StagesChanged`.",
      "kind": "call",
      "params": [
        [
          "stageIds",
          "list<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "rescheduleActivity": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Moves an activity to a new due time. Emits `ActivityChanged`.",
      "kind": "call",
      "params": [
        [
          "activityId",
          "string"
        ],
        [
          "dueAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setActivityDone": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Marks an activity as done, or as not done again. Emits\n`ActivityChanged`.",
      "kind": "call",
      "params": [
        [
          "activityId",
          "string"
        ],
        [
          "done",
          "bool"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setAutomationEnabled": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Turns a follow-up rule on or off. Emits `AutomationsChanged`.",
      "kind": "call",
      "params": [
        [
          "automationId",
          "string"
        ],
        [
          "enabled",
          "bool"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setCurrency": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes the currency deal values are shown in. Takes a three-letter ISO\n4217 code such as `EUR` (any case; stored upper case), else `Invalid`.\nEmits `SettingsChanged`.",
      "kind": "call",
      "params": [
        [
          "currency",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setRottingDays": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Sets how many days without activity make an open deal count as rotting.\nTakes 1 to 365, else `Invalid`. Emits `SettingsChanged`.",
      "kind": "call",
      "params": [
        [
          "days",
          "u32"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateContact": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes a person's details. Follows the same rules as `createContact`.\n`NotFound` for an unknown contact. Emits `ContactChanged`.",
      "kind": "call",
      "params": [
        [
          "contactId",
          "string"
        ],
        [
          "name",
          "string"
        ],
        [
          "email",
          "string"
        ],
        [
          "phone",
          "string"
        ],
        [
          "organization",
          "string"
        ],
        [
          "jobTitle",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateDeal": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes a deal's details. Every field is written. `NotFound` for an\nunknown deal or contact. Emits `DealUpdated`.",
      "kind": "call",
      "params": [
        [
          "dealId",
          "string"
        ],
        [
          "title",
          "string"
        ],
        [
          "value",
          "u64"
        ],
        [
          "organization",
          "string"
        ],
        [
          "contactId",
          "option<string>"
        ],
        [
          "owner",
          "option<string>"
        ],
        [
          "expectedClose",
          "option<u64>"
        ],
        [
          "source",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateStage": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Renames a stage and changes its chance of winning. `NotFound` for an\nunknown stage. Emits `StagesChanged`.",
      "kind": "call",
      "params": [
        [
          "stageId",
          "string"
        ],
        [
          "name",
          "string"
        ],
        [
          "probability",
          "u32"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
