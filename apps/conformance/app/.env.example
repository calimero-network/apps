# Where the matrix page connects (packages/connect). Nothing here is needed for
# local development: `pnpm dev:local conformance` starts merod local, builds
# the component and writes .env.development.local with the target and nodes.
#
# VITE_CALIMERO_TARGET=local
# VITE_CALIMERO_NODES=http://127.0.0.1:2501,http://127.0.0.1:2502,http://127.0.0.1:2503

# A production build (`vite build`) targets a Calimero Cloud cluster by name and
# refuses to start without these two. The matrix WRITES there (accounts, an
# org, apps, packages): point it only at a cluster you mean to test.
VITE_CALIMERO_CLUSTER=
VITE_CALIMERO_MIN_RELEASE=

# Optional: try this zone's nodes first; another node directory (staging).
# VITE_CALIMERO_ZONE=
# VITE_CALIMERO_DIRECTORY=
