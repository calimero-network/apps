          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "dir",
          "type": {
            "kind": "f64"
          },
          "doc": "facing: -1 | 1"
        },
        {
          "name": "sel",
          "type": {
            "kind": "u32"
          }
        },
        {
