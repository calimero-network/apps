  "methods": [
    {
      "name": "book_slot",
      "doc": "Book the slot starting at `start_ms`. A link books once: after this it\ncan only reschedule or cancel.",
      "params": [
        {
          "name": "token",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "start_ms",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "guest",
          "type": {
            "$ref": "GuestDetails"
          }
        }
      ],
      "returns": {
        "$ref": "BookingView"
      },
      "intent": "mutating"
    },
    {
      "name": "cancel_booking",
      "doc": "Cancel the link's meeting. The link is spent afterwards.",
      "params": [
        {
          "name": "token",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "create_booking_link",
      "doc": "Create a booking link for the access-grant token whose SHA-256 is\n`link.token_hash`. The owner's client issued the grant first; the token\nitself never reaches the contract from the owner.",
      "params": [
        {
          "name": "link",
          "type": {
            "$ref": "CreateBookingLink"
          }
        }
      ],
      "returns": {
        "$ref": "BookingLinkView"
      },
      "intent": "mutating"
    },
    {
      "name": "create_event",
      "doc": "Create an event, routing it to private or shared storage BY WHETHER\nANYONE ELSE IS IN IT.\n\nAn event with no peers is one person's own entry. Writing it to\n`#[app::state]` would replicate it to every node in the context and put\nit in the DAG permanently — for data that, by definition, nobody else is\nparty to. So it goes to `#[app::private]` instead: node-local, never\ngossiped, no DAG growth.\n\nPeers are what make an event shared. The moment there is someone to share\nit WITH, replication is the point, and it goes to the DAG.\n\n⚠️ This is enforced HERE and not in the client, deliberately. The\nfrontend already had a `private` flag it could route on, but a client\nchoosing whether data enters the permanent replicated log is a client\ndeciding someone else's privacy. The contract is the only place that\ncannot be bypassed.\n\n`create_private_event` remains for \"private even though peers were\nnamed\" — an explicit override rather than the default path.",
      "params": [
        {
          "name": "event_data",
          "type": {
            "$ref": "CreateCalendarEvent"
          }
        },
        {
          "name": "timestamp",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "create_private_event",
      "doc": "Private events live in `#[app::private]` storage, so they are never\nreplicated to peers. `peers` on the request is ignored — a private event\nis, by definition, not shared.\n\nTakes `&mut self` so the runtime commits and flushes the private write;\na `&self` method's private writes would be silently discarded.",
      "params": [
        {
          "name": "event_data",
          "type": {
            "$ref": "CreateCalendarEvent"
          }
        },
        {
          "name": "timestamp",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_booking_link",
      "doc": "Delete a link. A meeting it booked stays in the calendar; delete that\nevent to drop it. The caller revokes the link's access grant too.",
      "params": [
        {
          "name": "link_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_event",
      "params": [
        {
          "name": "event_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_private_event",
      "params": [
        {
          "name": "event_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "get_available_slots",
      "doc": "The start times, in Unix milliseconds, the link behind `token` offers in\n`[from_ms, to_ms)`. At most `MAX_SLOT_RANGE_DAYS` wide.",
      "params": [
        {
          "name": "token",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "from_ms",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "to_ms",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "list",
        "items": {
          "kind": "u64"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_booking_page",
      "doc": "What the link behind `token` offers, and its booking if it has one.",
      "params": [
        {
          "name": "token",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "BookingPage"
      },
      "intent": "read_only"
    },
    {
      "name": "get_events",
      "doc": "The shared events the caller owns or is invited to — two seeks, on the\n`owner` and `peers` indexes.\n\nThis is a view filter, not access control: every member's node holds\nevery shared event. See the module docs.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "CalendarEvent"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_members",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "Member"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_private_events",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "CalendarEvent"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "init",
      "params": [],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "list_booking_links",
      "doc": "Every booking link this node holds, newest first.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "BookingLinkView"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "reschedule_booking",
      "doc": "Move the link's meeting to the slot starting at `start_ms`.",
      "params": [
        {
          "name": "token",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "start_ms",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "$ref": "BookingView"
      },
      "intent": "mutating"
    },
    {
      "name": "set_username",
      "doc": "Register or refresh the caller's display name. Idempotent: first call\njoins, later calls rename. The id is the real signer, so a member can\nonly ever name themselves.",
      "params": [
        {
          "name": "username",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "timestamp",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "update_event",
      "doc": "Update a shared event.\n\n⚠️ Emptying `peers` does NOT move the event back to private storage.\nOnce shared, the event is in the DAG on every node in the context, and the\nDAG is append-only — nothing here can retract it. Moving the local copy\ninto private storage would leave that replicated history in place while\nmaking the UI report the event as private, which is worse than saying\nplainly that sharing is one-way.\n\nRemoving peers changes the audience, not who holds it: `get_events`\nlists an event only to its owner and peers, so it drops out of a\nremoved peer's calendar — but that is a view filter, and every member's\nnode still holds the event.\n\nOnly the owner may update it; every node refuses anyone else's edit.",
      "params": [
        {
          "name": "event_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "event_data",
          "type": {
            "$ref": "UpdateCalendarEvent"
          }
        },
        {
          "name": "timestamp",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "update_private_event",
      "doc": "Update a private event — and PROMOTE it to shared storage if this update\nis what adds the first peer.\n\nThis is the other half of `create_event`'s routing. Without it, an event\ncreated alone and later shared with someone would stay node-local, so the\npeer would never receive it and the share would silently do nothing.\n\nPromotion is one-way, and that is not an omission. Removing every peer\nfrom a shared event does NOT move it back: by then the event is already in\nthe DAG on every node in the context, and the DAG is append-only. Moving\nthe local copy into private storage would leave the replicated history\nuntouched while making the UI claim the event had become private — which\nis a worse outcome than being honest that sharing cannot be undone. See\n`update_event`.",
      "params": [
        {
          "name": "event_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "event_data",
          "type": {
            "$ref": "UpdateCalendarEvent"
          }
        },
        {
          "name": "timestamp",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    }
  ],
