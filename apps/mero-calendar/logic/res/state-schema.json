{
  "schema_version": "wasm-abi/1",
  "types": {
    "CalendarEventState": {
      "kind": "record",
      "doc": "One shared event. Its real owner is the entry's owner stamp; `owner` here is\nonly the key of the `owner` index, and a row whose field disagrees with the\nstamp — what a patched node would write — is dropped on read.",
      "fields": [
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "start",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "end",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "event_type",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "color",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "peers",
          "type": {
            "kind": "list",
            "items": {
              "kind": "bytes",
              "size": 32
            }
          },
          "doc": "One `peers` index row per invitee."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "CalendarState": {
      "kind": "record",
      "fields": [
        {
          "name": "events",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CalendarEventState"
            },
            "crdt_type": "authored_map"
          },
          "doc": "Key is the event id; the value is the shared event, owned by the\naccount that created it. Only that account edits or deletes it."
        },
        {
          "name": "members",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Member"
            }
          },
          "doc": "Each member's display name, in their own slot."
        }
      ]
    },
    "Member": {
      "kind": "record",
      "doc": "A context member with a human-readable display name, in the member's own\n`UserStorage` slot (keyed by ACCOUNT), so the UI can resolve `owner`/`peers`\nto names. `id` is filled from the slot's key on read, never trusted from\nthe stored value.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "username",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "joinedAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "usernameUpdatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Dedicated LWW clock for username edits. Merging on `joined_at` (which\nnever changes after first join) would freeze a username at its first\nvalue across nodes; this is the real last-writer-wins timestamp."
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "CalendarState",
  "state_version": 1
}