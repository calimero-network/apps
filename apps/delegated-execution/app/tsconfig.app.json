{
  "// note": "Browser code. Tests are a separate project because they carry node types, which browser code must not have.",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-types/app",
    "tsBuildInfoFile": "./dist-types/app.tsbuildinfo",
    "types": ["vite/client"]
