    "Invoice": {
      "kind": "record",
      "doc": "A sales invoice or a bill while it is a DRAFT. Approving it freezes a copy\ninto `approvals`, and from then on the ledger reads that copy, never this\nrow — so an edit to these registers after approval (which honest nodes\nrefuse, and a patched node could still write) changes nothing posted.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "`sales` or `bill`. Fixed at creation."
        },
        {
          "name": "contact_id",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "reference",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "issue_date",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "due_date",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "amounts_are",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "lines",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "list",
              "items": {
                "$ref": "Line"
              }
            }
          },
          "doc": "The lines as one value: a draft is edited as a whole form, and two\npeople re-ordering one invoice's lines should not interleave them."
        },
        {
          "name": "notes",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Terms or a note printed on the invoice."
        },
