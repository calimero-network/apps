    "StatementLine": {
      "kind": "record",
      "doc": "One line of a bank statement, imported from the bank's CSV.\n\nThe id is a hash of the line's content (see `statement_line_id`), so two\nmembers importing the same file produce the same rows rather than two\ncopies, and re-importing an overlapping file adds only the new lines.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bank_account_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "date",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "amount",
          "type": {
            "kind": "i64"
          },
          "doc": "Signed: money in is positive, money out negative."
        },
        {
          "name": "matched",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The payment or bank transaction it is reconciled against. Whether the\nline counts as reconciled is derived on read: the target must exist,\nbe live, sit in the same bank account and move the same amount."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
