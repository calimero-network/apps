  "methods": {
    "act": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Record one action (a punch, a kick, a jump) in round `round` of match\n`matchIndex`. `hit` says it connected, `blocked` that it was guarded.\n\nEvery call is one transaction. `matchIndex` and `round` are stated by\nthe client rather than assumed, so a blow thrown in the closing frame of\na round cannot silently land in the next one: it is refused instead\n(`RoundOver`). Emits `Acted`, then `RoundOver` and `MatchOver` when this\nblow decided them.",
      "kind": "call",
      "params": [
        [
          "matchIndex",
          "u32"
        ],
        [
          "round",
          "u32"
        ],
        [
          "id",
          "u32"
        ],
        [
          "kind",
          "string"
        ],
        [
          "hit",
          "bool"
        ],
        [
          "blocked",
          "bool"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "arena": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The whole arena in one call, as the caller sees it at `now` (their\nclock, for who is `online`).",
      "kind": "view",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "ArenaView"
    },
    "history": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every match this arena has fought, oldest first (at most 512).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<MatchSummary>"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A new arena with match 0 waiting for two fighters. `title` defaults to\n`\"Arena\"`; `now` (the creator's clock) is `createdAt`, `\"0\"` when not\ngiven.",
      "kind": "init",
      "params": [
        [
          "title",
          "option<string>"
        ],
        [
          "now",
          "option<u64>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "join": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Announce yourself, or refresh your name and fighter. Emits\n`PlayerJoined` the first time.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "fighter",
          "string"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "pick": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Change fighter. Allowed any time: the look is yours, and the damage\ntable is the same for everybody. Emits `Seated` again when you hold a\ncorner, so the other screen redraws you.",
      "kind": "call",
      "params": [
        [
          "fighter",
          "string"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "rematch": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Start the next match. Corners stay; health and rounds reset. Returns\nthe new match's index. `MatchNotFinished`, `NotInCorner`, and\n`MatchLimit` past 512 matches.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "u32"
    },
    "sit": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Take corner `p1` or `p2`, if it is free. Sitting again in your own\ncorner refreshes your name and fighter.\n\nOne person cannot hold both: this is a game between two people.\n`CornerTaken` when someone else holds it, `InOtherCorner` when you hold\nthe other one.",
      "kind": "call",
      "params": [
        [
          "seat",
          "string"
        ],
        [
          "name",
          "string"
        ],
        [
          "fighter",
          "string"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "stand": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Leave your corner, only before you have fought here: a corner someone\nhas fought from is the record of who fought. `NotInCorner`,\n`AlreadyFought`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
  "state": {
