        {
          "name": "authored_items",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            },
            "crdt_type": "authored_map"
          },
          "doc": "Per-owner keyspace (core rc.57): each account holds its own entry at a\nkey, and only that account edits or removes it."
        },
        {
          "name": "authored_vec",
          "type": {
            "kind": "list",
            "items": {
              "kind": "record",
