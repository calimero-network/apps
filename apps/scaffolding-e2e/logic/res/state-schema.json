                "kind": "string"
              }
            },
            "crdt_type": "authored_vector"
          },
          "doc": "Append-only vector with per-slot ownership; only the pusher can update/tombstone their slot"
        },
        {
          "name": "shared_data",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          },
          "doc": "Group-writable single value; writers rotate at runtime"
        },
        {
          "name": "ws_claim",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "$ref": "WsClaim"
              }
            }
          },
          "doc": "Name and admin. Writers are the workspace admins: the context creator\nfirst, then whoever an admin grants `admin`. Every node checks a write\nagainst them, so a patched member cannot claim or rename it."
        },
        {
          "name": "ws_roles",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "kind": "record",
                "fields": [],
                "crdt_type": "lww_register",
                "inner_type": {
                  "kind": "string"
                }
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "identity -> role, in a writer-set cell with the same writers as\n`ws_claim`: every entry is guarded by it, so a patched member cannot\ngrant itself `admin` or demote the real one. `LwwRegister` values so\ntwo admins changing one member's role concurrently converge."
        },
        {
          "name": "ws_channels",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "ChannelRecord"
            },
            "crdt_type": "authored_map"
          },
          "doc": "context_id -> channel. Keyed by the context id so a re-register of the\nsame context updates rather than duplicates. Each entry is owned by\nthe account that registered it; the workspace admins moderate, so an\nadmin may remove anyone's entry and nobody else may."
        },
        {
          "name": "ws_groups",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "WsGroupRecord"
            },
            "crdt_type": "authored_map"
          },
          "doc": "group_id -> group, owned and moderated as `ws_channels`."
        },
        {
          "name": "ws_pings",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "counter"
          },
          "doc": "Pongs received via `xcall`. Grow-only: a pong is an event that happened,\nand no node can un-happen another node's."
        }
      ]
    },
    "FileRecord": {
      "kind": "record",
      "doc": "File record for blob metadata. Atomic whole-record LWW by `uploaded_at`\n(see `impl_atomic_lww_leaf!`); not a struct of CRDT fields, so no `Mergeable`\nderive.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "blob_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "mime_type",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "uploaded_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "uploaded_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "NestedMap": {
