                "kind": "string"
              }
            },
            "crdt_type": "unordered_map"
          }
        }
      ]
    },
    "WsClaim": {
      "kind": "record",
      "doc": "The workspace claim: its name and the account that made it. Written once,\nby `ws_init`, into a writer-set cell whose writers are the admins.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          },
          "doc": "Empty is the \"not claimed\" sentinel — `ws_init` rejects an empty name."
        },
        {
          "name": "admin",
          "type": {
            "kind": "string"
          },
          "doc": "The account that ran `ws_init`, 64 hex."
        }
      ]
    },
    "WsGroupRecord": {
      "kind": "record",
      "doc": "A group in the workspace directory — the app-level mirror of a node subgroup.",
      "fields": [
