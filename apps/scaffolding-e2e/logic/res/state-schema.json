          "name": "group_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          },
          "doc": "As `ChannelRecord::created_by`: read from the owner stamp."
        },
        {
          "name": "registered_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    }
  },
