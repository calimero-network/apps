          },
          "doc": "Edit count for document (G-Counter)"
        },
        {
          "name": "rga_metadata",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Document metadata (title, owner)"
