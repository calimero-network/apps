{
  "schema_version": "wasm-abi/1",
  "types": {
    "ChannelRecord": {
      "kind": "record",
      "doc": "A channel in the workspace directory: another Calimero **context**, made\ndiscoverable by registering its id here.\n\n`registered_at` exists for the same reason `FileRecord::uploaded_at` does —\n`impl_atomic_lww_leaf!` needs a field to order concurrent writes by, and\nthis is a whole-record value, not a struct of independently mergeable CRDT\nfields. Two members registering the same context id concurrently converge on\nthe later write rather than on a field-by-field mixture of the two.",
      "fields": [
        {
          "name": "context_id",
          "type": {
            "kind": "string"
          },
          "doc": "The target context, 64 hex characters. The map key as well as a field,\nso a listing needs no zip with its keys."
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "topic",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          },
          "doc": "The ACCOUNT that registered it, 64 hex. Listings fill it from the\nentry's owner stamp, never from the stored bytes, which the writer\nchose."
        },
        {
          "name": "registered_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "E2eKvStore": {
      "kind": "record",
      "fields": [
        {
          "name": "kv_items",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Public replicated KV map"
        },
        {
          "name": "handler_counter",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "counter"
          },
          "doc": "Counter for handler executions (CRDT G-Counter - grow only)"
        },
        {
          "name": "user_items_simple",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          },
          "doc": "Simple user-owned data (e.g., profile name)"
        },
        {
          "name": "user_items_nested",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "NestedMap"
            }
          },
          "doc": "Nested user-owned data (e.g., user's private KV store)"
        },
        {
          "name": "frozen_items",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "string"
            }
          },
          "doc": "Content-addressed immutable storage"
        },
        {
          "name": "acl",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          },
          "doc": "Named-role registry. Its backing writer set IS the admin tier, so\n\"who may grant a role\" and \"who may rotate the admins\" are the same\nauthenticated question — there is no separate admin bookkeeping to drift."
        },
        {
          "name": "acl_doc",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          },
          "doc": "Capability-guarded document. Its per-account `OpMask` map is PROJECTED\nfrom `acl`'s roles by `acl_project`; it is deliberately not a second\nsource of truth, which is why nothing here writes the map directly."
        },
        {
          "name": "owned_doc",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          },
          "doc": "Single-owner cell. `SharedStorage` above is a flat writer SET; this is\nthe degenerate case with one writer plus a real transfer operation, and\n`Ownable` enforces the at-most-one invariant that `SharedStorage` does\nnot."
        },
        {
          "name": "games",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Maps game_id -> SHA256(secret) hex"
        },
        {
          "name": "files",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "FileRecord"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "File metadata records"
        },
        {
          "name": "crdt_counters",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "counter"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Map of G-Counters (grow-only, concurrent increments should sum)\nCounter<false> = GCounter (default)"
        },
        {
          "name": "crdt_pn_counters",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "counter"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Map of PN-Counters (supports decrement, concurrent inc/dec should merge correctly)\nCounter<true> = PNCounter (allows decrement)"
        },
        {
          "name": "crdt_registers",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Map of LWW registers (latest timestamp wins)"
        },
        {
          "name": "crdt_metadata",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
