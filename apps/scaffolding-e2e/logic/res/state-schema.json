                  "kind": "string"
                }
              },
              "crdt_type": "unordered_map"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Nested maps (field-level merge)"
        },
        {
          "name": "crdt_metrics",
          "type": {
            "kind": "list",
            "items": {
              "kind": "record",
              "fields": [],
              "crdt_type": "counter"
            },
            "crdt_type": "vector"
          },
          "doc": "Vector of G-Counters (element-wise merge)"
        },
        {
          "name": "crdt_tags",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "list",
              "items": {
                "kind": "string"
              },
              "crdt_type": "unordered_set"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Map of sets (union merge)"
        },
        {
          "name": "sorted_items",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            },
            "crdt_type": "sorted_map"
          },
          "doc": "Key-ordered map."
        },
        {
          "name": "sorted_tags",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            },
            "crdt_type": "sorted_set"
          },
          "doc": "Element-ordered set — the `SortedSet` counterpart of `sorted_items`,\nthrough the same host index path."
        },
        {
          "name": "rga_document",
          "type": {
            "kind": "record",
            "fields": [],
