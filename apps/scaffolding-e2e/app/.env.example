# Node URL. Optional — it only pre-fills the connect screen. Leave it unset on a
# hosted deploy (e.g. Vercel) so the field falls back to http://localhost:2528,
# which is what a visitor running their own node wants anyway.
VITE_NODE_URL=http://localhost:2528

# ── Pick ONE of the two modes below ───────────────────────────────────────────

# Mode 1: Direct App ID
#   Use when you installed the app via `meroctl app install` and have the ID.
#   The app must already be installed on the node: the SDK no longer installs one
#   from a WASM served by this frontend.
VITE_APP_ID=

# Mode 2: Package name
#   The auth frontend resolves the app ID from the node's installed packages
#   or the Calimero registry. Use when installing via .mpk with a package name.
#   This is also the mode a hosted deploy runs in: leaving it unset falls back to
#   the published package below, so no env vars are required on Vercel.
VITE_APPLICATION_PACKAGE=com.calimero.scaffolding-e2e

# If both are set, VITE_APP_ID takes priority.

# Credentials used by the automated Playwright auth setup (global-setup.ts)
E2E_USERNAME=admin
E2E_PASSWORD=password
# Override node URL for auth setup if different from VITE_NODE_URL:
# E2E_NODE_URL=http://localhost:2528
