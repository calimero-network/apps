{
  "version": "1.0",
  "package": "com.calimero.mero-drive-docs",
  "appVersion": "9.0.0",
  "minRuntimeVersion": "0.1.0",
  "metadata": {
    "name": "Mero Drive Docs",
    "description": "Namespace-based document workspace — registry + docs multi-service bundle for Calimero.",
    "author": "Calimero"
  },
  "services": [
    {
      "name": "registry",
      "wasm": { "path": "registry.wasm", "size": 0, "hash": null },
      "abi": { "path": "registry-abi.json", "size": 0, "hash": null }
    },
    {
      "name": "docs",
      "wasm": { "path": "docs.wasm", "size": 0, "hash": null },
      "abi": { "path": "docs-abi.json", "size": 0, "hash": null }
    }
  ],
  "migrations": [],
  "links": {
    "frontend": "http://localhost:5173/"
  }
}
