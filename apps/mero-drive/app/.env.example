# Mero Drive environment variables — ALL OPTIONAL.
#
# Nothing here has to be set to build or deploy. The package id and registry
# URL have committed defaults (src/constants/config.ts, src/App.tsx) and the
# applicationId is resolved per node off the registry during login. Copy to
# `.env.local` (git-ignored) only to override. All VITE_ vars are baked into
# the bundle at build time.

# Override the package id of the multi-service bundle
# (default: com.calimero.mero-drive-docs). This id is also the deep-link slug.
# VITE_PACKAGE_NAME=com.calimero.mero-drive-docs

# Override the registry (default: https://apps.calimero.network).
# VITE_REGISTRY_URL=http://localhost:8082

# ⚠️ Do NOT set this for a deployment. An ApplicationId is assigned PER
# INSTALL, so a baked id is wrong on every node but the one it was copied
# from, and core reports an unknown application as an opaque 500. Only a
# last-resort fallback for non-component code against a self-hosted node.
# VITE_APPLICATION_ID=

# Opt-in Yjs collaborative editing. Off unless set to exactly "true".
# VITE_COLLAB_YJS=true
