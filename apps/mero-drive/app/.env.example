# Copy to `.env.local` (git-ignored) and fill in. All VITE_ vars are
# baked into the bundle at build time.

# Package identifier of the v9 multi-service bundle. MeroProvider uses
# this + VITE_REGISTRY_URL to resolve the applicationId during login.
VITE_PACKAGE_NAME=com.calimero.mero-drive-docs

# Fallback applicationId used when the registry lookup above can't
# resolve the package (offline dev, self-hosted node, etc.). Stable
# under the current derivation, hash(package, signerId), so rebuilds
# no longer move it; this is the id nodes assign the published bundle.
VITE_APPLICATION_ID=GBPPWCnaHWqqZy4ftvhbbnN1khwYZby1B95ZL1uhG4sD

# Calimero apps registry URL. Public default shown; set to your local
# registry (e.g. http://localhost:8082) when testing registry flows.
VITE_REGISTRY_URL=https://apps.calimero.network
