{
  "name": "mero-drive",
  "version": "9.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@calimero-network/mero-icons": "^0.0.4",
    "@calimero-network/mero-js": "^2.2.0",
    "@calimero-network/mero-react": "^2.4.0",
    "@calimero-network/mero-ui": "^0.3.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-highlight": "^3.15.3",
    "@tiptap/extension-link": "^3.15.3",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extension-underline": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "autoprefixer": "^10.4.23",
    "axios": "^1.15.2",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^15.5.18",
    "postcss": "^8.5.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.22.3",
    "styled-components": "^6.1.11",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-environment": "^1.1.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@calimero-network/abi-codegen": "^1.0.2",
    "@eslint/js": "^9.4.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^16.18.98",
    "@types/react": "^19.1.1",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^19.1.1",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^7.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "gh-pages": "^6.1.1",
    "jsdom": "^29.0.1",
    "prettier": "3.3.2",
    "tsx": "^4.21.1",
    "typescript": "^4.9.5",
    "typescript-eslint": "^7.13.0",
    "vite": "^7.3.2",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm lint:src",
    "lint:src": "eslint . --ext .ts,.tsx src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "pnpm lint:src:fix && pnpm lint:check",
    "lint:src:fix": "eslint . --ext .ts,.tsx --fix src",
    "preview": "vite preview",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d build",
    "prettier": "exec prettier . --write",
    "codegen": "calimero-abi-codegen -i ../logic/crates/registry/res/abi.json -o src/api/registry --client-name RegistryClient && calimero-abi-codegen -i ../logic/crates/docs/res/abi.json -o src/api/docs --client-name DocsClient",
    "e2e:landing": "playwright test --project=landing",
    "e2e:single": "playwright test --project=single-node",
    "e2e:two-node": "playwright test --project=two-node",
    "e2e:integration": "playwright test --project=single-node --project=two-node",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:up": "tsx scripts/e2e-up.ts",
    "e2e:up:two-node": "tsx scripts/e2e-up.ts --two-node",
    "e2e:down": "tsx scripts/e2e-down.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "e2e/**",
      "scripts/**"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
