# Dependencies
node_modules/

# Build outputs (except logic/res and logic/dist which must be committed)
app/dist/
logic/target/

# Environment files
.env
.env.local

# Lock files (deployment generates its own)
pnpm-lock.yaml
app/pnpm-lock.yaml
# Untracked so every fresh checkout (CI + new clones) re-resolves the
# `branch = "master"` git deps (calimero-sdk / calimero-storage /
# calimero-storage-macros / calimero-wasm-abi) to current HEAD. Same
# pattern as battleships — keeps the e2e job exercising the up-to-date
# runtime ABI on every PR.
logic/Cargo.lock

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite cache
.vite

# Local design / plan docs (not part of the repo)
docs/superpowers/specs/

# Merobox runtime data (docker volumes, extracted bundles, RocksDB files)
e2e/data/

# Keep logic/res (WASM and ABI) and logic/dist (bundle) - these MUST be committed
!logic/res/
!logic/dist/

# Logic build intermediates — placed AFTER the `!logic/res/` negation so
# future broader un-ignore rules (e.g. `!logic/res/**`) can't accidentally
# re-include these. Today the explicit `logic/res/bundle-temp/` directory
# pattern would win even without this ordering, but ordering it last is
# defensive against future rule additions.
logic/res/bundle-temp/

# Agent worktrees (isolated checkouts)
.worktrees/

# Internal Phase-0 working plan — kept local, not tracked
docs/superpowers/plans/2026-07-02-phase0-sse-render-editor-fixes.md
.claude
