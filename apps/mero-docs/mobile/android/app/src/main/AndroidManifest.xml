<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeroDocs">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The node's consent page sends the person back here:
              mero-docs://consent?request_id=…&result=approved|declined
              (DocsAppViewModel.CONSENT_CALLBACK).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mero-docs" android:host="consent" />
            </intent-filter>

            <!--
              Invitations to a workspace, as the SDK spells them:
              https://links.calimero.network/com.calimero.mero-drive-docs/join?invitation=…
              Not autoVerify: Android offers the app in the chooser.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="links.calimero.network"
                    android:pathPrefix="/com.calimero.mero-drive-docs/" />
            </intent-filter>

            <!--
              Document links, as the web app and this app share them:
              https://mero-docs.vercel.app/app/<workspace>/f/<folder>/d/<doc>#b=<block>
              Not autoVerify: the web deployment does not publish this app's
              assetlinks.json, so Android offers the app in the chooser instead.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mero-docs.vercel.app"
                    android:pathPrefix="/app/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
