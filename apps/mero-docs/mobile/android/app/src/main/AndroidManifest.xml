<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeroDocs">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Calimero Cloud sign-in: the wallet redirects to the enrolment callback
              (BuildConfig.ENROL_CALLBACK_URL, default mero-docs://enrol) with the device
              certificate in the fragment. Scheme and host come from the `meroEnrolCallback`
              Gradle property, so this filter always matches what the app asks the wallet for.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${enrolScheme}" android:host="${enrolHost}" />
            </intent-filter>

            <!--
              Document links, as the web app and this app share them:
              https://mero-docs.vercel.app/app/<workspace>/f/<folder>/d/<doc>#b=<block>
              Not autoVerify: the web deployment does not publish this app's
              assetlinks.json, so Android offers the app in the chooser instead.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mero-docs.vercel.app"
                    android:pathPrefix="/app/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
