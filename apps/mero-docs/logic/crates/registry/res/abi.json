    "FolderDto": {
      "kind": "record",
      "doc": "Flat, serde-friendly projection of a `FolderRecord` for list/get APIs.",
      "fields": [
        {
          "name": "id",
          "type": {
            "$ref": "FolderId"
          }
        },
        {
          "name": "parent_id",
          "type": {
            "$ref": "FolderId"
          },
          "nullable": true
        },
        {
          "name": "color",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "`None` when color is unset / empty."
        },
        {
          "name": "context_id",
          "type": {
            "$ref": "ContextId"
          },
          "nullable": true,
          "doc": "`None` when no Docs context has been bound to this folder yet."
        },
        {
          "name": "alias",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "`None` when no registry-side alias is stored (older folders,\nor folders created before the alias field existed). Clients\nfall back to the admin-API alias or a truncated id stub."
        },
        {
          "name": "visibility",
          "type": {
            "$ref": "Visibility"
          }
        }
      ]
    },
    "FolderId": {
      "kind": "alias",
      "doc": "Wrapper around a folder / group id string. Newtype so the generated TS\nclient surfaces `FolderId` instead of a bare `string`.",
      "target": {
        "kind": "string"
      }
    },
    "FolderRecord": {
      "kind": "record",
      "doc": "Per-folder record inside the registry map. All fields are LWW so\nconcurrent updates resolve deterministically.\n\n`Mergeable` is implemented by hand rather than `#[derive(Mergeable)]`\nbecause `LwwRegister<T>` has both an inherent `merge(...) -> ()` and a\ntrait `Mergeable::merge(...) -> Result<(), MergeError>`. Rust's method\nresolution picks the inherent one from the derive expansion, which then\nfails the macro's `?` — same workaround battleships uses on\n`MatchSummary`.",
      "fields": [
        {
          "name": "parent_id",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Parent folder id, or None for top-level folders. Stored as an\nLWW index; admin-API remains the source of truth for the tree."
        },
        {
          "name": "color",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "`#rrggbb` color, or empty string for \"no color\"."
        },
        {
          "name": "alias",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Display name. Mirrored from admin-API's group alias so namespace\nmembers who can't read the subgroup yet (Restricted folder before\ninvite) can still see folder names. Empty string means \"no\nregistry-side alias — fall back to the admin-API alias or a\ntruncated id stub on the client\"."
        },
        {
          "name": "visibility",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "$ref": "Visibility"
            }
          },
          "doc": "Inherit = namespace-member cascade descends through this folder.\nRestricted = explicit-invite wall; cascade stops here."
        }
      ]
    },
    "FolderRoleEntry": {
      "kind": "record",
      "doc": "One explicit per-member role row for a folder (what `list_folder_roles`\nreturns). Members not present have the implicit `Editor` role.",
      "fields": [
        {
          "name": "member",
          "type": {
            "kind": "string"
          },
          "doc": "hex-encoded member public key."
        },
        {
          "name": "role",
          "type": {
            "$ref": "Role"
          }
        }
      ]
    },
    "RegistryState": {
      "kind": "record",
      "fields": [
        {
          "name": "folders",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "FolderRecord"
            },
            "crdt_type": "authored_map"
          },
          "doc": "folder_id (string) → FolderRecord. Owned by whoever registered the\nfolder, who alone edits it; the registry admins (owner and managers)\nare its moderators and may also remove it. Every node enforces both.\n\nKeys are per owner (core rc.57): two accounts registering one id hold\ntwo entries, and a key-only `get`/`contains`/`owner_of` answers for the\nCALLER only. Every read by id goes through `folder_holder`, which takes\nthe entry of the lowest account holding the id, the same pick on every\nnode; `register_folder` refuses an id any account is known to hold."
        },
        {
          "name": "folder_contexts",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "ContextId"
            },
            "crdt_type": "authored_map"
          },
          "doc": "folder_id (string) → Docs context id bound to that folder. Written\nonce, by the folder's registrant; nobody can rebind or remove it, so a\nfolder cannot be pointed at someone else's context after the fact.\nA binding counts only while its writer owns the folder (see\n`binding_of`)."
        },
        {
          "name": "sort_order",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "list",
                "items": {
                  "kind": "string"
                }
              }
            },
            "crdt_type": "unordered_map"
          },
          "doc": "parent_id-or-empty → LWW list of child folder ids in display order.\nDeliberately public: display order is collaborative, and a bad order\nis corrected by the next reorder."
        },
        {
          "name": "owner",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Hex account of the registry owner: whoever created the registry\ncontext (a namespace admin). Frozen at `init`; nobody can change it."
        },
        {
          "name": "managers",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "kind": "record",
                "fields": [],
                "crdt_type": "lww_register",
                "inner_type": {
                  "kind": "bool"
                }
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "Hex accounts granted manager rights over the whole registry (may set/\nclear any folder role). Writable by the owner only. The owner is\nimplicitly a manager and is NOT stored here. Value `true` = is a\nmanager, `false` = removed (kept around so the key is never\nCRDT-tombstoned — a `remove` would silently swallow a later re-add)."
        },
        {
          "name": "folder_roles",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "kind": "record",
                "fields": [],
                "crdt_type": "lww_register",
                "inner_type": {
                  "$ref": "Role"
                }
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "`role_key(folder_id, member_hex)` → role. Absent ⇒ `Role::Editor`.\nWritable by the registry admins only (see `sync_admins`)."
        }
      ]
    },
    "Role": {
      "kind": "variant",
      "doc": "Per-folder collaborator role. Local copy of `mero_docs_types::Role`\n(same variants, same bytes); keep the two definitions in sync.",
      "variants": [
        {
          "name": "Viewer"
        },
        {
          "name": "Editor"
        },
        {
          "name": "Manager"
        }
      ]
    },
    "Visibility": {
      "kind": "variant",
      "doc": "Per-folder cascade flag. `Inherit` = namespace-member cascade descends\nthrough this folder (Open subgroup); `Restricted` = explicit-invite wall,\ncascade stops here. Mirrors the admin-API subgroup_visibility concept but\nis stored in the registry so clients can read it without a per-folder\nadmin-API call.",
      "variants": [
        {
          "name": "Inherit"
        },
        {
          "name": "Restricted"
        }
      ]
    }
  },
