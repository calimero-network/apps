{
  "schema_version": "wasm-abi/1",
  "types": {
    "RegistryState": {
      "kind": "record",
      "fields": [
        {
          "name": "owner",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Hex account of the registry owner: whoever created the registry\ncontext (a namespace admin). Frozen at `init`; nobody can change it."
        },
        {
          "name": "access",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          },
          "doc": "The registry's managers, as holders of the `MANAGER` role. The owner is\nits only admin, so only the owner grants or revokes it, on every node."
        },
        {
          "name": "tags",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "TagRecord"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "tag key → TagRecord. Public: any member may name, recolour or delete\na tag; which roles may is the app's to gate."
        },
        {
          "name": "views",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "ViewRecord"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "saved-view id → ViewRecord. Public for the same reason as `tags`."
        },
        {
          "name": "view_origins",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "u64"
            },
            "crdt_type": "authored_map"
          },
          "doc": "saved-view id → created_at, written once by the view's creator. Its\nowner stamp is who created the view, and nobody can rewrite either."
        }
      ]
    },
    "TagRecord": {
      "kind": "record",
      "doc": "Workspace-wide tag: a stable key mapped to a display name and colour.\n`deleted` tombstones the row rather than removing it - see `delete_tag`.\nIt merges by OR, so a delete on any replica is permanent.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The display name."
        },
        {
          "name": "color",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The colour as `#rrggbb`."
        },
        {
          "name": "deleted",
          "type": {
            "kind": "bool"
          },
          "doc": "Set for good once the tag is deleted."
        }
      ]
    },
    "ViewRecord": {
      "kind": "record",
      "doc": "A workspace-wide saved search. Its creator is not stored here but in\n`view_origins`, where nobody can rewrite it.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The display name."
        },
        {
          "name": "query",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The saved search text."
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "RegistryState",
  "state_version": 1
}