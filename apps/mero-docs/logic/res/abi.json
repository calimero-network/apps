    "Run": {
      "kind": "record",
      "doc": "A run of character ids, mirroring `IdRange`, which has no `AbiType`.\n`replica` is decimal text because a full `u64` loses its top bits as a JSON number in a browser.",
      "fields": [
        {
          "name": "replica",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "counter",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "len",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
