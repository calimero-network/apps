{
  "schema_version": "wasm-abi/1",
  "types": {
    "Applied": {
      "kind": "record",
      "doc": "What `apply_delta_on` did. The block's spans come back either way, so a\nrefused write hands the client exactly the state it has to rebase onto.",
      "fields": [
        {
          "name": "applied",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "token",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "spans",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Span"
            }
          }
        },
        {
          "name": "anchor",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "The gap after this write's last change, or on a refusal the anchor sent."
        },
        {
          "name": "anchor_pos",
          "type": {
            "kind": "u32"
          },
          "nullable": true,
          "doc": "Where `anchor` sits in `spans`."
        },
        {
          "name": "ids",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Run"
            }
          },
          "doc": "The id of each character of `spans`, so a refused write rebases by identity."
        }
      ]
    },
    "Block": {
      "kind": "record",
      "doc": "One rendered block, mirroring `BlockView` so its id is the same bs58 token\nevery other method takes and returns.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "depth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "attrs",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "string"
            }
          }
        },
        {
          "name": "spans",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Span"
            }
          }
        },
        {
          "name": "ids",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Run"
            }
          },
          "doc": "The id of each character of `spans`, in order."
        }
      ]
    },
    "BlockView": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "tuple",
            "elements": [
              {
                "kind": "u64"
              },
              {
                "kind": "u32"
              }
            ]
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "depth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "attrs",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "string"
            }
          }
        },
        {
          "name": "spans",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Span"
            }
          }
        }
      ]
    },
    "Change": {
      "kind": "variant",
      "doc": "One step of an attributed editor change, mirroring `DeltaOp`, which has no\n`AbiType`. Untagged so the YAML stays Quill's: `- retain: 6`.",
      "variants": [
        {
          "name": "Retain",
          "payload": {
            "$ref": "Change_Retain"
          }
        },
        {
          "name": "Insert",
          "payload": {
            "$ref": "Change_Insert"
          }
        },
        {
          "name": "Delete",
          "payload": {
            "$ref": "Change_Delete"
          }
        }
      ],
      "untagged": true
    },
    "Change_Delete": {
      "kind": "record",
      "fields": [
        {
          "name": "delete",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "Change_Insert": {
      "kind": "record",
      "fields": [
        {
          "name": "insert",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "attributes",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "string"
            }
          },
          "nullable": true
        }
      ]
    },
    "Change_Retain": {
      "kind": "record",
      "fields": [
        {
          "name": "retain",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "attributes",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "string"
            }
          },
          "nullable": true
        }
      ]
    },
    "Comment": {
      "kind": "record",
      "doc": "A per-document comment, owned by its author. Stored in an `AuthoredMap`, so\nthe runtime stamps the writer's identity and a per-entry schema version on\ninsert; only the owner can re-sign it (the basis of the migration banner).\n\nThe value type is intentionally STABLE across schema versions - the v1→v2\nmigration bumps the *state* schema and adds a top-level marker, never a\nfield inside `Comment` (changing an authored value type is a content\nrewrite, a different and harder migration class).",
      "fields": [
        {
          "name": "doc_id",
          "type": {
            "kind": "string"
          },
          "doc": "Which doc this annotates. Immutable after create. Indexed, so one doc's\ncomments are a seek rather than a walk of the folder's."
        },
        {
          "name": "body",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          },
          "doc": "Immutable after create."
        }
      ]
    },
    "CommentDto": {
      "kind": "record",
      "doc": "Flat projection of a `Comment` for list / get APIs.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          },
          "doc": "Hex account of the comment's author, from its owner stamp."
        },
        {
          "name": "doc_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "DocDto": {
      "kind": "record",
      "doc": "Flat projection of a `DocRecord` for list / get APIs. The body is read\nthrough `get_document` / `get_block_delta`, never flattened into a string.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "tags",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Keys only, sorted; the registry maps each to a name and colour."
        },
        {
          "name": "archived",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          },
          "doc": "Hex account of whoever created the doc, from its header's owner stamp."
        },
        {
          "name": "updated_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "can_delete",
          "type": {
            "kind": "bool"
          },
          "doc": "Whether the caller may delete it: the same rule `delete_doc` enforces."
        }
      ]
    },
    "DocRecord": {
      "kind": "record",
      "doc": "Per-document record.\n\nThe derive supplies the deterministic re-key cascade `title`, `body` and\n`tags` need: a nested collection stored under a value type that is not a\nregistered `RekeyTarget` keeps a per-replica random storage id and never\nconverges.",
      "fields": [
        {
          "name": "title",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "fugue_text"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "BlockView"
            }
          }
        },
        {
          "name": "tags",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            },
            "crdt_type": "unordered_set"
          },
          "doc": "A set, so two members tagging the same doc at once both keep their tag."
        },
        {
          "name": "archived",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "bool"
            }
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "updated_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "DocsState": {
      "kind": "record",
      "doc": "`docs` + their `headers` + moderated `comments`.",
      "fields": [
        {
          "name": "docs",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "DocRecord"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "doc_id → record. Public: collaborative editing. The id is\n`doc-<nonce>-<account>-<device tag>` and assigned by `create_doc`."
        },
        {
          "name": "headers",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "u64"
            },
            "crdt_type": "authored_map"
          },
          "doc": "doc_id → created_at, filed by the doc's creator, whose owner stamp it\ncarries. A doc is listed while that entry lives; only its creator or a\nmoderator (the founder) may remove it, and every node enforces that."
        },
        {
          "name": "comments",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Comment"
            },
            "crdt_type": "authored_map"
          },
          "doc": "comment_id → comment. Each is owned by its author, who alone edits it;\nthe folder's moderators (its founder, who created this context) may\nalso remove any. Every node enforces both."
        }
      ]
    },
