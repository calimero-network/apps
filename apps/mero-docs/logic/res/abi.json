      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "at",
          "u32"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "titleAnchorAt": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Gets a marker for a spot in a document's title that still points to it\nafter other edits. The anchor is for the gap at `position`, stuck to the\ncharacter after it (`before`) or before it.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "position",
          "u32"
        ],
        [
          "before",
          "bool"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "titleApplyDelta": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Edits a document's title. Applies Quill steps (no `attributes`: the\ntitle is plain) to the title and returns the undo token for `titleUndo`.\nAt most 1024 characters after. Emits `TitleChanged`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "ops",
          "list<Change>"
