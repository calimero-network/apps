  "methods": [
    {
      "name": "add_comment",
      "params": [
        {
          "name": "doc_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "add_tag",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "tag",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "anchor_at",
      "doc": "A cursor for the gap at `position`, as an opaque token any member resolves.",
      "params": [
        {
          "name": "doc",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "block",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "position",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "before",
          "type": {
            "kind": "bool"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "apply_delta",
      "doc": "One editor transaction, text and formatting together, returning an\nopaque token `undo` takes.",
      "params": [
        {
          "name": "doc",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "block",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "ops",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Change"
            }
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "apply_delta_on",
      "doc": "`apply_delta`, but only onto the text the caller diffed against, since a position\ncounted in any other text names the wrong place. `anchor` as in `title_apply_delta_on`.",
      "params": [
        {
          "name": "doc",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "block",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "base",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "ops",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Change"
            }
          }
        },
        {
          "name": "anchor",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ],
      "returns": {
        "$ref": "Applied"
      },
      "intent": "mutating"
    },
    {
      "name": "archive_doc",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "comment_count",
      "doc": "Comments held by the account their id names, on a doc that is still listed;\n`len` would count planted ones and a deleted doc's too.",
      "params": [],
      "returns": {
        "kind": "u64"
      },
      "intent": "read_only"
    },
    {
      "name": "comment_schema_version",
      "doc": "The comment's stored per-entry `schema_version` - `Some(1)` before\nconvert, `Some(2)` after the owner re-signs. Lets the e2e assert that a\none-tap `migrate_my_entries` actually re-stamped it.\n\nThe entry of the account the comment's id names, read by name, so it\nanswers the same on every node: a key-only\n`entry_schema_version` reads the caller's own entry only.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "u32"
      },
      "intent": "read_only"
    },
    {
      "name": "create_doc",
      "doc": "Creates a document and seeds its title. The body starts empty; a client\nadds the first block with `insert_block`.",
      "params": [
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_block",
      "params": [
        {
          "name": "doc",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "block",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_comment",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
