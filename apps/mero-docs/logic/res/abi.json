    },
    "BlockDeleted": {
      "block": "string",
      "doc": "string"
    },
    "BlockInserted": {
      "block": "string",
      "doc": "string"
    },
    "BlockMoved": {
      "block": "string",
      "doc": "string"
    },
    "CommentAdded": {
      "id": "string"
    },
    "CommentDeleted": {
      "id": "string"
    },
    "CommentEdited": {
      "id": "string"
    },
    "DocArchived": {
      "id": "string"
    },
    "DocCreated": {
      "id": "string"
    },
    "DocDeleted": {
      "id": "string"
    },
    "DocEdited": {
      "id": "string"
    },
    "DocTagsChanged": {
      "id": "string"
    },
    "DocUnarchived": {
      "id": "string"
    },
