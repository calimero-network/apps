  "methods": {
    "addComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a comment to a document. The comment is the caller's, at most\n10,000 characters, and its id is returned. Emits `CommentAdded`.",
      "kind": "call",
      "params": [
        [
          "docId",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "addManager": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Makes a member of the organization a manager. Only the owner may\n(`Forbidden`); the owner itself, or someone outside the organization, is\n`Invalid`. Emits `ManagerAdded`.",
      "kind": "call",
      "params": [
        [
          "member",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "addTag": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a tag to a document. A tag it has already is a no-op. `tag` is a\nkey of lowercase letters, digits and dashes (1 to 64), else `Invalid`.\nDoes not change `updatedBy`. Emits `DocTagsChanged`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "tag",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "anchorAt": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Gets a marker for a spot in a block's text that still points to it after\nother edits. The anchor is for the gap at `position`, stuck to the\ncharacter after it (`before`) or before it.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "position",
          "u32"
        ],
        [
          "before",
          "bool"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "applyDelta": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Edits the text of a block. Applies Quill steps to it and returns the\nundo token for `undo`. An insert's `attributes` are its complete\nformatting; a retain's change only the keys they name. Allowed\nformatting keys are `bold`, `italic`, `underline`, `strike`,\n`textColor`, `backgroundColor`, `link`, `code`, `comment`; any other is\n`Invalid`. At most 100,000 characters after. Emits `TextChanged`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "ops",
          "list<Change>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "applyDeltaOn": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Edits the text of a block only if nobody has changed it in the meantime.\nThat is `applyDelta`, only if the block's text is still `base` and, with\nan `anchor`, the steps are an insert right at it; otherwise nothing is\nwritten and the block's current spans and ids come back to rebase onto.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "base",
          "string"
        ],
        [
          "ops",
          "list<Change>"
        ],
        [
          "anchor",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "Applied"
    },
    "archiveDoc": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Hides a document from the default list without deleting it. Emits\n`DocArchived`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "commentCount": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Counts the comments on all the folder's documents.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "u64"
    },
    "commentSchemaVersion": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows which version of the comment format a comment was saved in. 1 for\nevery live comment, `null` for a missing one.",
      "kind": "view",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<u32>"
    },
    "createDoc": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Creates a new document with a title and an empty body. Returns its id.\nThe title is at most 1024 characters. Not idempotent: a retry after a\nlost response creates a second document. Emits `DocCreated`.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "deleteBlock": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes a block from a document. Its text is kept, so ids that name it\nstill resolve. Emits `BlockDeleted`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a comment. Its author may, and the folder's moderator may delete\nany. Emits `CommentDeleted`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteDoc": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a document together with its title, body, tags and comments.\nOnly its creator or the folder's moderator (whoever created this\ninstance) may (`Forbidden`). Emits `DocDeleted`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteTag": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a workspace tag for good. Its key stays taken. `NotFound` for an\nunknown key. Emits `TagChanged`.",
      "kind": "call",
      "params": [
        [
          "key",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteView": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a saved view. `NotFound` for an unknown id. Emits `ViewChanged`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes the text of a comment. Only its author may (`Forbidden`). Emits\n`CommentEdited`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editDoc": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Renames a document. Replaces the whole title. Emits `TitleChanged` and\n`DocEdited`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "title",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getBlock": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows one block of a document. `null` when it is not in the document.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<Block>"
    },
    "getBlockDelta": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows a block's text with its formatting. Comes as runs of equally\nformatted characters.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<Span>"
    },
    "getComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows one comment. `NotFound` for a missing one.",
      "kind": "view",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": "CommentView"
    },
    "getDoc": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows a document's title, tags and details. Its text is read through\n`getDocument`. `NotFound` for a missing document.",
      "kind": "view",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": "DocView"
    },
    "getDocument": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows every block of a document, in order.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<Block>"
    },
    "getOwner": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows who owns this workspace or folder. That is the account that\ncreated this instance.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "getStateDigest": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Summarizes a document's whole body as one string, so two copies can be\ncompared. It reads `kind/depth[attr=value]{marks:text};` per block: two\nreaders agree on a document exactly when their digests match.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "getText": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows a block's text without its formatting.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "getTitle": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows a document's title.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "getTitleState": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows a document's title together with an id for each character. Editors\nuse the ids to merge edits made at the same time.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ]
      ],
      "public": false,
      "returns": "TitleState"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Starts an empty folder of documents, or a workspace's shared settings.\nIts creator (`env::app_owner()`) is the registry's owner, or the\nfolder's moderator.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "insertBlock": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a new empty block, such as a paragraph or a heading, to a document.\nInserts an empty block of `kind` at `depth` after the block `after`\n(`null`: first), and returns its id. Emits `BlockInserted`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "after",
          "option<string>"
        ],
        [
          "kind",
          "string"
        ],
        [
          "depth",
          "u8"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "listBlocks": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the ids of a document's blocks, in order.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<string>"
    },
    "listComments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists a document's comments. In no particular order; an empty list for a\nmissing document.",
      "kind": "view",
      "params": [
        [
          "docId",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<CommentView>"
    },
    "listDocs": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the documents in the folder. Archived ones are included only with\n`includeArchived`.",
      "kind": "view",
      "params": [
        [
          "includeArchived",
          "bool"
        ]
      ],
      "public": false,
      "returns": "list<DocView>"
    },
    "listManagers": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the managers, in account order. The owner is not included.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<string>"
    },
    "listTags": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the workspace's tags, in key order. Deleted ones are included.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<TagView>"
    },
    "listViews": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the saved views, in id order.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<ViewView>"
    },
    "mark": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Formats a stretch of a block's text, for example as bold or a link. Sets\n`key` to `value` on the characters `[start, end)`, or removes it with\n`null`. Returns the mark's id (`null` for an empty range). Emits\n`MarkApplied`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "start",
          "u32"
        ],
        [
          "end",
          "u32"
        ],
        [
          "key",
          "string"
        ],
        [
          "value",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "option<string>"
    },
    "mergeBlocks": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Joins two blocks into one. Appends `second`'s text (with its formatting)\nto `first` and takes `second` out of the document. At most 100,000\ncharacters joined. Emits `BlockChanged` and `BlockDeleted`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "first",
          "string"
        ],
        [
          "second",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "moveBlock": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Moves a block to another place in a document. It goes after `after`\n(`null`: first). Emits `BlockMoved`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "after",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "passageCount": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Counts how often a piece of text appears in a block's text. Exact and\ncase-sensitive; matches inside words count. Occurrences do not overlap.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "needle",
          "string"
        ]
      ],
      "public": false,
      "returns": "u32"
    },
    "removeManager": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Takes a manager's role away from someone. Only the owner may\n(`Forbidden`); someone who is not a manager is `NotFound`. Emits\n`ManagerRemoved`.",
      "kind": "call",
      "params": [
        [
          "member",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "removeTag": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes a tag from a document. One the document does not have is a\nno-op. Emits `DocTagsChanged`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "tag",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "resolveIds": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Finds where marked spots in a block's text are now. `null` for an\nunknown one.",
      "kind": "view",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "anchors",
          "list<string>"
        ]
      ],
      "public": false,
      "returns": "list<option<u32>>"
    },
    "saveView": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Saves a named view for the workspace, or renames or changes one already\nsaved. `id`: 1 to 64 ASCII letters, digits and dashes; `name`: 1 to 60\nbytes after trimming; `query`: at most 1000 bytes. The first saver is\nits `createdBy`. Emits `ViewChanged`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "name",
          "string"
        ],
        [
          "query",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "searchDocs": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Finds documents whose title or text matches the words you search for.\nEvery word of `query` must start a word of the document\n(case-insensitive), a title match scoring double; best match first.\n`cursor` is the previous page's `nextCursor`; `limit` defaults to 20, at\nmost 100. A blank query finds nothing; one over 256 bytes is `Invalid`.",
      "kind": "view",
      "params": [
        [
          "query",
          "string"
        ],
        [
          "includeArchived",
          "bool"
        ],
        [
          "cursor",
          "option<u32>"
        ],
        [
          "limit",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "DocSearchPage"
    },
    "setAttr": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Sets a formatting property of a block, such as a heading's level.\nRemoves it with `null`. Emits `BlockChanged`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "key",
          "string"
        ],
        [
          "value",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setDepth": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Indents or outdents a block by setting its nesting depth. Emits\n`BlockChanged`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "depth",
          "u8"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setKind": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes what a block is, for example from a paragraph to a heading.\n`kind` is BlockNote's own string. Emits `BlockChanged`.",
      "kind": "call",
      "params": [
        [
          "doc",
          "string"
        ],
        [
          "block",
          "string"
        ],
        [
          "kind",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setTag": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Creates a workspace tag, or changes its name and color. `key`: 1 to 64\nlowercase letters, digits and dashes; `name`: 1 to 32 characters after\ntrimming; `color`: `#rrggbb`. A deleted tag's key is `Invalid` for good.\nEmits `TagChanged`.",
