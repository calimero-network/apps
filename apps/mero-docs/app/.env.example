# Mero Docs: where the frontend connects (packages/connect, docs/COMPONENT-APPS.md).
#
# `pnpm dev:local mero-docs` writes `.env.development.local` with the local
# values; a production build (the one packed into the .mpk) needs the cloud ones.

# local (default under `vite`) | cloud (default under `vite build`) | node
# VITE_CALIMERO_TARGET=local

# local: the merod local nodes (default 127.0.0.1:2501-2503); node: required,
# the attested node's https URLs.
# VITE_CALIMERO_NODES=http://127.0.0.1:2501,http://127.0.0.1:2502,http://127.0.0.1:2503

# local: the bundle hash `pnpm merod-local deploy mero-docs` uploaded.
# VITE_CALIMERO_BUNDLE=

# cloud: REQUIRED. The cluster's name in the cloud's node directory, and the
# lowest mero-tee release a node may run.
# VITE_CALIMERO_CLUSTER=
# VITE_CALIMERO_MIN_RELEASE=

# cloud, optional: preferred zone; another node directory (staging).
# VITE_CALIMERO_ZONE=
# VITE_CALIMERO_DIRECTORY=

# cloud, optional: the package instances are created from (default
# com.calimero.mero-drive-docs) and its version (default: newest).
# VITE_CALIMERO_PACKAGE=com.calimero.mero-drive-docs
# VITE_CALIMERO_VERSION=
