{
  "scripts": {
    "prepare": "husky",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm --dir app lint:check",
    "lint:fix": "pnpm --dir app lint:fix",
    "app:install": "pnpm --dir app install",
    "app:build": "pnpm --dir app build",
    "app:preview": "pnpm --dir app preview",
    "dev": "pnpm --dir app dev",
    "logic:build": "cargo run --release --manifest-path ../../tools/component-bundle/Cargo.toml -- build logic",
    "logic:test": "cargo test --manifest-path logic/Cargo.toml"
  },
  "devDependencies": {
    "husky": "^9.0.11"
  },
  "dependencies": {
    "@calimero-network/mero-icons": "^0.0.4",
    "@calimero-network/mero-ui": "^0.3.4"
  },
  "name": "mero-docs"
}
