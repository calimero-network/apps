          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating",
      "idempotent": true
    },
    {
      "name": "set_repro",
      "doc": "Replace an issue's reproduction steps.\n\n# Errors\nFails if the issue does not exist or `repro` is empty.\n\n# Examples\n```json\n{\"issue_id\":\"<issue id>\",\"repro\":\"Run the e2e job three times on main.\"}\n```",
      "params": [
        {
          "name": "issue_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "repro",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating",
      "idempotent": true
    },
    {
      "name": "set_resolution_criteria",
      "doc": "Replace an issue's resolution criteria.\n\n# Errors\nFails if the issue does not exist or `resolution_criteria` is empty.\n\n# Examples\n```json\n{\"issue_id\":\"<issue id>\",\"resolution_criteria\":\"Twenty consecutive green runs.\"}\n```",
      "params": [
        {
          "name": "issue_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "resolution_criteria",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating",
      "idempotent": true
    },
    {
      "name": "set_status",
      "doc": "Move an issue to another status column.\n\n# Errors\nFails if the issue does not exist or `status` is not one of the four values.\n\n# Examples\n```json\n{\"issue_id\":\"<issue id>\",\"status\":\"In progress\"}\n```",
      "params": [
        {
          "name": "issue_id",
