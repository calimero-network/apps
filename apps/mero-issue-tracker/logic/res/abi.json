{
  "abiVersion": 1,
  "errors": {
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "id": "string"
    }
  },
  "events": {
    "CommentAdded": {
      "id": "string",
      "issueId": "string"
    },
    "CommentDeleted": {
      "id": "string"
    },
    "CommentEdited": {
      "id": "string"
    },
    "IssueAssigneeChanged": {
      "id": "string"
    },
    "IssueCreated": {
      "createdBy": "string",
      "id": "string"
    },
    "IssueDeleted": {
      "id": "string"
    },
    "IssueEdited": {
      "id": "string"
    },
    "IssueLabelsChanged": {
      "id": "string"
    },
    "IssuePriorityChanged": {
      "id": "string",
      "priority": "string"
    },
    "IssueStatusChanged": {
      "id": "string",
      "status": "string"
    },
    "RepoUrlChanged": {
      "url": "string"
    }
  },
  "methods": {
    "addComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Posts a comment on an issue. The comment must not be blank. Returns its\nid, `comment-<ms>-<8 hex>`, with the caller as its author. `NotFound`\nfor an unknown issue. Emits `CommentAdded`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "addLabel": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a label to an issue. A label is 1 to 64 characters; adding it twice\nkeeps one. Emits `IssueLabelsChanged`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "label",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "createIssue": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Files a new issue on the board. Returns its id, `issue-<ms>-<8 hex>`. It\nstarts `Open`, filed by the caller. `title` and each label are 1 to 64\ncharacters, the four sections must not be blank, and `priority` is one\nof `low`, `medium`, `high`, `urgent`; anything else is `Invalid`. Emits\n`IssueCreated`.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ],
        [
          "summary",
          "string"
        ],
        [
          "impact",
          "string"
        ],
        [
          "repro",
          "string"
        ],
        [
          "resolutionCriteria",
          "string"
        ],
        [
          "priority",
          "string"
        ],
        [
          "labels",
          "option<list<string>>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "deleteComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a comment. Only its author may: anyone else gets `Forbidden`.\nEmits `CommentDeleted`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteIssue": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes an issue together with its labels and its whole comment thread.\nOnly its creator may: anyone else gets `Forbidden`. `NotFound` for an\nunknown issue. Emits `IssueDeleted`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes the text of a comment. It must not be blank, and `editedAt` is\nstamped. Only its author may: anyone else gets `Forbidden`. Emits\n`CommentEdited`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ],
        [
          "newBody",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getIssue": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows one issue with its comments, oldest first. At most the first 1,000\ncomments. `NotFound` for an unknown issue.",
      "kind": "view",
      "params": [
        [
          "issueId",
          "string"
        ]
      ],
      "public": false,
      "returns": "IssueDetail"
    },
    "getRepoInfo": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows the repository this board tracks. Its URL is empty until\n`setRepoUrl`.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "RepoInfo"
    },
    "getStatusCounts": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Shows how many issues sit in each column of the board. Counts come in\ncolumn order: `Open`, `In progress`, `Blocked`, `Done`.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<StatusCount>"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Starts an empty issue board. The node runs it once, when the app is\ncreated; it takes no arguments.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "listIssues": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lists the board's issues, oldest first, optionally narrowed by status,\nassignee or label. The filters are exact matches (`null` for no filter),\nand at most the first 1,000 matches come back.",
      "kind": "view",
      "params": [
        [
          "status",
          "option<string>"
        ],
        [
          "assignee",
          "option<string>"
        ],
        [
          "label",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "list<IssueView>"
    },
    "removeLabel": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes a label from an issue. Removing one it lacks succeeds. Emits\n`IssueLabelsChanged` either way.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "label",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setAssignee": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Assigns an issue to someone, or unassigns it. Pass `null` to clear the\nassignee; otherwise it is free text, conventionally an account id. Emits\n`IssueAssigneeChanged`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "assignee",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setImpact": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rewrites the description of what an issue affects. It must not be blank.\nEmits `IssueEdited`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "impact",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setPriority": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes how urgent an issue is. Takes `low`, `medium`, `high` or\n`urgent` (else `Invalid`). Emits `IssuePriorityChanged`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "priority",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setRepoUrl": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Sets or changes the repository this board tracks. `Invalid` when `url`\nis empty or does not start with `http://` or `https://`. Emits\n`RepoUrlChanged`.",
      "kind": "call",
      "params": [
        [
          "url",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setRepro": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rewrites the steps that reproduce an issue. They must not be blank.\nEmits `IssueEdited`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "repro",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setResolutionCriteria": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rewrites what has to be true for an issue to count as resolved. It must\nnot be blank. Emits `IssueEdited`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "resolutionCriteria",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setStatus": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Moves an issue to another column of the board. `status` is exactly\n`Open`, `In progress`, `Blocked` or `Done` (else `Invalid`). `NotFound`\nfor an unknown issue. Emits `IssueStatusChanged`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "status",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setSummary": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rewrites an issue's summary. It must not be blank. Emits `IssueEdited`.",
      "kind": "call",
      "params": [
        [
          "issueId",
          "string"
        ],
        [
          "summary",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
  "state": {
    "fields": {
      "comments": "table",
      "issues": "table",
      "labels": "table",
      "repoUrl": "cell"
    },
    "search": {
      "comments": [],
      "issues": [],
      "labels": [],
      "repoUrl": []
    },
    "version": 1
  },
  "types": {
    "Comment": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "issueId",
          "string"
        ],
        [
          "author",
          "string"
        ],
        [
          "body",
          "string"
        ],
        [
          "createdAt",
          "u64"
        ],
        [
          "editedAt",
          "option<u64>"
        ]
      ],
      "kind": "record"
    },
    "IssueDetail": {
      "fields": [
        [
          "issue",
          "IssueView"
        ],
        [
          "comments",
          "list<Comment>"
        ]
      ],
      "kind": "record"
    },
    "IssueView": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "title",
          "string"
        ],
        [
          "summary",
          "string"
        ],
        [
          "impact",
          "string"
        ],
        [
          "repro",
          "string"
        ],
        [
          "resolutionCriteria",
          "string"
        ],
        [
          "status",
          "string"
        ],
        [
          "priority",
          "string"
        ],
        [
          "assignee",
          "option<string>"
        ],
        [
          "labels",
          "list<string>"
        ],
        [
          "createdBy",
          "string"
        ],
        [
          "createdAt",
          "u64"
        ]
      ],
      "kind": "record"
    },
    "RepoInfo": {
      "fields": [
        [
          "repoUrl",
          "string"
        ]
      ],
      "kind": "record"
    },
    "StatusCount": {
      "fields": [
        [
          "status",
          "string"
        ],
        [
          "count",
          "u64"
        ]
      ],
      "kind": "record"
    }
  },
  "world": "calimero:app@0.5.7"
}
