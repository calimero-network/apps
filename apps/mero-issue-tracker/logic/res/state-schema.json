{
  "schema_version": "wasm-abi/1",
  "types": {
    "Comment": {
      "kind": "record",
      "doc": "A discussion entry on an issue. `id`, `issue_id`, `created_at` are\nimmutable; `body` and `edited_at` are LWW registers. The author is the\nentry's owner stamp, and only they may edit or delete it — on every node.\n`thread` is one issue's comments, oldest first.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "issue_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "edited_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        }
      ]
    },
    "Issue": {
      "kind": "record",
      "doc": "An issue's shared triage state. Every field is a `LwwRegister` so concurrent\nedits converge last-writer-wins. Labels live in a separate index (see\n`IssueTracker`).",
      "fields": [
        {
          "name": "summary",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "impact",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "repro",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "resolution_criteria",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "priority",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "assignee",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "IssueHeader": {
      "kind": "record",
      "doc": "Who filed an issue, and what they called it. Set once at creation. The filer\nis the entry's owner stamp, not a field, so nobody can re-attribute an issue.",
      "fields": [
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "IssueTracker": {
      "kind": "record",
      "fields": [
        {
          "name": "headers",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "IssueHeader"
            },
            "crdt_type": "authored_map"
          },
          "doc": "Issue id → header, owned by whoever filed it. An issue exists while its\nheader does."
        },
        {
          "name": "issues",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Issue"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Issue id → triage state. Shared — any teammate may triage."
        },
        {
          "name": "comments",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Comment"
            },
            "crdt_type": "authored_map"
          },
          "doc": "All comments across all issues, keyed by generated id, each owned by\nits author."
        },
        {
          "name": "labels",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "LabelTag"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Key `\"{issue_id}\\u{1}{label}\"` → the label. Concurrent adds of the same\nlabel collapse to one entry (no duplicates); removal is a conflict-free\nkey delete."
        },
        {
          "name": "repo_url",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The GitHub repository URL this context (repo) tracks. Empty until set;\nLWW so concurrent edits from teammates converge last-writer-wins."
        }
      ]
    },
    "LabelTag": {
      "kind": "record",
      "doc": "One label on one issue.",
      "fields": [
        {
          "name": "issue_id",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "added_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "IssueTracker",
  "state_version": 1
}