{
  "name": "@calimero-network/mero-issue-tracker-mcp",
  "version": "0.5.0",
  "description": "Stdio MCP server for managing issues in the Mero Issue Tracker on Calimero 1.0",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
