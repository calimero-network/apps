{
  "// note": "Unit tests. Node types on purpose: client.test.ts reads logic/res/abi.json off disk to assert the generated client covers the contract.",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-types/test",
    "tsBuildInfoFile": "./dist-types/test.tsbuildinfo",
    "types": [
      "node",
      "vite/client"
    ],
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false
  },
  "include": [
    "src",
    "custom.d.ts"
  ]
}
