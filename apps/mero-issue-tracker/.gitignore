node_modules/
**/node_modules/
target/
**/target/
dist/
**/dist/
.merod-data/
**/.merod-data/
# merobox-bootstrap-created data dir (per-node container data + container logs)
data/
*.log
.DS_Store

# Generated bundle staging dir (manifest + signed copies of wasm/abi).
# Recreated by build-bundle.sh on every run.
logic/res/bundle-temp/

# Build artifacts — regenerated by build-bundle.sh / per-crate build.sh on every
# build (and re-signed at deploy). Never commit; they bloat the scaffold and get
# copied into every generated app. The res/ dirs are kept via .gitkeep.
logic/res/*.mpk
logic/crates/*/res/*.wasm
logic/crates/*/res/abi.json
docs/superpowers/
.superpowers/

# Playwright e2e artifacts (per-run node data, reports, results).
app/.playwright-data/
app/test-results/
app/playwright-report/

# local env overrides
*.env.local
.env.local
