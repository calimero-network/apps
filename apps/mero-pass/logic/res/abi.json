    {
      "name": "rotate_key",
      "doc": "Make `key_id` the key new writes use. The first call bootstraps the\nvault; every later one is a rotation, and both are admin only.\n\nThe caller must have stored wraps of the new key before calling this,\nor members would be told to write with a key they cannot open.",
      "params": [
        {
          "name": "key_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
