          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "revoke_device",
      "doc": "Revoke a device. Your own device you may always revoke; anyone else's\nneeds an admin. Follow with `rotate_key`.",
