# Rust / WASM
logic/target/
# NOT `logic/res/`: that would hide res/abi.json from git, and CI's ABI check
# would then have nothing to diff. The root .gitignore covers the build output.
logic/res/*.mpk
logic/res/bundle-temp/
logic/dist/

# Frontend
app/node_modules/
app/dist/
app/dist-types/
app/.env.development.local

# misc
.DS_Store
*.log

# Publisher keypair — never commit real keys
logic/calimero.json
logic/key.json
