  "methods": {
    "addAction": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds an action item to a meeting and returns its id. Anyone who reaches the app.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "text",
          "string"
        ],
        [
          "assignee",
          "string"
        ],
        [
          "sourceSeq",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "appendSegments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Stores a batch of segments. Numbers already stored are skipped, so a\nbatch can be resent safely. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "segments",
          "list<SegmentInput>"
        ]
      ],
      "public": false,
      "returns": "AppendResult"
    },
    "deleteMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a meeting, its action items and up to 1,000 of its segments,\nand returns how many segments remain. The meeting is gone from every\nlist at once; call again until `remaining` is 0. Its recorder or the\ninstance's owner.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "DeleteResult"
    },
    "editAction": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rewrites an action item and who it is for. Anyone who reaches the app.",
      "kind": "call",
      "params": [
        [
          "actionId",
          "string"
        ],
        [
          "text",
          "string"
        ],
        [
          "assignee",
          "string"
        ]
      ],
      "public": false,
      "returns": "ActionView"
    },
    "editSegment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Corrects one segment's text. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "seq",
          "u32"
        ],
        [
          "text",
          "string"
        ]
      ],
      "public": false,
      "returns": "SegmentView"
    },
    "endMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Ends the recording. `durationMs` is the length the extension measured.\nEnding an ended meeting changes nothing. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "durationMs",
          "u32"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "getMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One meeting.",
      "kind": "view",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "listActions": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A meeting's action items, oldest first.",
      "kind": "view",
      "params": [
        [
          "meetingId",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<ActionView>"
    },
    "listMeetings": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every meeting, newest first.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<MeetingView>"
    },
    "myAccount": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The calling account.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "openActions": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every action item not yet done, across meetings, newest meeting first.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<ActionView>"
    },
    "removeAction": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes an action item. Its author, the meeting's recorder or the\ninstance's owner.",
      "kind": "call",
      "params": [
        [
          "actionId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "renameMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Renames a meeting. The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "title",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "search": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Meetings whose title, and lines whose text, contain every word of\n`query` (any case), newest meeting first and lines in order; at most\n`limit` hits (1–100).",
      "kind": "view",
      "params": [
        [
          "query",
          "string"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "SearchResult"
    },
    "setActionDone": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Ticks an action item off, or back on. Anyone who reaches the app.",
      "kind": "call",
      "params": [
        [
          "actionId",
          "string"
        ],
        [
          "done",
          "bool"
        ]
      ],
      "public": false,
      "returns": "ActionView"
    },
    "setSummary": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replaces a meeting's summary (free text, may be empty). The recorder only.",
      "kind": "call",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "summary",
          "string"
        ]
      ],
      "public": false,
      "returns": "MeetingView"
    },
    "startMeeting": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Starts recording a meeting and returns its id. The caller is its recorder.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ],
        [
          "platform",
          "string"
        ],
        [
          "url",
          "string"
        ],
        [
          "model",
          "string"
        ],
        [
          "language",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "transcript": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Segments from number `fromSeq` on, in order, at most `limit` (1–500).",
      "kind": "view",
      "params": [
        [
          "meetingId",
          "string"
        ],
        [
          "fromSeq",
          "u32"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "TranscriptPage"
    }
  },
