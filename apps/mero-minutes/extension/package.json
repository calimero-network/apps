{
  "name": "mero-minutes-extension",
  "private": true,
  "version": "0.1.0",
  "description": "Minutes browser extension \u2014 records a call tab, transcribes on the laptop, saves to a Calimero workspace",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && vite build && vite build -c vite.background.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "codegen": "meroctl app codegen --abi ../logic/res/abi.json --lang ts --name mero-minutes -o src/generated",
    "zip": "node scripts/zip.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@calimero-apps/glass": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:component",
    "@huggingface/transformers": "4.3.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@types/chrome": "^0.3.7",
    "@calimero-apps/test-setup": "workspace:*",
    "@calimero-apps/passkey": "workspace:*",
    "@calimero-apps/connect": "workspace:*",
    "@playwright/test": "catalog:"
  }
}
