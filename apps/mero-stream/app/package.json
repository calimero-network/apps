{
  "name": "mero-stream",
  "private": true,
  "version": "0.1.0",
  "description": "Calimero Mero Stream — streaming media OVER a Calimero app (Task 3 capacity probe), on the component runtime",
  "keywords": [
    "calimero",
    "streaming",
    "codec",
    "react",
    "vite",
    "web3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "vite preview",
    "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json}'",
    "prettier:write": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json}'",
    "codegen": "meroctl app codegen --abi ../logic/res/abi.json --lang ts --name mero-stream -o src/generated"
  },
  "dependencies": {
    "@calimero-apps/connect": "workspace:*",
    "@calimero-apps/glass": "workspace:*",
    "@calimero-apps/names": "workspace:*",
    "@calimero-apps/node-served": "workspace:*",
    "@calimero-apps/passkey": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:component",
    "@calimero-network/mero-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@calimero-apps/test-setup": "workspace:*",
    "@eslint/js": "^9.25.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "catalog:",
    "prettier": "^3.8.4",
    "typescript": "catalog:",
    "typescript-eslint": "^8.62.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
