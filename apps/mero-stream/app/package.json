{
  "name": "mero-stream",
  "private": true,
  "version": "0.1.0",
  "description": "Calimero Mero Stream — streaming media OVER the Calimero contract (Task 3 capacity probe)",
  "keywords": [
    "calimero",
    "streaming",
    "codec",
    "react",
    "vite",
    "web3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e:call": "node e2e/browser-call.mjs",
    "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json}' 'e2e/**/*.mjs'",
    "prettier:write": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json}' 'e2e/**/*.mjs'"
  },
  "dependencies": {
    "@calimero-network/mero-js": "^7.1.0",
    "@calimero-network/mero-react": "^4.6.0",
    "@calimero-network/mero-ui": "1.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "1.61.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.9"
  },
  "resolutions": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
