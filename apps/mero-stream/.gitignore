# Rust / WASM
logic/target/
logic/res/
# `cargo mero bundle` output (rc.19). The version lives in the manifest, not the
# filename, so this is a single stable path rather than a per-version artifact.
logic/dist/

# Live admin JWTs, rewritten by scripts/dev-node*.sh on every run.
app/.env.dev-call

# Frontend
app/node_modules/
app/dist/
app/dev-dist/
app/.vite/

# merobox runtime data
workflows/data/
workflows/**/.pids/

# misc
.DS_Store
*.log

# merobox runtime data (when run from repo root)
/data/

# Publisher keypair — fill via `meroctl app gen-key`, never commit real keys
logic/calimero.json
logic/key.json
logic/signing-key.json

# Python bytecode from the load generator (scripts/) and its CI compile check.
__pycache__/
*.py[cod]
