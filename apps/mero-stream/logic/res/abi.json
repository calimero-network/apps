  "methods": {
    "encodeFrame": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Encode one raw luma frame in the component, split it into fragments of\nat most [`MAX_CHUNK_BYTES`], store them, prune the caller's frames\nolder than [`FRAME_WINDOW`], and emit `FramePosted { seq }`. Returns the\nframe's seq.\n\n`raw` is `width * height` luma bytes (base64url on the wire). `now` is\nthe capture time in unix milliseconds. `NotJoined` before `join`;\n`ZeroDimension`, `DimensionTooLarge`, `RawTooLarge`, `RawLengthMismatch`\nfor a frame the codec does not take (a refused frame takes no seq).",
      "kind": "call",
      "params": [
        [
          "raw",
          "bytes"
        ],
        [
          "width",
          "u16"
        ],
        [
          "height",
          "u16"
        ],
        [
          "track",
          "u8"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "u64"
    },
    "frameChecksum": {
      "allowSystem": false,
      "confirm": false,
      "doc": "FNV-1a 64 of frame `seq`'s decoded pixels, or `null` when no live,\ncomplete frame has that seq. Equal checksums mean equal pixels (C1).",
      "kind": "view",
      "params": [
        [
          "seq",
          "u64"
        ]
      ],
      "public": false,
      "returns": "option<u64>"
    },
    "getChunks": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every live chunk past the caller's per-sender cursors, grouped by\nsender (account order), ascending within each. A sender missing from\n`cursors` starts at their newest live keyframe, and is left out while\nthey have none.",
      "kind": "view",
      "params": [
        [
          "cursors",
          "list<SenderCursor>"
        ]
      ],
      "public": false,
      "returns": "list<ChunkView>"
    },
    "getFrame": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every frame with `seq > afterSeq`, decoded in the component, oldest\nfirst (by seq, then sender). A frame missing a fragment is skipped.",
      "kind": "view",
      "params": [
        [
          "afterSeq",
          "u64"
        ]
      ],
      "public": false,
      "returns": "list<DecodedFrame>"
    },
    "getLiveStats": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Approach-2 instrumentation, per sender in account order.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "LiveStats"
    },
    "getMembers": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every member, in account order.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<Member>"
    },
    "getStats": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Approach-3 instrumentation.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "StreamStats"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A new stream named `name` (`\"\"` when not given; `renameStream` sets it\nlater). The creator owns the app instance, which makes them the\nstream's owner.",
      "kind": "init",
      "params": [
        [
          "name",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "isMemberAdmin": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Whether `member` (an account) is the stream's admin: its owner.",
      "kind": "view",
      "params": [
        [
          "member",
          "string"
        ]
      ],
      "public": false,
      "returns": "bool"
    },
    "join": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Join the stream, or change your display name. Idempotent: `joinedAt`\nstays the first join's. Emits `MemberJoined { account }` every time.",
      "kind": "call",
      "params": [
        [
          "username",
          "string"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "Member"
    },
    "keyframeCursors": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Each sender's newest live keyframe, in account order.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<SenderCursor>"
    },
    "postChunk": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Store one WebCodecs chunk (`dataB64`, standard base64) as the caller's\nnext seq, reap the caller's chunks older than [`LIVE_WINDOW_MS`] (never\ntheir newest keyframe), and, for the stream's owner, sweep senders\nsilent for [`STALE_SENDER_MS`]. Emits `ChunkPosted { seq }`; returns the\nseq. `now` is unix milliseconds.\n\n`NotJoined`, `BadBase64`, `EmptyChunk`, `ChunkTooLarge`,\n`CodecRequired`.",
      "kind": "call",
      "params": [
        [
          "dataB64",
          "string"
        ],
        [
          "track",
          "u8"
        ],
        [
          "isKeyframe",
          "bool"
        ],
        [
          "codec",
          "string"
        ],
        [
          "width",
          "u16"
        ],
        [
          "height",
          "u16"
        ],
        [
          "timestampUs",
          "u64"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "u64"
    },
    "pruneChunks": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Prune the caller's own chunks below `beforeSeq`, never past their\nnewest keyframe, at most [`MAX_PRUNE_PER_CALL`]. `NotJoined`.",
      "kind": "call",
      "params": [
        [
          "beforeSeq",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "pruneFrames": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Remove the caller's own fragments of frames with `seq < beforeSeq`, at\nmost [`MAX_PRUNE_PER_CALL`]. `NotJoined` before `join`.",
      "kind": "call",
      "params": [
        [
          "beforeSeq",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "renameStream": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rename the stream. The stream's owner only (`NotOwner`).",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
