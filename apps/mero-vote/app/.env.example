# The node this frontend talks to. mero-react discovers a local node on the
# usual ports when this is unset, so local development needs no .env at all.
VITE_NODE_URL=http://localhost:2528

# The installed ApplicationId on that node.
#
# ⚠️ Per-INSTALL, not per-app: the node derives it by hashing wasm + metadata, so
# the value differs on every node and baking one into a build is how you get an
# opaque 500 on namespace creation (core reports a missing application as 500,
# not 404). Treat this as a local dev convenience only, never as a deploy-time
# constant, and never write it to storage.
VITE_APPLICATION_ID=
