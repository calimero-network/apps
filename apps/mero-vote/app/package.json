    "@calimero-apps/glass": "workspace:*",
    "@calimero-apps/passkey": "workspace:*",
    "@calimero-network/mero-js": "catalog:component",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@calimero-apps/test-setup": "workspace:*",
    "@eslint/js": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
