<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeroVote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The node's consent page sends the person back here
              (BuildConfig.CONSENT_CALLBACK_URL, default mero-vote://consent). Scheme and host come
              from the `meroConsentCallback` Gradle property.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${consentScheme}" android:host="${consentHost}" />
            </intent-filter>

            <!--
              Invitations, as the SDK spells them:
              https://links.calimero.network/com.calimero.mero-vote/join?invitation=…
              Not autoVerify: links.calimero.network does not publish this app's assetlinks.json.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="links.calimero.network"
                    android:pathPrefix="/com.calimero.mero-vote/join" />
            </intent-filter>

            <!-- The desktop launcher's form: calimero://com.calimero.mero-vote/join?invitation=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="calimero"
                    android:host="com.calimero.mero-vote" />
            </intent-filter>
        </activity>
    </application>
</manifest>
