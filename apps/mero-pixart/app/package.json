{
  "name": "mero-pixart",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Mero PixArt: collaborative image editor on Calimero (component SDK)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "codegen": "mero-app-build codegen --abi ../logic/res/abi.json --lang ts --name mero-pixart -o src/generated"
  },
  "dependencies": {
    "@calimero-apps/connect": "workspace:*",
    "@calimero-apps/glass": "workspace:*",
    "@calimero-apps/install": "workspace:*",
    "@calimero-apps/members": "workspace:*",
    "@calimero-apps/names": "workspace:*",
    "@calimero-apps/node-served": "workspace:*",
    "@calimero-apps/passkey": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:component",
    "@calimero-network/mero-ui": "catalog:",
    "clsx": "^2.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.15.1",
    "uuid": "^11.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@calimero-apps/test-setup": "workspace:*",
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^28.1.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.30.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
