{
  "schema_version": "wasm-abi/1",
  "types": {
    "Adjustments": {
      "kind": "record",
      "fields": [
        {
          "name": "brightness",
          "type": {
            "kind": "i32"
          },
          "doc": "-100..=100, 0 = neutral"
        },
        {
          "name": "contrast",
          "type": {
            "kind": "i32"
          },
          "doc": "-100..=100, 0 = neutral"
        },
        {
          "name": "saturation",
          "type": {
            "kind": "i32"
          },
          "doc": "-100..=100, 0 = neutral"
        },
        {
          "name": "hue",
          "type": {
            "kind": "i32"
          },
          "doc": "-180..=180 degrees, 0 = neutral"
        },
        {
          "name": "exposure",
          "type": {
            "kind": "i32"
          },
          "doc": "-100..=100, 0 = neutral"
        },
        {
          "name": "blur",
          "type": {
            "kind": "u32"
          },
          "doc": "0..=100 blur radius in px (filter), 0 = none"
        },
        {
          "name": "invert",
          "type": {
            "kind": "bool"
          },
          "doc": "invert colors"
        },
        {
          "name": "curves",
          "type": {
            "kind": "string"
          },
          "doc": "JSON-encoded curve control points (per-channel splines). Opaque to the\ncontract; the frontend interprets it. Empty = identity curve."
        }
      ]
    },
    "Canvas": {
      "kind": "record",
      "doc": "The owner-gated canvas settings: size and background.",
      "fields": [
        {
          "name": "width",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "background",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "CursorState": {
      "kind": "record",
      "fields": [
        {
          "name": "identity",
          "type": {
            "kind": "string"
          },
          "doc": "The device this pointer belongs to (hex context key) — unique per open\ninstallation, so it is what the map is keyed by."
        },
        {
          "name": "account",
          "type": {
            "kind": "string"
          },
          "doc": "The member (account) behind that device, so the overlay can label the\npointer with a username without a second lookup table. Filled from the\nentry's owner stamp on read, so nobody can put a pointer under someone\nelse's name."
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "DocumentInfo": {
      "kind": "record",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "width",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "background",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "layerCount",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "memberCount",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    },
    "Layer": {
      "kind": "record",
      "doc": "`parent_id` and `layer_index` are indexed, so a group's children and the\ntop or bottom of the stack are seeks rather than scans.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "\"raster\" | \"group\" | \"text\" | \"adjustment\" | \"fill\""
        },
        {
          "name": "parentId",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "Parent group layer id (folder nesting); None = top level."
        },
        {
          "name": "layerIndex",
          "type": {
            "kind": "u32"
          },
          "doc": "Order within the parent (ascending = bottom→top)."
        },
        {
          "name": "visible",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "locked",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "opacity",
          "type": {
            "kind": "u32"
          },
          "doc": "0..=100"
        },
        {
          "name": "blendMode",
          "type": {
            "kind": "string"
          },
          "doc": "\"normal\" | \"multiply\" | \"screen\" | \"overlay\" | \"darken\" | \"lighten\" | …"
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "width",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "rotation",
          "type": {
            "kind": "i32"
          }
        },
        {
          "name": "scaleX",
          "type": {
            "kind": "i32"
          },
          "doc": "percent, 100 = 1:1"
        },
        {
          "name": "scaleY",
          "type": {
            "kind": "i32"
          }
        },
        {
          "name": "skewX",
          "type": {
            "kind": "i32"
          },
          "doc": "Horizontal shear in degrees (-80..=80), 0 = none."
        },
        {
          "name": "skewY",
          "type": {
            "kind": "i32"
          },
          "doc": "Vertical shear in degrees (-80..=80), 0 = none."
        },
        {
          "name": "flipH",
          "type": {
            "kind": "bool"
          },
          "doc": "Mirror across the layer's vertical centre line."
        },
        {
          "name": "flipV",
          "type": {
            "kind": "bool"
          },
          "doc": "Mirror across the layer's horizontal centre line."
        },
        {
          "name": "warp",
          "type": {
            "kind": "string"
          },
          "doc": "Corner-pin warp: JSON `{\"tl\":[dx,dy],\"tr\":[…],\"br\":[…],\"bl\":[…]}` in the\nlayer's own pixel units. Opaque to the contract (like `adjustments.curves`)\n— the renderer subdivides the quad into a triangle mesh. Empty = no warp."
        },
        {
          "name": "blobId",
          "type": {
            "kind": "string"
          },
          "doc": "PNG pixel data for raster layers (blob id). Empty for non-raster kinds."
        },
        {
          "name": "maskBlobId",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "Grayscale PNG layer mask (blob id). None = no mask."
        },
        {
          "name": "fill",
          "type": {
            "kind": "string"
          },
          "doc": "Solid color for `fill` layers (and a tint reference otherwise)."
        },
        {
          "name": "adjustments",
          "type": {
            "$ref": "Adjustments"
          }
        },
        {
          "name": "text",
          "type": {
            "$ref": "TextProps"
          },
          "nullable": true
        },
        {
          "name": "createdBy",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Member": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "username",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "avatar",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "joinedAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "usernameUpdatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Dedicated LWW clock for username/avatar edits (joined_at never changes,\nso merging on it would freeze a member's username at its first value)."
        }
      ]
    },
    "MemberRole": {
      "kind": "record",
      "doc": "A member paired with their effective role, for the settings/members UI.",
      "fields": [
        {
          "name": "member",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "role",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "MeroPixArt": {
      "kind": "record",
      "fields": [
        {
          "name": "doc_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          }
        },
        {
          "name": "doc_description",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          }
        },
        {
          "name": "canvas",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "$ref": "Canvas"
              }
            }
          },
          "doc": "`None` until the owner first resizes or recolours; `initial_canvas`\nanswers until then."
        },
        {
          "name": "initial_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "What `init` was given. The `Ownable` cells above cannot be seeded at init\non rc.20 (the value is silently dropped — see `init`), so the opening\nvalues live here and the owner-gated cells take over from the first\nowner edit onwards. `Frozen`: written once at init, changeable by nobody,\nso a member cannot rename the document by rewriting the fallback. Read\nthrough `doc_name_str` / `canvas_now`."
        },
        {
          "name": "initial_description",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "initial_canvas",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "$ref": "Canvas"
            }
          }
        },
        {
          "name": "layers",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Layer"
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "Writer-set guarded: only accounts holding a role mask projected from\n`roles` (editors, admins) may write an entry, on every node."
        },
        {
          "name": "members",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Member"
            }
          },
          "doc": "One slot per account, written only by that account."
        },
        {
          "name": "cursors",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CursorState"
            },
            "crdt_type": "authored_map"
          },
          "doc": "Keyed by DEVICE, not by member — see `CursorState`. The only map here\nthat is. Each entry is owned by the account that wrote it."
        },
        {
          "name": "roles",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          }
        }
      ]
    },
    "TextProps": {
      "kind": "record",
      "fields": [
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "fontFamily",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "fontSize",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "color",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bold",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "italic",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "align",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    }
  },
  "methods": [
    {
      "name": "add_layer",
      "params": [
        {
          "name": "layer",
          "type": {
            "$ref": "Layer"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "bring_to_front",
      "doc": "The top of the stack is one seek on the `layer_index` index.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "can_edit",
      "params": [],
      "returns": {
        "kind": "bool"
      },
      "intent": "read_only"
    },
    {
      "name": "clear_layers",
      "params": [],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_layer",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "get_cursors",
      "doc": "Every pointer, labelled with the account on its owner stamp.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "CursorState"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_document",
      "params": [],
      "returns": {
        "$ref": "DocumentInfo"
      },
      "intent": "read_only"
    },
    {
      "name": "get_layer",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "Layer"
      },
      "returns_nullable": true,
      "intent": "read_only"
    },
    {
      "name": "get_layers",
      "doc": "Every layer, bottom to top: the `layer_index` index already holds them\nin that order.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "Layer"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_members",
      "doc": "Every member, with `id` taken from the slot's account rather than from\nthe stored value.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "Member"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_role",
      "params": [
        {
          "name": "member",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "grant_editor",
      "params": [
        {
          "name": "member",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "init",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "width",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "join",
      "doc": "Add the caller to the roster. Keyed by account, so opening the document\non a second machine does not add a second \"member\". The roster is one\n`UserStorage` slot per account, so nobody can rename anyone else.",
      "params": [
        {
          "name": "username",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "avatar",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "timestamp",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "list_roles",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "MemberRole"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "move_layer",
      "doc": "Move a layer into / out of a group and set its index in one call.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "parent_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "layer_index",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "move_layers",
      "doc": "Re-parent several layers in one call, so \"group the selection\" is a single\nstate transition rather than one RPC per layer.\n\nA layer may not become its own ancestor: every requested parent is walked\nup the (pre-move) tree first and the pair is dropped if the move would\nclose a cycle, which would otherwise make `get_layers` unrenderable for\nevery peer. Unknown ids are skipped.",
      "params": [
        {
          "name": "moves",
          "type": {
            "kind": "list",
            "items": {
              "kind": "tuple",
              "elements": [
                {
                  "kind": "string"
                },
                {
                  "kind": "string"
                }
              ]
            }
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "my_role",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "reorder_layers",
      "doc": "Apply an explicit ordering: each (id, index) pair sets that layer's\n`layer_index`. Used after a drag-reorder in the layers panel.",
      "params": [
        {
          "name": "order",
          "type": {
            "kind": "list",
            "items": {
              "kind": "tuple",
              "elements": [
                {
                  "kind": "string"
                },
                {
                  "kind": "u32"
                }
              ]
            }
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "revoke_editor",
      "params": [
        {
          "name": "member",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "send_to_back",
      "doc": "Put a layer below every other one. When the bottom of the stack has room\n(its index is above 0) this writes one layer; only a stack already\nstarting at 0 has to shift the others up.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "transfer_ownership",
      "doc": "Hand the document (and its owner-gated config) to another member. Owner-only.",
      "params": [
        {
          "name": "new_owner",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "update_adjustments",
      "doc": "Patch non-destructive adjustments on a layer (or adjustment layer).",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "brightness",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "contrast",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "saturation",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "hue",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "exposure",
