{
  "abiVersion": 1,
  "errors": {
    "AlreadyPlayed": {},
    "BadMove": {
      "uci": "string"
    },
    "GameLimit": {},
    "GameNotFinished": {},
    "GameOver": {},
    "IllegalMove": {
      "uci": "string"
    },
    "MoveLimit": {},
    "NoDrawOffer": {},
    "NoDrawToClaim": {},
    "NotSeated": {},
    "NotYourMove": {},
    "SeatTaken": {},
    "UnknownSeat": {
      "seat": "string"
    },
    "WaitingForOpponent": {}
  },
  "events": {
    "DrawDeclined": {
      "by": "string",
      "game": "u32"
    },
    "DrawOffered": {
      "by": "string",
      "game": "u32"
    },
    "GameEnded": {
      "game": "u32",
      "reason": "string",
      "result": "string"
    },
    "GameStarted": {
      "game": "u32"
    },
    "Initialized": {},
    "Moved": {
      "by": "string",
      "game": "u32",
      "ply": "u32",
      "san": "string"
    },
    "PlayerJoined": {
      "member": "string"
    },
    "Seated": {
      "member": "string",
      "seat": "string"
    },
    "Vacated": {
      "member": "string",
      "seat": "string"
    }
  },
  "methods": {
    "acceptDraw": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Accept the opponent's standing offer. `GameOver`, `NotSeated`,\n`NoDrawOffer`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "claimDraw": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Claim the draw the position allows: threefold repetition or the\nfifty-move rule. Both are claims under the rules of chess, so neither\nends a game on its own. `GameOver`, `NotSeated`, `NoDrawToClaim`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "declineDraw": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Refuse the opponent's standing offer (a move refuses it too).\n`NotSeated`, `NoDrawOffer`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "heartbeat": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Presence only: no event, so a heartbeat does not wake every client.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "history": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every game this table has played, oldest first (at most 1,000).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<GameSummary>"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A new table with game 0 waiting for two players. `title` defaults to\n`\"Chess\"`; `now` (the creator's clock) is `createdAt`, `\"0\"` when not\ngiven.",
      "kind": "init",
      "params": [
        [
          "title",
          "option<string>"
        ],
        [
          "now",
          "option<u64>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "join": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Announce yourself at the table, or refresh your presence and name.\nEmits `PlayerJoined` the first time.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "offerDraw": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Offer a draw in the current position. The offer stands until the\nposition changes. `GameOver`, `NotSeated`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "play": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Play a move, in UCI (`e2e4`, `e7e8q`; a promotion with no piece named\nis a queening). Returns its SAN. Emits `Moved`, then `GameEnded` when\nthe move ended the game on the board.\n\n`GameOver`, `MoveLimit`, `WaitingForOpponent` (a chair is empty),\n`NotYourMove`, `BadMove` (not UCI), `IllegalMove`.",
      "kind": "call",
      "params": [
        [
          "uci",
          "string"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "rematch": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Start the next game, colours swapped. Returns its index.\n`GameNotFinished`, `NotSeated`, `GameLimit`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "u32"
    },
    "resign": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Resign the current game. `GameOver`, `NotSeated`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "sit": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Take the `white` or `black` chair, if it is free. Sitting in your own\nchair again does nothing.\n\nThe seat name is the colour you hold in the FIRST game; colours swap\non every rematch. Taking BOTH chairs is allowed on purpose: one person\nmoving for each side in turn is how chess is played when the other\nperson is in the room. `UnknownSeat`, `SeatTaken`.",
      "kind": "call",
      "params": [
        [
          "seat",
          "string"
        ],
        [
          "name",
          "string"
        ],
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "stand": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Give up your chair: only before you have played at this table, and\nonly before the current game has a move. A chair you have played from\nis the table's record of who played; the way out of a game is\n`resign`. `NotSeated`, `AlreadyPlayed`.",
      "kind": "call",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "table": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The whole table in one call, as the caller sees it at `now` (their\nclock, for who is `online`). See [`TableView`].",
      "kind": "view",
      "params": [
        [
          "now",
          "u64"
        ]
      ],
      "public": false,
      "returns": "TableView"
    }
  },
  "state": {
    "fields": {
      "acted": "set",
