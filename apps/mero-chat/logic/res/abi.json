{
  "abiVersion": 1,
  "errors": {
    "Banned": {
      "message": "string"
    },
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "message": "string"
    }
  },
  "events": {
    "InfoUpdated": {},
    "Initialized": {},
    "MessageEdited": {
      "messageId": "string"
    },
    "MessageSent": {
      "messageId": "string"
    },
    "MessageSentThread": {
      "messageId": "string"
    },
    "ProfileUpdated": {
      "account": "string"
    },
    "ReactionUpdated": {
      "messageId": "string"
    },
    "RoleUpdated": {
      "account": "string"
    }
  },
  "methods": {
    "deleteDraft": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes the caller's draft for `channel`.",
      "kind": "call",
      "params": [
        [
          "channel",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteMessage": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a message. Its sender blanks it in place (the slot and its\nindex stay). The staff remove anyone's: a reply is removed from its\nthread, a top-level message is hidden and read back blank. Anyone else\nis `Forbidden`. Emits `MessageSentThread` for a reply, `MessageSent` for\na top-level message (as v1).",
      "kind": "call",
      "params": [
        [
          "messageId",
          "string"
        ],
        [
          "parentId",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "editMessage": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replaces the text of the caller's own message (`parentId` names a\nreply's parent). `NotFound` for an unknown message, `Forbidden` for\nsomeone else's. Emits `MessageEdited`.",
      "kind": "call",
      "params": [
        [
          "messageId",
          "string"
        ],
        [
          "newMessage",
          "string"
        ],
        [
          "timestamp",
          "u64"
        ],
        [
          "parentId",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "MessageView"
    },
    "getChannelInfo": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Alias for `getInfo`; `channel` is accepted and ignored.",
      "kind": "view",
      "params": [
        [
          "channel",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "ContextInfo"
    },
    "getDraft": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's draft for `channel`, or \"\".",
      "kind": "view",
      "params": [
        [
          "channel",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "getInfo": {
      "allowSystem": false,
      "confirm": false,
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "ContextInfo"
    },
    "getMemberRole": {
      "allowSystem": false,
      "confirm": false,
      "doc": "`identity`'s role; `User` when it has none.",
      "kind": "view",
      "params": [
        [
          "identity",
          "string"
        ]
      ],
      "public": false,
      "returns": "Role"
    },
    "getMessageCount": {
      "allowSystem": false,
      "confirm": false,
      "doc": "How many top-level messages the channel holds (one stored count).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "u64"
    },
    "getMessages": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A page of the channel, or of one thread (`parentMessage`), counted back\nfrom the END: offset 0 is the newest page. `limit` defaults to, and is\ncapped at, 1,000. `searchTerm` keeps only messages whose text contains it\n(as `searchMessages` compares), and `totalCount` is then the number of\nmatches. A search here, and a thread, read the whole collection.",
      "kind": "view",
      "params": [
        [
          "parentMessage",
          "option<string>"
        ],
        [
          "limit",
          "option<u32>"
        ],
        [
          "offset",
          "option<u32>"
        ],
        [
          "searchTerm",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "FullMessageResponse"
    },
    "getMessagesFrom": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Top-level messages by ABSOLUTE position, ascending, from `start`: the\nresumable read. `limit` defaults to, and is capped at, 1,000.\n`totalCount` is the channel's length.",
      "kind": "view",
      "params": [
        [
          "start",
          "u64"
        ],
        [
          "limit",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "FullMessageResponse"
    },
    "getProfiles": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every member's profile, in account order; at most 1,000.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<UserProfile>"
    },
    "getUnreadCount": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Top-level messages newer than the caller's last read, not their own and\nnot deleted, among the newest `MAX_UNREAD_SCAN` (the count saturates there).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "u32"
    },
    "getUnreadMentions": {
      "allowSystem": false,
      "confirm": false,
      "doc": "As `getUnreadCount`, counting only messages that mention the caller or\n`@everyone` / `@here`.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "u32"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Founds the conversation. Every argument is optional (a harness or a\ncluster creates the app with none): `contextType` defaults to `Channel`.\nThe app's owner is the creator and the only admin; a non-blank\n`creatorUsername` becomes their profile. Emits `Initialized`.",
      "kind": "init",
      "params": [
        [
          "name",
          "option<string>"
        ],
        [
          "contextType",
          "option<ContextType>"
        ],
        [
          "description",
          "option<string>"
        ],
        [
          "creatorUsername",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "listRoles": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every account with a role other than `User`, as `[account, role]`; at\nmost 1,000 of each kind.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<tuple<string, Role>>"
    },
    "markAsRead": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Records the caller's last-read timestamp (seconds). Emits nothing.",
      "kind": "call",
      "params": [
        [
          "timestamp",
          "u64"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "markMessagesAsRead": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A no-op kept for clients that call it. Read state is `markAsRead`.",
      "kind": "view",
      "params": [
        [
          "channel",
          "option<string>"
        ],
        [
          "timestamp",
          "option<u64>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "messagePosition": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The position of the top-level message `messageId`, for opening a search\nhit where it was said (`getMessagesFrom`). A reply, or an unknown id,\nhas none.",
      "kind": "view",
      "params": [
        [
          "messageId",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<u64>"
    },
    "saveDraft": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Saves the caller's draft for `channel`; an empty text deletes it. At\nmost `MAX_MESSAGE_LEN` bytes (`Invalid`).",
      "kind": "call",
      "params": [
        [
          "channel",
          "string"
        ],
        [
          "text",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "searchMessages": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Messages whose text contains `query`, newest first by position, each\ntop-level message followed by its replies. The node's full-text index is\nnot available to components at `1.0.0-rc.7`, so this is the bounded walk\n`searchMessagesScan` makes; see there.",
      "kind": "view",
      "params": [
        [
          "query",
          "string"
        ],
        [
          "cursor",
          "option<string>"
        ],
        [
          "limit",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "SearchPage"
    },
    "searchMessagesScan": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Messages whose text contains `query` (markup dropped, folded for case,\naccents and width), walking the channel by position from the newest\nmessage down, each followed by its replies. Deleted and staff-removed\nmessages are never returned. A call stops at `limit` hits (default 20,\nat most 50) or once it read `MAX_SEARCH_ROWS` messages or\n`MAX_SEARCH_BYTES` of text, and returns `nextCursor` to continue.",
      "kind": "view",
      "params": [
        [
          "query",
          "string"
        ],
        [
          "cursor",
          "option<string>"
        ],
        [
          "limit",
          "option<u32>"
        ]
      ],
      "public": false,
      "returns": "SearchPage"
    },
    "sendMessage": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Sends a message as the caller: top-level, or a reply to the top-level\nmessage `parentMessage`. `timestamp` is the client's clock in seconds, at\nmost `MAX_CLOCK_SKEW_SECS` ahead of the log's. Attachments name blobs\nuploaded to this app. Emits `MessageSent` or `MessageSentThread`.",
      "kind": "call",
      "params": [
        [
          "message",
          "string"
        ],
        [
          "mentions",
          "list<string>"
        ],
        [
          "mentionsUsernames",
          "list<string>"
        ],
        [
          "parentMessage",
          "option<string>"
        ],
        [
          "timestamp",
          "u64"
        ],
        [
          "files",
          "option<list<AttachmentInput>>"
        ],
        [
          "images",
          "option<list<AttachmentInput>>"
        ]
      ],
      "public": false,
      "returns": "MessageView"
    },
    "setMemberRole": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes `target`'s role. An admin may set any role; a moderator may only\nflip a `User` to `Banned` and back; anyone else is `Forbidden`. An admin\ncannot demote themselves (`Forbidden`). Emits `RoleUpdated` when the role\nchanged.",
      "kind": "call",
      "params": [
        [
          "target",
          "string"
        ],
        [
          "role",
          "Role"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "setProfile": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Sets the caller's profile. The username is kept from the first call on\n(only the avatar changes after that); it must not be blank and is at\nmost 50 bytes (`Invalid`). `avatar` is a blob id; `null` keeps the\ncurrent one. Emits `ProfileUpdated`.",
      "kind": "call",
      "params": [
        [
          "username",
          "string"
        ],
        [
          "avatar",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "updateInfo": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Renames the conversation or changes its description. Admins only\n(`Forbidden`). Emits `InfoUpdated`.",
      "kind": "call",
      "params": [
        [
          "name",
          "option<string>"
        ],
        [
          "description",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "updateReaction": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds or removes the CALLER's reaction to a message. `emoji` must be\n1-64 bytes (`Invalid`); `NotFound` for an unknown message. Emits\n`ReactionUpdated`.",
      "kind": "call",
      "params": [
        [
          "messageId",
          "string"
        ],
        [
          "emoji",
          "string"
        ],
        [
          "add",
          "bool"
        ]
      ],
      "public": false,
      "returns": "string"
    }
  },
  "state": {
    "fields": {
      "admins": "set",
      "banned": "set",
      "drafts": "unorderedMap",
      "founding": "cell",
      "hidden": "set",
      "info": "cell",
      "messageIds": "unorderedMap",
      "messages": "vector",
      "mods": "set",
      "profiles": "unorderedMap",
      "reactions": "set",
      "readReceipts": "perUser",
      "threadStats": "unorderedMap",
      "threads": "unorderedMap"
    },
    "search": {
      "admins": [],
      "banned": [],
      "drafts": [],
      "founding": [],
      "hidden": [],
      "info": [],
      "messageIds": [],
      "messages": [],
      "mods": [],
      "profiles": [],
      "reactions": [],
      "readReceipts": [],
      "threadStats": [],
      "threads": []
    },
    "version": 1
  },
  "types": {
    "AttachmentInput": {
      "fields": [
        [
          "name",
          "string"
        ],
        [
          "mimeType",
          "string"
        ],
        [
          "size",
          "u64_number"
        ],
        [
          "blobIdStr",
          "string"
        ]
      ],
      "kind": "record"
    },
    "AttachmentView": {
      "fields": [
        [
          "name",
          "string"
        ],
        [
          "mimeType",
          "string"
        ],
        [
          "size",
          "u64"
        ],
        [
          "blobId",
          "string"
        ],
        [
          "uploadedAt",
          "u64"
        ]
      ],
      "kind": "record"
    },
    "ContextInfo": {
      "fields": [
        [
          "name",
          "string"
        ],
        [
          "contextType",
          "ContextType"
        ],
        [
          "description",
          "string"
        ],
        [
          "createdAt",
          "u64"
        ],
        [
          "creator",
          "string"
        ]
      ],
      "kind": "record"
    },
    "ContextType": {
      "kind": "enum",
      "variants": [
        {
          "name": "Channel"
        },
        {
          "name": "Dm"
        }
      ]
    },
    "FullMessageResponse": {
      "fields": [
        [
          "totalCount",
          "u32"
        ],
        [
          "messages",
          "list<MessageView>"
        ],
        [
          "startPosition",
          "u32"
        ]
      ],
      "kind": "record"
    },
    "MessageView": {
      "fields": [
        [
          "index",
          "u64"
        ],
        [
          "timestamp",
          "u64"
        ],
        [
          "sender",
          "string"
        ],
        [
          "mentions",
          "list<string>"
        ],
        [
          "mentionsUsernames",
          "list<string>"
        ],
        [
          "files",
          "list<AttachmentView>"
        ],
        [
          "images",
          "list<AttachmentView>"
        ],
        [
          "id",
          "string"
        ],
        [
          "text",
          "string"
        ],
        [
          "editedOn",
          "option<u64>"
        ],
        [
          "reactions",
          "option<BTreeMap<String,Vec<String>>>"
        ],
        [
          "deleted",
          "option<bool>"
        ],
        [
          "threadCount",
          "u32"
        ],
        [
          "threadLastTimestamp",
          "u64"
        ],
        [
          "parentMessageId",
          "option<string>"
        ]
      ],
      "kind": "record"
    },
    "Role": {
      "kind": "enum",
      "variants": [
        {
          "name": "User"
        },
        {
          "name": "Mod"
        },
        {
          "name": "Admin"
        },
        {
          "name": "Banned"
        }
      ]
    },
    "SearchHit": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "parentMessageId",
          "option<string>"
        ],
        [
          "index",
          "option<u64>"
        ],
        [
          "timestamp",
          "u64"
        ],
        [
          "anchorTimestamp",
          "u64"
        ],
        [
          "sender",
          "string"
        ],
        [
          "snippet",
          "string"
        ],
        [
          "matchStart",
          "u32"
        ],
        [
          "matchEnd",
          "u32"
        ]
      ],
      "kind": "record"
    },
    "SearchPage": {
      "fields": [
        [
          "hits",
          "list<SearchHit>"
        ],
        [
          "nextCursor",
          "option<string>"
        ],
        [
          "frontierTimestamp",
          "option<u64>"
        ]
      ],
      "kind": "record"
    },
    "UserProfile": {
      "fields": [
        [
          "identity",
          "string"
        ],
        [
          "username",
          "string"
        ],
        [
          "avatar",
          "option<string>"
        ]
      ],
      "kind": "record"
    }
  },
  "world": "calimero:app@0.5.1"
}
