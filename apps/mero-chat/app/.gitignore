# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Playwright auth state and integration env (contain tokens — never commit)
e2e/.auth/
.env.integration

# Local dev env written by scripts/dev-node.sh (VITE_APPLICATION_ID is the id
# of YOUR locally built bundle — machine-specific, never commit). .env.example
# stays tracked; this pattern matches only a bare `.env`.
.env

# dev-only overlay produced by scripts/dev-invite.sh — populated per-run, never commit.
public/dev-overlay.json

# Playwright output
e2e-report/
playwright-report/
test-results/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
