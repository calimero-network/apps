{
  "name": "mero-chat",
  "private": true,
  "version": "0.0.1",
  "description": "Mero Chat — team chat on Calimero (component SDK, CalimeroClient)",
  "keywords": [
    "calimero",
    "chat",
    "react",
    "vite",
    "web3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json}'",
    "prettier:write": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json}'",
    "codegen": "mero-app-build codegen --abi ../logic/res/abi.json --lang ts --name mero-chat -o src/generated"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@calimero-apps/connect": "workspace:*",
    "@calimero-apps/glass": "workspace:*",
    "@calimero-apps/members": "workspace:*",
    "@calimero-apps/names": "workspace:*",
    "@calimero-apps/node-served": "workspace:*",
    "@calimero-apps/passkey": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:component",
    "@calimero-network/mero-ui": "catalog:",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.16",
    "@radix-ui/react-toast": "^1.2.20",
    "@uidotdev/usehooks": "^2.4.1",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "dompurify": "^3.4.17",
    "lodash": "^4.18.1",
    "quill": "^2.0.3",
    "react": "catalog:",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-dom": "catalog:",
    "react-hook-form": "^7.82.0",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "catalog:",
    "react-singleton-hook": "^4.0.1",
    "react-virtuoso": "^4.18.7",
    "remark": "^15.0.1",
    "strip-markdown": "^6.0.0",
    "styled-components": "^6.4.4",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@calimero-apps/test-setup": "workspace:*",
    "@eslint/js": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/styled-components": "^5.1.28",
    "@vitejs/plugin-react-swc": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "fake-indexeddb": "^6.2.5",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "^3.9.5",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "catalog:",
    "workbox-window": "^7.4.1"
  }
}
