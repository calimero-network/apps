{
  "name": "calimero-chat",
  "private": true,
  "version": "0.0.1",
  "description": "Calimero Chat frontend application built with React",
  "keywords": [
    "calimero",
    "chat",
    "react",
    "vite",
    "web3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json}'",
    "prettier:write": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json}'",
    "e2e": "playwright test --project=mocked",
    "e2e:ui": "playwright test --ui --project=mocked",
    "e2e:ui:all": "../scripts/setup-nodes.sh --restart && playwright test --ui",
    "e2e:live": "../scripts/setup-nodes.sh --restart && playwright test --project=mocked --project=live; ../scripts/setup-nodes.sh --stop",
    "e2e:nodes": "../scripts/setup-nodes.sh --restart && playwright test --project=rpc --project=rpc-admin --project=integration; ../scripts/setup-nodes.sh --stop",
    "e2e:all": "../scripts/setup-nodes.sh --restart && playwright test; ../scripts/setup-nodes.sh --stop",
    "test:sse": "vitest run src/hooks/useSseSubscription.test.ts && playwright test --project=sse"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@calimero-network/mero-js": "^7.0.2",
    "@calimero-network/mero-platform": "^0.1.0",
    "@calimero-network/mero-platform-react": "^0.1.0",
    "@calimero-network/mero-react": "^4.4.1",
    "@calimero-network/mero-ui": "1.4.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.16",
    "@radix-ui/react-toast": "^1.2.20",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.12.0",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "bs58": "^6.0.0",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.3",
    "iframe-resizer-react": "^5.1.5",
    "install": "^0.13.0",
    "lodash": "^4.18.1",
    "prettier": "^3.9.5",
    "quill": "^2.0.3",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "^7.18.1",
    "react-singleton-hook": "^4.0.1",
    "react-virtuoso": "^4.18.7",
    "remark": "^15.0.1",
    "strip-markdown": "^6.0.0",
    "styled-components": "^6.4.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.28",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.9",
    "workbox-window": "^7.4.1"
  },
  "optionalDependencies": {
    "@types/react": "^17.0.44"
  },
  "resolutions": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
