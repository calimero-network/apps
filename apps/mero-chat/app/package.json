{
  "name": "mero-chat",
  "private": true,
  "version": "0.0.1",
  "description": "Mero Chat — peer-to-peer team chat on Calimero",
  "keywords": [
    "calimero",
    "chat",
    "react",
    "vite",
    "web3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=mocked",
    "test:e2e:ci": "playwright test -c playwright.ci.config.ts",
    "preview": "vite preview",
    "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx,json}'",
    "prettier:write": "prettier --write 'src/**/*.{js,jsx,ts,tsx,json}'",
    "e2e": "playwright test --project=mocked",
    "e2e:ui": "playwright test --ui --project=mocked",
    "e2e:ui:all": "../scripts/setup-nodes.sh --restart && playwright test --ui",
    "e2e:live": "../scripts/setup-nodes.sh --restart && playwright test --project=mocked --project=live; ../scripts/setup-nodes.sh --stop",
    "e2e:nodes": "../scripts/setup-nodes.sh --restart && playwright test --project=rpc --project=rpc-admin --project=integration; ../scripts/setup-nodes.sh --stop",
    "e2e:all": "../scripts/setup-nodes.sh --restart && playwright test; ../scripts/setup-nodes.sh --stop",
    "test:sse": "vitest run src/hooks/useSseSubscription.test.ts && playwright test --project=sse",
    "landing:media": "vite build --config e2e/media/vite.config.ts && node e2e/media/record.mjs"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:",
    "@calimero-network/mero-platform": "catalog:",
    "@calimero-network/mero-platform-react": "catalog:",
    "@calimero-network/mero-react": "catalog:",
    "@calimero-network/mero-ui": "catalog:",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.16",
    "@radix-ui/react-toast": "^1.2.20",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "catalog:",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "bs58": "catalog:",
    "dompurify": "^3.4.13",
    "fflate": "catalog:",
    "iframe-resizer-react": "^5.1.5",
    "lodash": "^4.18.1",
    "quill": "^2.0.3",
    "react": "catalog:",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-dom": "catalog:",
    "react-hook-form": "^7.82.0",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "catalog:",
    "react-singleton-hook": "^4.0.1",
    "react-virtuoso": "^4.18.7",
    "remark": "^15.0.1",
    "strip-markdown": "^6.0.0",
    "styled-components": "^6.4.4",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/styled-components": "^5.1.28",
    "@vitejs/plugin-react-swc": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "fake-indexeddb": "^6.2.5",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "^3.9.5",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "catalog:",
    "workbox-window": "^7.4.1"
  }
}
