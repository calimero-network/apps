{
  "abiVersion": 1,
  "errors": {
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "message": "string"
    }
  },
  "events": {
    "AskChanged": {
      "askId": "string",
      "postId": "string"
    },
    "CategoryChanged": {
      "id": "string"
    },
    "Commented": {
      "id": "string",
      "postId": "string"
    },
    "OfferChanged": {
      "askId": "string",
      "postId": "string"
    },
    "PostDeleted": {
      "id": "string"
    },
    "PostEdited": {
      "id": "string"
    },
    "ProfileSet": {
      "account": "string"
    },
    "QuestionAsked": {
      "id": "string"
    },
    "Reacted": {
      "postId": "string"
    },
    "Read": {
      "postId": "string"
    },
    "SettingsChanged": {},
    "StatusChanged": {
      "postId": "string"
    },
    "TeamChanged": {
      "account": "string"
    },
    "UpdatePublished": {
      "id": "string"
    }
  },
  "methods": {
    "addComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Reply on a post; returns the comment's id. Replying to a reply attaches\nto that reply's parent, so a thread is one level deep. Emits `Commented`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "parentId",
          "option<string>"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "addTeammate": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Make a member of the organization part of the team. Admin only.\n`Invalid` for an account the organization does not hold. Emits\n`TeamChanged`.",
      "kind": "call",
      "params": [
        [
          "account",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "archiveCategory": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Archive, never remove: updates filed under it keep their label. Team\nonly. Emits `CategoryChanged`.",
      "kind": "call",
      "params": [
        [
          "categoryId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "askQuestion": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Ask the team something; returns its id. Anyone in the audience may. The\nasker's own read is recorded. Emits `QuestionAsked`.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ],
        [
          "body",
          "string"
        ],
        [
          "categoryId",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "createCategory": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Team only; at most 50 live categories. Returns the new id. Emits\n`CategoryChanged`.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "emoji",
          "string"
        ],
        [
          "color",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "deleteComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The author may delete their comment; the team may remove any. Emits\n`Commented`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteDraft": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Delete one of the caller's drafts (nothing happens for an unknown id).",
      "kind": "call",
      "params": [
        [
          "draftId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deletePost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Delete a post. An update is tombstoned by any teammate; a question is\nremoved by its author or by the team, with its comments, reactions and\nreads. A question with more than 1,000 of those is refused whole\n(`Invalid`): delete some of its comments first. Emits `PostDeleted`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editCategory": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Team only; an archived category cannot be edited. Emits `CategoryChanged`.",
      "kind": "call",
      "params": [
        [
          "categoryId",
          "string"
        ],
        [
          "name",
          "string"
        ],
        [
          "emoji",
          "string"
        ],
        [
          "color",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Only the author edits a comment. Emits `Commented`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editUpdate": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replace an update's content. Any teammate may. Asks listed with an `id`\nare edited, without one are created, and this update's asks not listed\nare removed. Emits `PostEdited`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "input",
          "UpdateInput"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getEngagement": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Who read what: the team's follow-up list, newest update first. Team only.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<EngagementRow>"
    },
    "getMe": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller: their account, name, roles and muted categories.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "MeView"
    },
    "getOverview": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The home screen in one call.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "Overview"
    },
    "getPost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One post with its sections, metrics and asks.",
      "kind": "view",
      "params": [
        [
          "postId",
          "string"
        ]
      ],
      "public": false,
      "returns": "PostView"
    },
    "getSettings": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The company name and cadence; empty and 0 until the team sets them.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "Settings"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The empty audience. The node runs it once, when the instance is created;\nit takes no arguments. Its creator (the instance's owner) is its first\nadmin.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "listAsks": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every ask across every live update, newest first. `status` filters to\n`\"open\"` or `\"resolved\"`.",
      "kind": "view",
      "params": [
        [
          "status",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "list<AskView>"
    },
    "listCategories": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Live categories, oldest first, with the caller's unread counts.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<CategoryView>"
    },
    "listComments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A post's whole thread, oldest first.",
      "kind": "view",
      "params": [
        [
          "postId",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<CommentView>"
    },
    "listContributions": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Accepted offers since `since` (unix ms, a decimal string; `\"0\"` for all),\noldest first: what the next update's \"Thank you\" section is written from.",
      "kind": "view",
      "params": [
        [
          "since",
          "u64"
        ]
      ],
      "public": false,
      "returns": "list<ContributionView>"
    },
    "listDrafts": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's drafts, most recently touched first.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<DraftView>"
    },
    "listMetrics": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every KPI ever reported, one series per metric name (case-insensitive),\noldest point first.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<MetricSeries>"
    },
    "listPeople": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Everyone this audience knows about: the owner, every teammate, and every\nmember who has written anything (a profile, a read, a comment…). Team\nfirst, then by name, then by account.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<PersonView>"
    },
    "listPosts": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One page of posts, newest first. `kind` is `\"update\"`, `\"question\"` or\n`null` for both; `categoryId` filters to one category; `limit` 0 means\n20, at most 100. The cursor names the last post seen.",
      "kind": "view",
      "params": [
        [
          "kind",
          "option<string>"
        ],
        [
          "categoryId",
          "option<string>"
        ],
        [
          "cursor",
          "option<string>"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "PostPage"
    },
    "markRead": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Record that the caller opened a post. Emits `Read`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "offerHelp": {
      "allowSystem": false,
      "confirm": false,
      "doc": "\"I can help.\" One click, optional note. Offering again edits the note\n(and takes back a withdrawal); one offer per account per ask. Only on an\nopen ask. Emits `OfferChanged`.",
      "kind": "call",
      "params": [
        [
          "askId",
          "string"
        ],
        [
          "note",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "publishUpdate": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Publish an update to this audience; returns its id. Team only. The\nauthor's own read is recorded. Emits `UpdatePublished`.",
      "kind": "call",
      "params": [
        [
          "input",
          "UpdateInput"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "react": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Turn one of the six emoji on or off on a post, for the caller. Emits\n`Reacted`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "emoji",
          "string"
        ],
        [
          "on",
          "bool"
        ]
      ],
      "public": false,
      "returns": null
    },
    "removeTeammate": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Take a member off the team. Admin only. An admin stays team: their role\ncomes from the organization. Emits `TeamChanged`.",
      "kind": "call",
      "params": [
        [
          "account",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "saveDraft": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Save a draft for the caller only; returns its id (a new one when\n`draftId` is `null` or empty). Nobody else can list or read it.",
      "kind": "call",
      "params": [
        [
          "draftId",
          "option<string>"
        ],
        [
          "title",
          "string"
        ],
        [
          "payload",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "setAskStatus": {
      "allowSystem": false,
      "confirm": false,
      "doc": "`open` or `resolved`. Team only. Emits `AskChanged`.",
      "kind": "call",
      "params": [
        [
          "askId",
          "string"
        ],
        [
          "status",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setMutedCategories": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Mute categories: their updates stop counting as unread for you. Replaces\nthe whole set. Emits `ProfileSet`.",
      "kind": "call",
      "params": [
        [
          "categoryIds",
          "list<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setOfferStatus": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Accept or decline someone's offer (`offered`, `accepted`, `declined`).\nTeam only. Emits `OfferChanged`.",
      "kind": "call",
      "params": [
        [
          "askId",
          "string"
        ],
        [
          "account",
          "string"
        ],
        [
          "status",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setProfile": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Name yourself. No `account` argument: you can only describe yourself.\nEmits `ProfileSet`.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "firm",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setQuestionStatus": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Mark a question `answered` (or `open` again). Team only. Emits\n`StatusChanged`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "status",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setSettings": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Team only. `cadenceDays` is at most 366 (0 = none). Emits\n`SettingsChanged`.",
      "kind": "call",
      "params": [
        [
          "companyName",
          "string"
        ],
        [
          "cadenceDays",
          "u32"
        ]
      ],
      "public": false,
      "returns": null
    },
    "withdrawOffer": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Withdraw the caller's own offer. Emits `OfferChanged`.",
      "kind": "call",
      "params": [
        [
          "askId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
  "state": {
    "fields": {
      "asks": "table",
      "categories": "table",
      "comments": "table",
      "drafts": "unorderedMap",
      "mutes": "perUser",
      "offers": "table",
      "profiles": "table",
      "questions": "unorderedMap",
      "reactions": "table",
      "reads": "table",
      "settings": "cell",
      "teammates": "set",
      "updates": "unorderedMap"
    },
    "search": {
      "asks": [],
      "categories": [],
      "comments": [],
      "drafts": [],
      "mutes": [],
      "offers": [],
      "profiles": [],
      "questions": [],
      "reactions": [],
      "reads": [],
      "settings": [],
      "teammates": [],
      "updates": []
    },
    "version": 1
  },
