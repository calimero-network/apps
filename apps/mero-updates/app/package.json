{
  "name": "mero-updates",
  "private": true,
  "version": "0.1.0",
  "description": "Mero Updates — investor updates and two-way investor relations on Calimero",
  "keywords": [
    "calimero",
    "investor-updates",
    "investor-relations",
    "react",
    "vite",
    "web3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "codegen": "calimero-abi-codegen -i ../logic/res/abi.json -o src/generated --client-name UpdatesClient --import-path @calimero-network/mero-js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "prettier": "prettier --check 'src/**/*.{ts,tsx,json}'",
    "prettier:write": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "test:e2e:node": "playwright test -c playwright.node.config.ts",
    "test:e2e:ci": "playwright test && playwright test -c playwright.node.config.ts"
  },
  "dependencies": {
    "@calimero-apps/invite": "workspace:*",
    "@calimero-apps/join-sync": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:",
    "@calimero-network/mero-platform": "catalog:",
    "@calimero-network/mero-react": "catalog:",
    "bs58": "catalog:",
    "fflate": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@calimero-network/abi-codegen": "catalog:",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "^3.3.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
