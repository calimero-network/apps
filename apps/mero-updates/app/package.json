{
  "name": "mero-updates",
  "private": true,
  "version": "0.1.0",
  "description": "Mero Updates — investor updates and two-way investor relations on Calimero 1.0",
  "keywords": [
    "calimero",
    "investor-updates",
    "investor-relations",
    "react",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "prettier": "prettier --check 'src/**/*.{ts,tsx,json}'",
    "prettier:write": "prettier --write 'src/**/*.{ts,tsx,json}'"
  },
  "dependencies": {
    "@calimero-apps/connect": "workspace:*",
    "@calimero-apps/glass": "workspace:*",
    "@calimero-apps/node-served": "workspace:*",
    "@calimero-apps/passkey": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:component",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "^3.3.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
