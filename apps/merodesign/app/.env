# MeroDesign frontend configuration (committed defaults; override in .env.local).
#
# Application package — fed to MeroProvider so the node's auth flow can resolve
# MeroDesign from the registry, and used to match MeroDesign's own installed app
# when scoping the teams/namespaces list (see src/api/appId.ts).
VITE_APPLICATION_PACKAGE="com.calimero.merodesign"

