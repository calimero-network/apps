{
  "schema_version": "wasm-abi/1",
  "types": {
    "Event_Submitted": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_Updated": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "FormKey": {
      "kind": "record",
      "doc": "A website form's key, as the admins registered it.",
      "fields": [
        {
          "name": "label",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "What the admins call it, e.g. \"calimero.network contact form\"."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "FormKeyView": {
      "kind": "record",
      "doc": "A registered form key, with what it has sent.",
      "fields": [
        {
          "name": "account",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "leads",
          "type": {
            "kind": "u32"
          },
          "doc": "How many leads this account has submitted."
        },
        {
          "name": "last_lead_at",
          "type": {
            "kind": "u64"
          },
          "doc": "When it last submitted one, or zero."
        }
      ]
    },
    "LeadChanges": {
      "kind": "record",
      "doc": "What a teammate may change about a lead. Absent fields are left alone.",
      "fields": [
        {
          "name": "status",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "notes",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "owner",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "email",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "company",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    },
    "LeadView": {
      "kind": "record",
      "doc": "A lead as the team sees it: the submission with the team's edits laid over.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "email",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "company",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "message",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "notes",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "submitted_by",
          "type": {
            "kind": "string"
          },
          "doc": "The account that submitted it (hex): which form key, or which teammate."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          },
          "doc": "Zero until a teammate first changes it."
        },
        {
          "name": "updated_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "original_name",
          "type": {
            "kind": "string"
          },
          "doc": "The details as submitted, for the fields a teammate corrected."
        },
        {
          "name": "original_email",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "original_company",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "MeroLeads": {
      "kind": "record",
      "fields": [
        {
          "name": "submissions",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "$ref": "Submission"
              }
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "pipeline",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Pipeline"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "settings",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "kind": "record",
                "fields": [],
                "crdt_type": "lww_register",
                "inner_type": {
                  "kind": "string"
                }
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "form_keys",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "FormKey"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "roles",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          }
        }
      ]
    },
    "Pipeline": {
      "kind": "record",
      "doc": "The team's working state for one lead. Every field is a register, so two\nteammates editing different fields at once both keep their change.",
      "fields": [
        {
          "name": "status",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "notes",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The teammate looking after it, as an account (hex), or empty."
        },
        {
          "name": "name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Corrected contact details; empty means \"as submitted\"."
        },
        {
          "name": "email",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "company",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "updated_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Who made the last change, as an account (hex)."
        }
      ]
    },
    "Submission": {
      "kind": "record",
      "doc": "What the visitor sent, exactly. Inserted once, never edited.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "email",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "company",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "message",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source",
          "type": {
            "kind": "string"
          },
          "doc": "The page the form was sent from, e.g. `/cloud/`."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          },
          "doc": "When the node accepted it, in nanoseconds since the Unix epoch."
        },
        {
          "name": "submitted_by",
          "type": {
            "kind": "string"
          },
          "doc": "The account that called `submit_lead` (hex): which form key, or which\nteammate entered it by hand."
        }
      ]
    },
    "TeamMember": {
      "kind": "record",
      "doc": "One entry of the team.",
      "fields": [
        {
          "name": "account",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "admin",
          "type": {
            "kind": "bool"
          }
        }
      ]
    }
  },
  "methods": [
    {
      "name": "add_team_member",
      "doc": "Adds `who` to the team. Admin only, enforced at merge.",
      "params": [
        {
          "name": "who",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "am_i_admin",
      "doc": "Whether the caller is an admin of this inbox.",
      "params": [],
      "returns": {
        "kind": "bool"
      },
      "intent": "read_only"
    },
    {
      "name": "am_i_team",
      "doc": "Whether the caller is on the team (an admin or holding `team`).",
      "params": [],
      "returns": {
        "kind": "bool"
      },
      "intent": "read_only"
    },
    {
      "name": "forget_form_key",
      "doc": "Drops `account` from the register. Admin only. Removing its membership\nis what actually stops it writing; the app does both.",
      "params": [
        {
          "name": "account",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "get_lead",
      "doc": "One lead. Team only.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "LeadView"
      },
      "intent": "read_only"
    },
    {
      "name": "inbox_name",
      "doc": "The inbox's display name, or empty. Anyone in the context may read it.",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "init",
      "doc": "Creates an empty inbox. The installer is its first admin and, until\nteammates are added, the only one who can read it.",
      "params": [],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "list_form_keys",
      "doc": "The registered form keys, newest first, with what each has sent. Admin\nonly.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "FormKeyView"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "list_leads",
      "doc": "Every lead, newest first. Team only.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "LeadView"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "list_team",
      "doc": "The team: the admins and the `team` role. Team only.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "TeamMember"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "my_account",
      "doc": "The caller's account, hex-encoded: what `add_team_member` takes.",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "register_form_key",
      "doc": "Records `account` as a website form key called `label`. Admin only.\n\nThe app calls this after it has made the account a member of the\nnamespace; the register is what lists and labels it.",
      "params": [
        {
          "name": "account",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "remove_team_member",
      "doc": "Removes `who` from the team. Admin only, enforced at merge.",
      "params": [
        {
          "name": "who",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "set_inbox_name",
      "doc": "Names the inbox. Team only.",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "set_status",
      "doc": "Moves a lead to `status`. Team only; the same as `update_lead` with\nonly a status.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "LeadView"
      },
      "intent": "mutating"
    },
    {
      "name": "statuses",
      "doc": "The statuses a lead can be in, in pipeline order.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "kind": "string"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "submit_lead",
      "doc": "Stores a lead and returns its id. What the website form calls.\n\n`name`, `email` and `message` are required; `company` and `source` may\nbe empty. Emits `Submitted` with the id and source page only.",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "email",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "company",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "message",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "update_lead",
      "doc": "Changes a lead: its status, notes, owner or corrected contact details.\nTeam only, and the write itself is rejected at merge for anyone else.\n\nAn empty `name`, `email` or `company` goes back to what was submitted.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "changes",
          "type": {
            "$ref": "LeadChanges"
          }
        }
      ],
      "returns": {
        "$ref": "LeadView"
      },
      "intent": "mutating"
    }
  ],
  "events": [
    {
      "name": "Submitted",
      "payload": {
        "$ref": "Event_Submitted"
      },
      "doc": "A lead was submitted."
    },
    {
      "name": "Updated",
      "payload": {
        "$ref": "Event_Updated"
      },
      "doc": "A teammate changed a lead."
    }
  ],
  "state_root": "MeroLeads",
  "state_version": 1
}