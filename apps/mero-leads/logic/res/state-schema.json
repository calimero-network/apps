{
  "schema_version": "wasm-abi/1",
  "types": {
    "FormKey": {
      "kind": "record",
      "doc": "A website form's key, as the admins registered it.",
      "fields": [
        {
          "name": "label",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "What the admins call it, e.g. \"calimero.network contact form\"."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "MeroLeads": {
      "kind": "record",
      "fields": [
        {
          "name": "submissions",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "$ref": "Submission"
              }
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "pipeline",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Pipeline"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "settings",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "kind": "record",
                "fields": [],
                "crdt_type": "lww_register",
                "inner_type": {
                  "kind": "string"
                }
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "form_keys",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "FormKey"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "roles",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          }
        }
      ]
    },
    "Pipeline": {
      "kind": "record",
      "doc": "The team's working state for one lead. Every field is a register, so two\nteammates editing different fields at once both keep their change.",
      "fields": [
        {
          "name": "status",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "notes",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The teammate looking after it, as an account (hex), or empty."
        },
        {
          "name": "name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Corrected contact details; empty means \"as submitted\"."
        },
        {
          "name": "email",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "company",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "updated_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "Who made the last change, as an account (hex)."
        }
      ]
    },
    "Submission": {
      "kind": "record",
      "doc": "What the visitor sent, exactly. Inserted once, never edited.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "email",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "company",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "message",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source",
          "type": {
            "kind": "string"
          },
          "doc": "The page the form was sent from, e.g. `/cloud/`."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          },
          "doc": "When the node accepted it, in nanoseconds since the Unix epoch."
        },
        {
          "name": "submitted_by",
          "type": {
            "kind": "string"
          },
          "doc": "The account that called `submit_lead` (hex): which form key, or which\nteammate entered it by hand."
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "MeroLeads",
  "state_version": 1
}