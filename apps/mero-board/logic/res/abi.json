      "intent": "mutating"
    },
    {
      "name": "delete_board",
      "doc": "Delete a board with its lists, every card's shared rows, checklist\nitems and labels, and the caller's own card headers and comments. Only\nthe board's creator may delete it. Other people's cards and comments\nbecome unreachable.\n\n# Examples\n```json\n{\"board_id\":\"<board id>\"}\n```",
      "params": [
        {
          "name": "board_id",
          "type": {
            "kind": "string"
          }
