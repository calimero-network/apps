      "destructive": true
    },
    {
      "name": "delete_card",
      "doc": "Delete a card with its checklist, labels and the caller's own comments.\nOnly the card's creator may delete it. Other people's comments are not\nremoved but become unreachable.\n\n# Examples\n```json\n{\"card_id\":\"<card id>\"}\n```",
      "params": [
        {
          "name": "card_id",
          "type": {
            "kind": "string"
          }
