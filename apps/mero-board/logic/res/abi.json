  "methods": [
    {
      "name": "add_checklist_item",
      "doc": "Add a checklist line to a card and return its id (`item-<ms>-<8 hex>`).\n\n# Examples\n```json\n{\"card_id\":\"<card id>\",\"text\":\"Book the venue\",\"rank\":null}\n```",
      "params": [
        {
          "name": "card_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "text",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "rank",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "add_comment",
      "doc": "Post a comment on a card and return its id (`comment-<ms>-<8 hex>`).\n\n# Examples\n```json\n{\"card_id\":\"<card id>\",\"body\":\"Venue confirmed.\"}\n```",
      "params": [
        {
          "name": "card_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "add_label",
      "doc": "Add a label (1 to 32 characters) to a card. Adding it twice keeps one.\n\n# Examples\n```json\n{\"card_id\":\"<card id>\",\"label\":\"marketing\"}\n```",
      "params": [
        {
          "name": "card_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating",
      "idempotent": true
    },
    {
      "name": "create_board",
      "doc": "Create a board in this folder and return its id (`board-<ms>-<8 hex>`).\n\n# Examples\n```json\n{\"name\":\"Q4 launch\",\"rank\":null}\n```",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          },
          "doc": "1 to 64 characters."
        },
        {
          "name": "rank",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "optional position among the folder's boards; omitted appends last."
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "create_card",
      "doc": "Create a card in a list and return its id (`card-<ms>-<8 hex>`).\n\n# Examples\n```json\n{\"board_id\":\"<board id>\",\"list_id\":\"<list id>\",\"title\":\"Write the launch post\",\"description\":null,\"assignee\":null,\"due_at\":null,\"labels\":[\"marketing\"],\"rank\":null}\n```",
      "params": [
        {
          "name": "board_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "list_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          },
          "doc": "1 to 64 characters."
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "optional free text."
        },
        {
          "name": "assignee",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "optional; conventionally a member's account id."
        },
        {
          "name": "due_at",
          "type": {
            "kind": "u64"
          },
          "nullable": true,
          "doc": "optional unix milliseconds."
        },
        {
          "name": "labels",
