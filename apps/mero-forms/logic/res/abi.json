{
  "schema_version": "wasm-abi/1",
  "types": {
    "Answer": {
      "kind": "record",
      "doc": "One stored answer: the field as it was when the response was sent.",
      "fields": [
        {
          "name": "field_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "values",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Empty when an optional field was left blank."
        }
      ]
    },
    "AnswerInput": {
      "kind": "record",
      "doc": "One answer as a website's backend or the app sends it.",
      "fields": [
        {
          "name": "field_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "values",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "One value for most kinds; any number of the options for `checkboxes`."
        }
      ]
    },
    "CaptchaPass": {
      "kind": "record",
      "doc": "A captcha pass: the verifier's signature over\n`mero-forms/captcha/v1|<form>|<link>|<nonce>|<expires_ms>`. The nonce is\nthe visitor's, random, and each one is accepted once.",
      "fields": [
        {
          "name": "nonce",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "expires_ms",
          "type": {
            "kind": "u64"
          },
          "doc": "Milliseconds since the Unix epoch."
        },
        {
          "name": "signature",
          "type": {
            "kind": "string"
          },
          "doc": "64 bytes, hex."
        }
      ]
    },
    "CrmLink": {
      "kind": "record",
      "doc": "Where a form's responses go in Mero CRM, and which field fills what.\nEmpty strings mean \"not set\".",
      "fields": [
        {
          "name": "context_id",
          "type": {
            "kind": "string"
          },
          "doc": "The Mero CRM context (pipeline) the deals go to. Empty: no CRM."
        },
        {
          "name": "stage_id",
          "type": {
            "kind": "string"
          },
          "doc": "The stage a new deal starts in."
        },
        {
          "name": "name_field",
          "type": {
            "kind": "string"
          },
          "doc": "Field ids whose answers fill the contact and the deal."
        },
        {
          "name": "email_field",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "phone_field",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "organization_field",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title_field",
          "type": {
            "kind": "string"
          },
          "doc": "The answer that titles the deal; empty uses the contact's name."
        }
      ]
    },
    "Event_FormChanged": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_ResponseChanged": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_Submitted": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "form_id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Field": {
      "kind": "record",
      "doc": "One field of a form.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          },
          "doc": "Stable, chosen when the field is added: what a website's backend sends\nthe answer under, e.g. `email`. Lowercase letters, digits, `_` and `-`."
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "One of [`FIELD_KINDS`]."
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "help",
          "type": {
            "kind": "string"
          },
          "doc": "A line under the label, or empty."
        },
        {
          "name": "required",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "options",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "The choices, for `choice` and `checkboxes`; empty for the rest."
        }
      ]
    },
    "Form": {
      "kind": "record",
      "doc": "A form. Every field is a register, so two teammates changing different\nparts of one form both keep their change; the field list is edited whole.",
      "fields": [
        {
          "name": "title",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "fields",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "list",
              "items": {
                "$ref": "Field"
              }
            }
          }
        },
        {
          "name": "open",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "bool"
            }
          },
          "doc": "A closed form refuses new responses."
        },
        {
          "name": "crm",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "$ref": "CrmLink"
            }
          }
        },
        {
          "name": "public",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "bool"
            }
          },
          "doc": "Whether its public links take responses. Off: every link is refused,\nand works again when it is turned back on."
        },
        {
          "name": "link_cap",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u32"
            }
          },
          "doc": "Responses each public link may send per hour."
        },
        {
          "name": "captcha_key",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "How a link's response proves a captcha: empty for no captcha, the\nverifier's ed25519 public key (hex) for a pass it signed, or\n`turnstile` for a token the node checks with Cloudflare. See the\ncrate docs, \"Captchas\"."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        }
      ]
    },
    "FormKey": {
      "kind": "record",
      "doc": "A website form's key, as the admins registered it.",
      "fields": [
        {
          "name": "label",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "What the admins call it, e.g. \"calimero.network contact page\"."
        },
        {
          "name": "form_id",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The one form it may submit to."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "FormKeyView": {
      "kind": "record",
      "doc": "A registered form key, with what it has sent.",
      "fields": [
        {
          "name": "account",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "form_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "responses",
          "type": {
            "kind": "u32"
          },
          "doc": "How many responses this account has submitted."
        },
        {
          "name": "last_response_at",
          "type": {
            "kind": "u64"
          },
          "doc": "When it last submitted one, or zero."
        }
      ]
    },
    "FormSummary": {
      "kind": "record",
      "doc": "A form in the list, with what it has collected.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "open",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "fields",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "responses",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "new_responses",
          "type": {
            "kind": "u32"
          },
          "doc": "Not archived and not yet sent to the CRM."
        },
        {
          "name": "last_response_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "FormView": {
      "kind": "record",
      "doc": "A form in full.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "fields",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Field"
            }
          }
        },
        {
          "name": "open",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "crm",
          "type": {
            "$ref": "CrmLink"
          }
        },
        {
          "name": "public",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "link_cap",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "captcha_key",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Link": {
      "kind": "record",
      "doc": "A public link, as the team made it.",
      "fields": [
        {
          "name": "form_id",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "grant_id",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The access grant behind it, on `created_by`'s node."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "LinkFormView": {
      "kind": "record",
      "doc": "A form as a public link's visitor sees it: the questions, and nothing the\nteam keeps about it.",
      "fields": [
        {
          "name": "form_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "fields",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Field"
            }
          }
        },
        {
          "name": "accepting",
          "type": {
            "kind": "bool"
          },
          "doc": "Open and public: a response would be taken."
        },
        {
          "name": "captcha",
          "type": {
            "kind": "bool"
          },
          "doc": "Whether a response needs a captcha."
        },
        {
          "name": "captcha_by_node",
          "type": {
            "kind": "bool"
          },
          "doc": "The captcha is checked by the node: send the Turnstile token as\n`captcha_token`, not a pass."
        }
      ]
    },
    "LinkView": {
      "kind": "record",
      "doc": "A public link, with what it has sent.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "form_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "grant_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "responses",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "last_hour",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "last_response_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "MeroForms": {
      "kind": "record",
      "fields": [
        {
          "name": "responses",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "$ref": "Response"
              }
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "forms",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Form"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "triage",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "ResponseState"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "settings",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "kind": "record",
                "fields": [],
                "crdt_type": "lww_register",
                "inner_type": {
                  "kind": "string"
                }
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "form_keys",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "FormKey"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "links",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Link"
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "captcha_seen",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "kind": "record",
                "fields": [],
                "crdt_type": "lww_register",
                "inner_type": {
                  "kind": "u64"
                }
              },
              "crdt_type": "unordered_map"
            }
          }
        },
        {
          "name": "roles",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          }
        }
      ]
    },
    "Response": {
      "kind": "record",
      "doc": "What a respondent sent, exactly. Inserted once, never edited.",
      "fields": [
        {
          "name": "form_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "answers",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Answer"
            }
          },
          "doc": "One per field of the form, in the form's order."
        },
        {
          "name": "source",
          "type": {
            "kind": "string"
          },
          "doc": "Where it was sent from, e.g. `/contact/`, or empty."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          },
          "doc": "When the node accepted it, in nanoseconds since the Unix epoch."
        },
        {
          "name": "submitted_by",
          "type": {
            "kind": "string"
          },
          "doc": "The account that called `submit_response` (hex): which form key, or\nwhich teammate entered it. For a public link, the node that holds the\nlink's grant."
        },
        {
          "name": "link",
          "type": {
            "kind": "string"
          },
          "doc": "The public link it came through, or empty."
        }
      ]
    },
    "ResponseState": {
      "kind": "record",
      "doc": "The team's state for one response.",
      "fields": [
        {
          "name": "archived",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "bool"
            }
          },
          "doc": "Out of the way, e.g. spam, without being deleted."
        },
        {
          "name": "crm_context",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The CRM context and deal it became, or empty."
        },
        {
          "name": "crm_deal",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "crm_sent_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "crm_sent_by",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "ResponseView": {
      "kind": "record",
      "doc": "A response as the team sees it.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "form_id",
          "type": {
            "kind": "string"
