    {
      "name": "submit_response",
      "doc": "Stores a response to an open form and returns its id. What a website's\nbackend calls with its form key; a teammate may also enter one.\n\nEvery answer is checked against its field. Answers for fields the form\ndoes not have are refused, so a stale website fails loudly. A form key\nmay only answer the form it was issued for. Emits `Submitted` with ids\nonly.",
      "params": [
        {
          "name": "form_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "answers",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "AnswerInput"
            }
          }
        },
        {
          "name": "source",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "submit_via_link",
      "doc": "Stores a response that came through a public link and returns its id.\nThe other method a link's grant names.\n\nRefused unless the form is open and public, the link is under its\nhourly cap, and, when the form asks for a captcha, either `captcha` is\na pass the form's verifier signed for this form and link, unexpired\nand unused, or (a `turnstile` form) Cloudflare accepts\n`captcha_token`. The token is checked last, after everything that\ncosts nothing, so a refused response never spends one.",
      "params": [
        {
          "name": "link",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "answers",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "AnswerInput"
            }
          }
        },
        {
          "name": "captcha",
          "type": {
            "$ref": "CaptchaPass"
          },
          "nullable": true
        },
        {
          "name": "captcha_token",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "update_form",
