{
  "abiVersion": 1,
  "errors": {
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "message": "string"
    },
    "Refused": {
      "message": "string"
    },
    "Unsupported": {
      "message": "string"
    }
  },
  "events": {
    "FormChanged": {
      "id": "string"
    },
    "ResponseChanged": {
      "id": "string"
    },
    "Submitted": {
      "formId": "string",
      "id": "string"
    }
  },
  "methods": {
    "addTeamMember": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds `who` to the team. Admin only.",
      "kind": "call",
      "params": [
        [
          "who",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "amIAdmin": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Whether the caller is an admin.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "bool"
    },
    "amITeam": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Whether the caller is on the team.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "bool"
    },
    "captchaSettings": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The team's Turnstile setup. Team only. No TEE can keep a secret here.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "CaptchaSettings"
    },
    "clearCaptchaSecret": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes the team's Turnstile keys, if any. Admin only.",
      "kind": "call",
      "params": [],
      "public": false,
      "returns": "CaptchaSettings"
    },
    "createForm": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Creates a form with no fields, open, and returns its id. Team only.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ],
        [
          "description",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "createLink": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Records a public link for `formId`: `link` is the SHA-256 (hex) of the\nAPI key's token, `grantId` the key's id. Team only.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "link",
          "string"
        ],
        [
          "grantId",
          "string"
        ],
        [
          "label",
          "string"
        ]
      ],
      "public": false,
      "returns": "LinkView"
    },
    "deleteForm": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a form that has no responses, with its public links. A form\nwith responses is closed instead, so nothing anyone sent disappears.\nTeam only.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteLink": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Stops a public link and returns what it was, so the app can revoke its\nAPI key. Team only.",
      "kind": "call",
      "params": [
        [
          "link",
          "string"
        ]
      ],
      "public": false,
      "returns": "LinkView"
    },
    "fieldKinds": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The kinds of field a form can ask for.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<string>"
    },
    "forgetFormKey": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Drops `account` from the register. Admin only. Revoking the API key is\nwhat stops it calling; the app does both.",
      "kind": "call",
      "params": [
        [
          "account",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getForm": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One form. Any account that reaches the app, and a website's form key:\na website may read the questions it is about to answer.",
      "kind": "view",
      "params": [
        [
          "formId",
          "string"
        ]
      ],
      "public": false,
      "returns": "FormView"
    },
    "getResponse": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One response. Team only.",
      "kind": "view",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": "ResponseView"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Creates an empty workspace. The instance's owner is its first admin\nand, until teammates are added, the only one who can build forms or read\nresponses.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "linkForm": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The form a public link is for, as its visitor sees it. One of the two\nmethods a link's API key names.",
      "kind": "view",
      "params": [
        [
          "link",
          "string"
        ]
      ],
      "public": false,
      "returns": "LinkFormView"
    },
    "listFormKeys": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The registered form keys, newest first, with what each has sent (at\nmost 1,000). Admin only.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<FormKeyView>"
    },
    "listForms": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every form, newest first, with its response counts. Team only.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<FormSummary>"
    },
    "listLinks": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The form's public links, newest first, with what each has sent (at most\n1,000). Team only.",
      "kind": "view",
      "params": [
        [
          "formId",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<LinkView>"
    },
    "listResponses": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A form's responses, newest first (at most 1,000). Team only.",
      "kind": "view",
      "params": [
        [
          "formId",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<ResponseView>"
    },
    "listTeam": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The team: the admins and the accounts they added (at most 1,000 of\neach), in account order. Team only.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<TeamMember>"
    },
    "myAccount": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's account (for an API key, the account it acts for).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "recordCrmDeal": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Records the CRM deal a response became, after the app created it in\nthat CRM instance. Team only. Refuses a response already sent: the log\norders two teammates' records, so the second is refused.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "crmContext",
          "string"
        ],
        [
          "crmDeal",
          "string"
        ]
      ],
      "public": false,
      "returns": "ResponseView"
    },
    "registerFormKey": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Records `account` (an API key's id) as a website form key for\n`formId`, called `label`. Admin only.\n\nThe app calls this right after creating the key, limited to this app\nand to `submitResponse` and `getForm`; the register is what binds it\nto one form, labels it and keeps it off the team.",
      "kind": "call",
      "params": [
        [
          "account",
          "string"
        ],
        [
          "formId",
          "string"
        ],
        [
          "label",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "removeTeamMember": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes `who` from the team. Admin only. An admin stays an admin.",
      "kind": "call",
      "params": [
        [
          "who",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setArchived": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Archives a response, or brings it back. Team only.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "archived",
          "bool"
        ]
      ],
      "public": false,
      "returns": "ResponseView"
    },
    "setCaptchaKey": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Requires a captcha on every response through the form's links: a pass\nsigned by `key` (an ed25519 public key, hex). Empty requires none.\n`turnstile` (the node checks the token) is `Unsupported` on this\nruntime. Team only.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "key",
          "string"
        ]
      ],
      "public": false,
      "returns": "FormView"
    },
    "setCaptchaSecret": {
      "allowSystem": false,
      "confirm": false,
      "doc": "v1 stored the team's own Turnstile keys, the secret sealed to the\nnamespace's TEE. The component SDK cannot seal a secret or send it, so\nthis is refused (`Unsupported`), as v1 refused it without a TEE. Admin\nonly.",
      "kind": "call",
      "params": [
        [
          "siteKey",
          "string"
        ],
        [
          "secret",
          "string"
        ]
      ],
      "public": false,
      "returns": "CaptchaSettings"
    },
    "setCrmLink": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Where the form's responses go in Mero CRM, or `contextId` empty for\nnowhere. The mapped fields must be on the form. Team only.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "link",
          "CrmLink"
        ]
      ],
      "public": false,
      "returns": "FormView"
    },
    "setFormOpen": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Opens or closes a form to new responses. Team only.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "open",
          "bool"
        ]
      ],
      "public": false,
      "returns": "FormView"
    },
    "setFormPublic": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Lets the form's public links take responses, or stops them all.\nTeam only. Links are kept either way.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "public",
          "bool"
        ]
      ],
      "public": false,
      "returns": "FormView"
    },
    "setLinkCap": {
      "allowSystem": false,
      "confirm": false,
      "doc": "How many responses each of the form's links may send per hour. Team only.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "perHour",
          "u32"
        ]
      ],
      "public": false,
      "returns": "FormView"
    },
    "setWorkspaceName": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Names the workspace. Team only.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "submitResponse": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Stores a response to an open form and returns its id. What a website's\nform key calls; a teammate may also enter one.\n\nEvery answer is checked against its field. Answers for fields the form\ndoes not have are refused, so a stale website fails loudly. A form key\nmay only answer the form it was registered for. Emits `Submitted` with\nids only.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "answers",
          "list<AnswerInput>"
        ],
        [
          "source",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "submitViaLink": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Stores a response that came through a public link and returns its id.\nThe other method a link's API key names.\n\nRefused unless the form is open and public, the link is under its\nhourly cap, and, when the form asks for a captcha, `captcha` is a pass\nthe form's verifier signed for this form and link, unexpired and\nunused. `captchaToken` was v1's Turnstile token for a node-checked\nform; it is ignored.",
      "kind": "call",
      "params": [
        [
          "link",
          "string"
        ],
        [
          "answers",
          "list<AnswerInput>"
        ],
        [
          "captcha",
          "option<CaptchaPass>"
        ],
        [
          "captchaToken",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "updateForm": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replaces a form's title, description and fields. Team only.\n\nResponses already sent keep the fields as they were; a removed field\nstays readable on them.",
      "kind": "call",
      "params": [
        [
          "formId",
          "string"
        ],
        [
          "title",
          "string"
        ],
        [
          "description",
          "string"
        ],
        [
          "fields",
          "list<Field>"
        ]
      ],
      "public": false,
      "returns": "FormView"
    },
    "workspaceName": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The workspace's display name, or empty. Anyone who reaches the app.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    }
  },
