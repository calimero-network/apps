{
  "schema_version": "wasm-abi/1",
  "types": {
    "Comment": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "replies",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "CommentReply"
            }
          },
          "doc": "Filled on read from `MeroDesign::replies`, and always stored empty: a\nreply is its own entry, so two replies posted at once both survive.\nKept in a `Vec` inside the comment they were whole-record LWW, and the\ncomment's clock never moved, so one of them was lost."
        }
      ]
    },
    "CommentReply": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "CursorState": {
      "kind": "record",
      "fields": [
        {
          "name": "identity",
          "type": {
            "kind": "string"
          },
          "doc": "The device this pointer belongs to — one per open window."
        },
        {
          "name": "account",
          "type": {
            "kind": "string"
          },
          "doc": "The member (account) behind that device, read from the entry's owner\nstamp, so the overlay can label the pointer with a username."
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Element": {
      "kind": "record",
      "doc": "`layer_index` is indexed, so the stack in order, and its top and bottom,\nare seeks rather than a scan and sort.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "data",
          "type": {
            "$ref": "ElementData"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "width",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "rotation",
          "type": {
            "kind": "i32"
          }
        },
        {
          "name": "fill",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "stroke",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "strokeWidth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "opacity",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "layerIndex",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "createdBy",
          "type": {
            "kind": "string"
          },
          "doc": "Set by the contract from the caller, never taken from the client."
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "shadowColor",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "shadowOffsetX",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "shadowOffsetY",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "shadowBlur",
          "type": {
            "kind": "u32"
          },
          "nullable": true
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "cornerRadius",
          "type": {
            "kind": "u32"
          },
          "nullable": true,
          "doc": "Corner radius in px, clamped by the client to min(width, height) / 2."
        }
      ]
    },
    "ElementData": {
      "kind": "variant",
      "variants": [
        {
          "name": "rect"
        },
        {
          "name": "circle"
        },
        {
          "name": "line",
          "payload": {
            "$ref": "ElementData_Line"
          },
          "doc": "`points` is \"x1,y1 x2,y2\" in element-local space. A bounding box cannot\nexpress which way a line was drawn, so a line drawn bottom-left to\ntop-right came back mirrored. Defaulted so pre-existing elements and older\nclients that send a bare `{\"kind\":\"line\"}` still deserialize."
        },
        {
          "name": "arrow",
          "payload": {
            "$ref": "ElementData_Arrow"
          }
        },
        {
          "name": "path",
          "payload": {
            "$ref": "ElementData_Path"
          }
        },
        {
          "name": "text",
          "payload": {
            "$ref": "ElementData_Text"
          }
        },
        {
          "name": "image",
