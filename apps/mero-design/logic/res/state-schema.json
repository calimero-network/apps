{
  "schema_version": "wasm-abi/1",
  "types": {
    "Comment": {
      "kind": "record",
      "doc": "A comment pinned at a canvas point, with its replies.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          },
          "doc": "Canvas pixels."
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          },
          "doc": "Canvas pixels."
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          },
          "doc": "The writer's member id, set by the contract."
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Unix milliseconds."
        },
        {
          "name": "replies",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "CommentReply"
            }
          },
          "doc": "The thread, ordered by `createdAt`."
        }
      ]
    },
    "CommentReply": {
      "kind": "record",
      "doc": "A reply in a comment thread.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          },
          "doc": "The writer's member id, set by the contract."
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Unix milliseconds."
        }
      ]
    },
    "CursorState": {
      "kind": "record",
      "doc": "A pointer's last reported position.",
      "fields": [
        {
          "name": "identity",
          "type": {
            "kind": "string"
          },
          "doc": "The device key (64 hex) of the node that moved the pointer; one pointer per device."
        },
        {
          "name": "account",
          "type": {
            "kind": "string"
          },
          "doc": "The member id of the account behind that device."
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          },
          "doc": "Canvas pixels."
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          },
          "doc": "Canvas pixels."
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Unix milliseconds."
        }
      ]
    },
    "Element": {
      "kind": "record",
      "doc": "One element on the canvas.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          },
          "doc": "Chosen by the caller; use a fresh UUID."
        },
        {
          "name": "data",
          "type": {
            "$ref": "ElementData"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          },
          "doc": "Left edge, canvas pixels."
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          },
          "doc": "Top edge, canvas pixels."
        },
        {
          "name": "width",
          "type": {
            "kind": "u32"
          },
          "doc": "Pixels."
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          },
          "doc": "Pixels."
        },
        {
          "name": "rotation",
          "type": {
            "kind": "i32"
          },
          "doc": "Degrees, clockwise."
        },
        {
          "name": "fill",
          "type": {
            "kind": "string"
          },
          "doc": "A CSS color, or `transparent`."
        },
        {
          "name": "stroke",
          "type": {
            "kind": "string"
          },
          "doc": "A CSS color, or `transparent`."
        },
        {
          "name": "strokeWidth",
          "type": {
            "kind": "u32"
          },
          "doc": "Pixels."
        },
        {
          "name": "opacity",
          "type": {
            "kind": "u32"
          },
          "doc": "Percent, 0 to 100."
        },
        {
          "name": "layerIndex",
          "type": {
            "kind": "u32"
          },
          "doc": "Paint order; a higher value paints on top."
        },
        {
          "name": "createdBy",
          "type": {
            "kind": "string"
          },
          "doc": "The creator's member id, set by the contract; any value the caller sends is ignored."
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Unix milliseconds."
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Unix milliseconds of the last change; send the current time."
        },
        {
          "name": "shadowColor",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "A CSS color; omitted or `null` means no drop shadow."
        },
        {
          "name": "shadowOffsetX",
          "type": {
            "kind": "i32"
          },
          "nullable": true,
          "doc": "Pixels."
        },
        {
          "name": "shadowOffsetY",
          "type": {
            "kind": "i32"
          },
          "nullable": true,
          "doc": "Pixels."
        },
        {
          "name": "shadowBlur",
          "type": {
            "kind": "u32"
          },
          "nullable": true,
          "doc": "Pixels."
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "Layer name: a `/`-separated path whose last segment is the name and whose\nearlier segments are groups; omitted or `null` means unnamed."
        },
        {
          "name": "cornerRadius",
          "type": {
            "kind": "u32"
          },
          "nullable": true,
          "doc": "Pixels; omitted, `null` or 0 means square corners. The web client draws it\nclamped to min(`width`, `height`) / 2."
        }
      ]
    },
    "ElementData": {
      "kind": "variant",
      "doc": "What an element is, tagged by `kind`: `rect`, `circle`, `line`, `arrow`, `path`,\n`text`, `image` or `svg`.",
      "variants": [
        {
          "name": "rect",
          "doc": "A rectangle filling the element's box."
        },
        {
          "name": "circle",
          "doc": "A circle of diameter `width`, its box's top-left at `x`, `y`; set `height` equal to `width`."
        },
        {
          "name": "line",
          "payload": {
            "$ref": "ElementData_Line"
          },
          "doc": "A straight line; `points` is `\"x1,y1 x2,y2\"` in element-local pixels."
        },
        {
          "name": "arrow",
          "payload": {
            "$ref": "ElementData_Arrow"
          },
          "doc": "A line with an arrowhead at its second point; `points` as for `line`."
        },
        {
          "name": "path",
          "payload": {
            "$ref": "ElementData_Path"
          },
          "doc": "A freehand path; `points` is SVG path data, e.g. `\"M 0 0 L 40 40\"`."
        },
        {
          "name": "text",
          "payload": {
            "$ref": "ElementData_Text"
          },
          "doc": "Text. `fontSize` is in pixels; `text_align` is `left`, `center` or `right`,\n`vertical_align` is `top`, `middle` or `bottom`, and either may be omitted or `null`."
        },
        {
          "name": "image",
          "payload": {
            "$ref": "ElementData_Image"
          },
          "doc": "A raster image: a blob on the node named by `blobId`, with its pixel size."
        },
        {
          "name": "svg",
          "payload": {
            "$ref": "ElementData_Svg"
          },
          "doc": "An SVG image: a blob on the node named by `blobId`, with its pixel size."
        }
      ],
      "tag": "kind"
    },
    "ElementData_Arrow": {
      "kind": "record",
      "fields": [
        {
          "name": "points",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Image": {
      "kind": "record",
      "fields": [
        {
          "name": "naturalWidth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "naturalHeight",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "blobId",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Line": {
      "kind": "record",
      "fields": [
        {
          "name": "points",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Path": {
      "kind": "record",
      "fields": [
        {
          "name": "points",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Svg": {
      "kind": "record",
      "fields": [
        {
          "name": "naturalWidth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "naturalHeight",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "blobId",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Text": {
      "kind": "record",
      "fields": [
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "fontSize",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "fontFamily",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bold",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "italic",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "text_align",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "vertical_align",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    },
    "Member": {
      "kind": "record",
      "doc": "A board member.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          },
          "doc": "Member id: the member's account id (64 hex)."
        },
        {
          "name": "username",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "avatar",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "Avatar URL, or `null`."
        },
        {
          "name": "joinedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Unix milliseconds."
        },
        {
          "name": "usernameUpdatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Unix milliseconds of the last rename; the newest rename wins."
        }
      ]
    },
    "MeroDesign": {
      "kind": "record",
      "fields": [
        {
          "name": "board_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          }
        },
        {
          "name": "board_description",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          }
        },
        {
          "name": "initial_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "initial_description",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "elements",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Element"
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "The canvas. Writer-set guarded: only accounts holding a role mask\nprojected from `roles` (editors, admins) may write an entry, on every\nnode."
        },
        {
          "name": "members",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Member"
            }
          },
          "doc": "One slot per account, written only by that account."
        },
        {
          "name": "comments",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Comment"
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "Guarded like `elements`."
        },
        {
          "name": "replies",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "CommentReply"
              },
              "crdt_type": "sorted_map"
            }
          },
          "doc": "Every reply, keyed `\"<comment>/<created_at:020>/<reply>\"` so one\ncomment's thread is a prefix slice in order. Guarded like `elements`."
        },
        {
          "name": "cursors",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CursorState"
            },
            "crdt_type": "authored_map"
          },
          "doc": "Keyed by DEVICE: a pointer belongs to a screen. Each entry is owned by\nthe account that wrote it."
        },
        {
          "name": "roles",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          }
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "MeroDesign",
  "state_version": 1
}