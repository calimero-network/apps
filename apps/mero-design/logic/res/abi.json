{
  "abiVersion": 1,
  "errors": {
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    }
  },
  "events": {
    "BoardUpdated": {},
    "CommentAdded": {
      "id": "string"
    },
    "CommentDeleted": {
      "id": "string"
    },
    "CommentUpdated": {
      "id": "string"
    },
    "CursorMoved": {
      "identity": "string"
    },
    "ElementAdded": {
      "id": "string"
    },
    "ElementDeleted": {
      "id": "string"
    },
    "ElementUpdated": {
      "id": "string"
    },
    "ElementsAdded": {
      "ids": "list<string>"
    },
    "ElementsDeleted": {
      "ids": "list<string>"
    },
    "ElementsUpdated": {
      "ids": "list<string>"
    },
    "LayerReordered": {},
    "MemberJoined": {
      "member": "string"
    },
    "MemberUsernameUpdated": {
      "member": "string"
    },
    "OwnerTransferred": {
      "member": "string"
    },
    "RoleUpdated": {
      "member": "string"
    }
  },
  "methods": {
    "addComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Pin a comment at a canvas point, or replace the comment with the same `id`\n(its replies are kept). Editors only; the author is the caller. Emits `CommentAdded`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "x",
          "i64"
        ],
        [
          "y",
          "i64"
        ],
        [
          "content",
          "string"
        ],
        [
          "createdAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "addElement": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Add an element, or replace the element with the same `id`. Editors only\n(`Forbidden`). `createdBy` is set by the contract. For an `image` or `svg`,\n`blobId` names a blob uploaded to this app. Answers the id. Emits `ElementAdded`.",
      "kind": "call",
      "params": [
        [
          "element",
          "Element"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "addElements": {
      "allowSystem": false,
      "confirm": false,
      "doc": "`addElement` for many elements in one call (a paste, an import): at most\n200, else `Invalid` and nothing is added. Editors only. Answers the ids in\norder. Emits one `ElementsAdded`.",
      "kind": "call",
      "params": [
        [
          "elements",
          "list<Element>"
        ]
      ],
      "public": false,
      "returns": "list<string>"
    },
    "addReply": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Reply to a comment. Editors only; the author is the caller. Does nothing if\nthe comment does not exist. Emits `CommentUpdated`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ],
        [
          "replyId",
          "string"
        ],
        [
          "content",
          "string"
        ],
        [
          "createdAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "bringToFront": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Paint an element above every other one. Editors only. Does nothing for an\nunknown id. Emits `LayerReordered`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "canEdit": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Whether the caller may change the canvas and comments.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "bool"
    },
    "clearComments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Delete every comment and reply, for every member. Board admin only\n(`Forbidden`). Emits no event, as in v1.",
      "kind": "call",
      "params": [],
      "public": false,
      "returns": null
    },
    "clearElements": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Delete every element, for every member. Board admin only (`Forbidden`).\nEmits `LayerReordered`.",
      "kind": "call",
      "params": [],
      "public": false,
      "returns": null
    },
    "deleteComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Delete a comment and its replies. Editors only. An unknown id is not an\nerror, and still emits `CommentDeleted`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteElement": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Delete an element. Editors only. An unknown id is not an error, and still\nemits `ElementDeleted`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteElements": {
      "allowSystem": false,
      "confirm": false,
      "doc": "`deleteElement` for many elements in one call: at most 200 ids, else\n`Invalid`. Editors only. Ids already gone are fine. Emits one `ElementsDeleted`.",
      "kind": "call",
      "params": [
        [
          "ids",
          "list<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteReply": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Delete one reply. Editors only. Does nothing, and emits nothing, if the\nreply is not there. Emits `CommentUpdated`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ],
        [
          "replyId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getBoard": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The board's name, description, element and member counts, and owner.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "BoardInfo"
    },
    "getComments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The comments, each with its replies oldest first: at most a page of\ncomments (1,000), each with at most a page of replies.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<Comment>"
    },
    "getCursors": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every pointer's last reported position: at most a page (1,000).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<CursorState>"
    },
    "getElement": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One element by id, or `null`.",
      "kind": "view",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<Element>"
    },
    "getElements": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The canvas in paint order, lowest `layerIndex` first: at most a page\n(1,000 elements). `getElementsPage` reads a larger board page by page.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<Element>"
    },
    "getElementsByIds": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Several elements by id in one read (the ids a batch event named): those that\nexist, in the order asked. At most 1,000 ids, else `Invalid`.",
      "kind": "view",
      "params": [
        [
          "ids",
          "list<string>"
        ]
      ],
      "public": false,
      "returns": "list<Element>"
    },
    "getElementsPage": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One page of the canvas in paint order. `cursor` is the previous page's\n`nextCursor` (`null` for the first page); `limit` 0 means 500, more than\n1,000 means 1,000. New: v1 returned the whole board from `getElements`.",
      "kind": "view",
      "params": [
        [
          "cursor",
          "option<string>"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "ElementPage"
    },
    "getMembers": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every member who has joined: at most a page (1,000), by account.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<Member>"
    },
    "getRole": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A member's effective role: `\"admin\"`, `\"editor\"` or `\"viewer\"`. Anything\nthat names nobody is a viewer.",
      "kind": "view",
      "params": [
        [
          "member",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "grantEditor": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Let a member change the canvas and comments. Admin only (`Forbidden`);\n`Invalid` when `member` is not an account of the app's organization (they\nneed not have joined the board yet). Emits `RoleUpdated`.",
      "kind": "call",
      "params": [
        [
          "member",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The empty board. The node runs it once, when the app is created; the app's\nowner becomes the board's owner and only admin. v1's `name` and\n`description` init arguments are gone: the board's name is the app\ninstance's, and the creator sets it on the board with `updateBoard`.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "join": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Add the caller to the board's members, so others see their name. Anyone who\nreaches the app may join; joining grants no editing. Does nothing, and emits\nnothing, if the caller has already joined (`updateMemberUsername` renames).",
      "kind": "call",
      "params": [
        [
          "username",
          "string"
        ],
        [
          "avatar",
          "option<string>"
        ],
        [
          "timestamp",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "listRoles": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every member who has joined, with their effective role: at most a page (1,000).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<MemberRole>"
    },
    "myRole": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's effective role.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "revokeEditor": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Take the editor role away. Admin only (`Forbidden`). An admin's own admin\nrole, and an org admin's editing, are unaffected. Emits `RoleUpdated`.",
      "kind": "call",
      "params": [
        [
          "member",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "sendToBack": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Paint an element below every other one. Editors only. Does nothing for an\nunknown id. Emits `LayerReordered`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setLayerIndex": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Move one element to a position in the paint order (0 at the back; past the\nend is clamped to the front). Only the elements whose index must change are\nwritten. Editors only. Does nothing if `id` names no element. Emits\n`LayerReordered`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "index",
          "u32"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "transferOwnership": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Hand the board to another account of the organization: it becomes owner and\nadmin, and the caller stops being admin (so loses editing unless also an\neditor). Owner only (`Forbidden`); `Invalid` when `newOwner` is not an\naccount of the app's organization. Emits `OwnerTransferred`.",
      "kind": "call",
      "params": [
        [
          "newOwner",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateBoard": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rename or re-describe the board; `null` keeps a field. Owner only\n(`Forbidden`). Emits `BoardUpdated`.",
      "kind": "call",
      "params": [
        [
          "name",
          "option<string>"
        ],
        [
          "description",
          "option<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateCursor": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Report the caller's pointer position to the other members. Open to everyone\nwho reaches the board, viewers included. One pointer per account (v1: per\ndevice). Emits `CursorMoved`.",
      "kind": "call",
      "params": [
        [
          "x",
          "i64"
        ],
        [
          "y",
          "i64"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateElement": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Move, resize or restyle an element; `null` leaves a field unchanged. Editors\nonly. Does nothing if `id` names no element. Emits `ElementUpdated`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "x",
          "option<i64>"
        ],
        [
          "y",
          "option<i64>"
        ],
        [
          "width",
          "option<u32>"
        ],
        [
          "height",
          "option<u32>"
        ],
        [
          "rotation",
          "option<i32>"
        ],
        [
          "fill",
          "option<string>"
        ],
        [
          "stroke",
          "option<string>"
        ],
        [
          "strokeWidth",
          "option<u32>"
        ],
        [
          "opacity",
          "option<u8>"
        ],
        [
          "cornerRadius",
          "option<u32>"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateElementLabel": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Set or clear an element's label (its layer name and group). Editors only.\nDoes nothing if `id` names no element. Emits `ElementUpdated`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "label",
          "option<string>"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateElementLabels": {
      "allowSystem": false,
      "confirm": false,
      "doc": "`updateElementLabel` for many elements in one call: at most 200, else\n`Invalid`. Editors only. Unknown ids are skipped. Emits one `ElementsUpdated`.",
      "kind": "call",
      "params": [
        [
          "labels",
          "list<LabelUpdate>"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateElements": {
      "allowSystem": false,
      "confirm": false,
      "doc": "`updateElement` for many elements in one call (a multi-select drag): at most\n200 patches, else `Invalid`. Editors only. Unknown ids are skipped. Emits one\n`ElementsUpdated` naming the ids that existed.",
      "kind": "call",
      "params": [
        [
          "patches",
          "list<ElementPatch>"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateMemberUsername": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Rename the caller's own member entry. Does nothing if the caller has not\njoined. Emits `MemberUsernameUpdated`.",
      "kind": "call",
      "params": [
        [
          "username",
          "string"
        ],
        [
          "timestamp",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateShadow": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Set or remove an element's drop shadow: all four fields are replaced, all\n`null` removes it. Editors only. Does nothing if `id` names no element.\nEmits `ElementUpdated`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "shadowColor",
          "option<string>"
        ],
        [
          "shadowOffsetX",
          "option<i32>"
        ],
        [
          "shadowOffsetY",
          "option<i32>"
        ],
        [
          "shadowBlur",
          "option<u32>"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "updateTextStyle": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Change a text element's content or style; `null` leaves a field unchanged.\nEditors only. Does nothing if `id` names no element; on an element that is\nnot text it changes only `updatedAt`. Emits `ElementUpdated`.",
      "kind": "call",
      "params": [
        [
          "id",
          "string"
        ],
        [
          "content",
          "option<string>"
        ],
        [
          "fontFamily",
          "option<string>"
        ],
        [
          "fontSize",
          "option<u32>"
        ],
        [
          "bold",
          "option<bool>"
        ],
        [
          "italic",
          "option<bool>"
        ],
        [
          "textAlign",
          "option<string>"
        ],
        [
          "verticalAlign",
          "option<string>"
        ],
        [
          "updatedAt",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
  "state": {
    "fields": {
      "admins": "set",
      "comments": "unorderedMap",
      "cursors": "unorderedMap",
      "description": "cell",
      "editors": "set",
      "elements": "unorderedMap",
      "layers": "set",
      "members": "unorderedMap",
      "name": "cell",
      "owner": "cell",
      "replies": "unorderedMap"
    },
    "search": {
      "admins": [],
      "comments": [],
      "cursors": [],
      "description": [],
      "editors": [],
      "elements": [],
      "layers": [],
      "members": [],
      "name": [],
      "owner": [],
      "replies": []
    },
    "version": 1
  },
  "types": {
    "BoardInfo": {
      "fields": [
        [
          "name",
          "string"
        ],
        [
          "description",
          "string"
        ],
        [
          "elementCount",
          "u32"
        ],
        [
          "memberCount",
          "u32"
        ],
        [
          "owner",
          "option<string>"
        ]
      ],
      "kind": "record"
    },
    "Comment": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "x",
          "i64_number"
        ],
        [
          "y",
          "i64_number"
        ],
        [
          "content",
          "string"
        ],
        [
          "author",
          "string"
        ],
        [
          "createdAt",
          "u64_number"
        ],
        [
          "replies",
          "list<CommentReply>",
          {
            "optional": true
          }
        ]
      ],
      "kind": "record"
    },
    "CommentReply": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "content",
          "string"
        ],
        [
          "author",
          "string"
        ],
        [
          "createdAt",
          "u64_number"
        ]
      ],
      "kind": "record"
    },
    "CursorState": {
