{
  "schema_version": "wasm-abi/1",
  "types": {
    "BoardInfo": {
      "kind": "record",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "elementCount",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "memberCount",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    },
    "Comment": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "replies",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "CommentReply"
            }
          },
          "doc": "Filled on read from `MeroDesign::replies`, and always stored empty: a\nreply is its own entry, so two replies posted at once both survive.\nKept in a `Vec` inside the comment they were whole-record LWW, and the\ncomment's clock never moved, so one of them was lost."
        }
      ]
    },
    "CommentReply": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "CursorState": {
      "kind": "record",
      "fields": [
        {
          "name": "identity",
          "type": {
            "kind": "string"
          },
          "doc": "The device this pointer belongs to — one per open window."
        },
        {
          "name": "account",
          "type": {
            "kind": "string"
          },
          "doc": "The member (account) behind that device, read from the entry's owner\nstamp, so the overlay can label the pointer with a username."
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Element": {
      "kind": "record",
      "doc": "`layer_index` is indexed, so the stack in order, and its top and bottom,\nare seeks rather than a scan and sort.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "data",
          "type": {
            "$ref": "ElementData"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "width",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "rotation",
          "type": {
            "kind": "i32"
          }
        },
        {
          "name": "fill",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "stroke",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "strokeWidth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "opacity",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "layerIndex",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "createdBy",
          "type": {
            "kind": "string"
          },
          "doc": "Set by the contract from the caller, never taken from the client."
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "shadowColor",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "shadowOffsetX",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "shadowOffsetY",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "shadowBlur",
          "type": {
            "kind": "u32"
          },
          "nullable": true
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "cornerRadius",
          "type": {
            "kind": "u32"
          },
          "nullable": true,
          "doc": "Corner radius in px, clamped by the client to min(width, height) / 2."
        }
      ]
    },
    "ElementData": {
      "kind": "variant",
      "variants": [
        {
          "name": "rect"
        },
        {
          "name": "circle"
        },
        {
          "name": "line",
          "payload": {
            "$ref": "ElementData_Line"
          },
          "doc": "`points` is \"x1,y1 x2,y2\" in element-local space. A bounding box cannot\nexpress which way a line was drawn, so a line drawn bottom-left to\ntop-right came back mirrored. Defaulted so pre-existing elements and older\nclients that send a bare `{\"kind\":\"line\"}` still deserialize."
        },
        {
          "name": "arrow",
          "payload": {
            "$ref": "ElementData_Arrow"
          }
        },
        {
          "name": "path",
          "payload": {
            "$ref": "ElementData_Path"
          }
        },
        {
          "name": "text",
          "payload": {
            "$ref": "ElementData_Text"
          }
        },
        {
          "name": "image",
          "payload": {
            "$ref": "ElementData_Image"
          }
        },
        {
          "name": "svg",
          "payload": {
            "$ref": "ElementData_Svg"
          }
        }
      ],
      "tag": "kind"
    },
    "ElementData_Arrow": {
      "kind": "record",
      "fields": [
        {
          "name": "points",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Image": {
      "kind": "record",
      "fields": [
        {
          "name": "naturalWidth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "naturalHeight",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "blobId",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Line": {
      "kind": "record",
      "fields": [
        {
          "name": "points",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Path": {
      "kind": "record",
      "fields": [
        {
          "name": "points",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Svg": {
      "kind": "record",
      "fields": [
        {
          "name": "naturalWidth",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "naturalHeight",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "blobId",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ElementData_Text": {
      "kind": "record",
      "fields": [
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "fontSize",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "fontFamily",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bold",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "italic",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "text_align",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "vertical_align",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    },
    "ElementPatch": {
      "kind": "record",
      "doc": "One element's share of an `update_elements` call. Field names and meaning\nmatch `update_element`'s arguments: `None` leaves a field alone.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          },
          "nullable": true
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          },
          "nullable": true
        },
        {
          "name": "width",
          "type": {
            "kind": "u32"
          },
          "nullable": true
        },
        {
          "name": "height",
          "type": {
            "kind": "u32"
          },
          "nullable": true
        },
        {
          "name": "rotation",
          "type": {
            "kind": "i32"
          },
          "nullable": true
        },
        {
          "name": "fill",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "stroke",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "stroke_width",
          "type": {
            "kind": "u32"
          },
          "nullable": true
        },
        {
          "name": "opacity",
          "type": {
            "kind": "u32"
          },
          "nullable": true
        },
        {
          "name": "corner_radius",
          "type": {
            "kind": "u32"
          },
          "nullable": true
        }
      ]
    },
    "LabelUpdate": {
      "kind": "record",
      "doc": "One element's share of an `update_element_labels` call.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "label",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    },
    "Member": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "username",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "avatar",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "joinedAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "usernameUpdatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "Dedicated LWW clock for username/avatar edits. Merging on `joined_at`\n(which never changes after the first join) would freeze a member's\nusername at its first value across nodes; this field is the real\nlast-writer-wins timestamp for profile edits."
        }
      ]
    },
    "MemberRole": {
      "kind": "record",
      "doc": "A member paired with their effective role, for the settings/members UI.\n\nA member id IS an account (see [`MeroDesign::caller_id`]), so `account`\nalways equals `member`. It stays in the shape because it is what the\nsettings UI joins `/groups/{id}/members` rows on.",
      "fields": [
        {
          "name": "member",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "role",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "account",
          "type": {
            "kind": "string"
          },
          "nullable": true
        }
      ]
    },
    "MeroDesign": {
      "kind": "record",
      "fields": [
        {
          "name": "board_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          }
        },
        {
          "name": "board_description",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          }
        },
        {
          "name": "initial_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "initial_description",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "elements",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Element"
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "The canvas. Writer-set guarded: only accounts holding a role mask\nprojected from `roles` (editors, admins) may write an entry, on every\nnode."
        },
        {
          "name": "members",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Member"
            }
          },
          "doc": "One slot per account, written only by that account."
        },
        {
          "name": "comments",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "Comment"
              },
              "crdt_type": "unordered_map"
            }
          },
          "doc": "Guarded like `elements`."
        },
        {
          "name": "replies",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "map",
              "key": {
                "kind": "string"
              },
              "value": {
                "$ref": "CommentReply"
              },
              "crdt_type": "sorted_map"
            }
          },
          "doc": "Every reply, keyed `\"<comment>/<created_at:020>/<reply>\"` so one\ncomment's thread is a prefix slice in order. Guarded like `elements`."
        },
        {
          "name": "cursors",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CursorState"
            },
            "crdt_type": "authored_map"
          },
          "doc": "Keyed by DEVICE: a pointer belongs to a screen. Each entry is owned by\nthe account that wrote it."
        },
        {
          "name": "roles",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          }
        }
      ]
    }
  },
  "methods": [
    {
      "name": "add_comment",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i64"
          }
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "add_element",
      "params": [
        {
          "name": "element",
          "type": {
            "$ref": "Element"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "add_elements",
      "doc": "`add_element` for a whole selection — a paste, an import, a batch of\nrerouted connectors. An id that already exists is overwritten, exactly as\n`add_element` does. At most `MAX_BATCH` elements.",
      "params": [
        {
          "name": "elements",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Element"
            }
          }
        }
      ],
      "returns": {
        "kind": "list",
        "items": {
          "kind": "string"
        }
      },
      "intent": "mutating"
    },
    {
      "name": "add_reply",
      "doc": "Reply to a comment. The reply is its own entry, so concurrent replies to\none comment all survive.",
      "params": [
        {
          "name": "comment_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reply_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "content",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "bring_to_front",
      "doc": "The top of the stack is one seek on the `layer_index` index.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "can_edit",
      "doc": "Whether the caller may edit the canvas.",
      "params": [],
      "returns": {
        "kind": "bool"
      },
      "intent": "read_only"
    },
    {
      "name": "clear_comments",
      "params": [],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "clear_elements",
      "params": [],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_comment",
      "doc": "Delete a comment and its thread.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_element",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_elements",
      "doc": "`delete_element` for a whole selection. Ids that are already gone are\nfine — a peer may have deleted them first. At most `MAX_BATCH` ids.",
      "params": [
        {
          "name": "ids",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_reply",
      "params": [
        {
          "name": "comment_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reply_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "get_board",
      "params": [],
      "returns": {
        "$ref": "BoardInfo"
      },
      "intent": "read_only"
    },
    {
      "name": "get_comments",
      "doc": "Every comment, each with its thread in reply order — one prefix slice\nof `replies` per comment.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "Comment"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_cursors",
      "doc": "Every pointer, labelled with the account on its owner stamp.\n\n`entries_with_owners`, not a key-only `owner_of`: keys are per owner,\nso `owner_of` would only ever name the caller.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "CursorState"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_element",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "Element"
      },
      "returns_nullable": true,
      "intent": "read_only"
    },
    {
      "name": "get_elements",
      "doc": "Every element, bottom to top: the `layer_index` index already holds\nthem in that order.",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "Element"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_elements_by_ids",
      "doc": "The elements a batch event named, in one read instead of one\n`get_element` each. Ids that no longer exist are left out.",
      "params": [
        {
          "name": "ids",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        }
      ],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "Element"
        }
