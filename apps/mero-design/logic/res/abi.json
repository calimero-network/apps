          "u32"
        ],
        [
          "height",
          "u32"
        ],
        [
          "rotation",
          "i32"
        ],
        [
          "fill",
          "string"
        ],
        [
          "stroke",
          "string"
        ],
        [
          "strokeWidth",
          "u32"
        ],
        [
          "opacity",
          "u8"
        ],
        [
          "layerIndex",
