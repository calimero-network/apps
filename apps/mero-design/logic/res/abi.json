        ],
        [
          "createdBy",
          "string"
        ],
        [
          "createdAt",
          "u64_number"
        ],
        [
          "updatedAt",
          "u64_number"
        ],
        [
          "shadowColor",
          "option<string>"
        ],
        [
          "shadowOffsetX",
          "option<i32>"
        ],
        [
          "shadowOffsetY",
          "option<i32>"
        ],
        [
          "shadowBlur",
          "option<u32>"
        ],
        [
