    "ElementData": {
      "kind": "enum",
      "tag": "kind",
      "variants": [
        {
          "name": "rect"
        },
        {
          "name": "circle"
        },
        {
          "fields": [
            [
              "points",
              "string",
              {
                "optional": true
              }
            ]
          ],
          "name": "line"
        },
        {
          "fields": [
            [
              "points",
              "string",
              {
                "optional": true
              }
            ]
          ],
          "name": "arrow"
        },
        {
          "fields": [
            [
              "points",
              "string"
            ]
          ],
          "name": "path"
        },
        {
          "fields": [
            [
              "content",
              "string"
            ],
            [
              "fontSize",
              "u32"
            ],
            [
              "fontFamily",
              "string"
            ],
            [
              "bold",
              "bool"
            ],
            [
              "italic",
              "bool"
            ],
            [
              "text_align",
              "option<string>",
              {
                "optional": true
              }
            ],
            [
              "vertical_align",
              "option<string>",
              {
                "optional": true
              }
            ]
          ],
          "name": "text"
        },
        {
          "fields": [
            [
              "naturalWidth",
              "u32"
            ],
            [
              "naturalHeight",
              "u32"
            ],
            [
              "blobId",
              "string",
              {
                "optional": true
              }
            ]
          ],
          "name": "image"
