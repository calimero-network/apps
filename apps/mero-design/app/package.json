{
  "name": "mero-design",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "description": "MeroDesign \u2014 collaborative design tool on Calimero",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e": "playwright test --project=mocked --project=tauri",
    "e2e:ui": "playwright test --ui --project=mocked",
    "test:all": "vitest run && node scripts/task-status.mjs --check && playwright test --project=mocked --project=tauri",
    "e2e:web": "playwright test --project=mocked",
    "e2e:tauri": "playwright test --project=tauri",
    "starter": "node scripts/build-starter.mjs",
    "tasks": "node scripts/task-status.mjs"
  },
  "dependencies": {
    "@calimero-network/mero-js": "catalog:",
    "@calimero-network/mero-platform": "catalog:",
    "@calimero-network/mero-react": "catalog:",
    "@calimero-network/mero-ui": "catalog:",
    "axios": "catalog:",
    "bs58": "catalog:",
    "clsx": "catalog:",
    "fabric": "^7.4.0",
    "fflate": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "uuid": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/uuid": "catalog:",
    "@vitejs/plugin-react-swc": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "^28.1.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
