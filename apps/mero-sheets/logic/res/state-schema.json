{
  "schema_version": "wasm-abi/1",
  "types": {
    "ActivityData": {
      "kind": "record",
      "doc": "One entry of the workbook's activity log: what was done, when. Keyed by\n`\"{at:020}|{author}|{nonce}\"`; its author is the entry's owner stamp, and a\n\"since\" query is a seek on the `at` index.",
      "fields": [
        {
          "name": "at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          },
          "doc": "Empty for workbook-level actions (a named range)."
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "`cells`, `rows`, `cols`, `sheet` or `name`."
        },
        {
          "name": "summary",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "count",
          "type": {
            "kind": "u32"
          },
          "doc": "How many cells changed; `changes` holds at most [`MAX_LOGGED_CHANGES`]."
        },
        {
          "name": "changes",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "CellChange"
            }
          }
        }
      ]
    },
    "AlertState": {
      "kind": "record",
      "doc": "Which cells of an alert rule met its condition when last checked, so it\ntells only about cells that start meeting it. Keyed by rule id.",
      "fields": [
        {
          "name": "cells",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "AttachmentData": {
      "kind": "record",
      "doc": "A file attached to a cell. The bytes are a blob in the node's blob store,\nannounced to this context so members' nodes can fetch it; this is its\nrecord. Keyed by id, owned by whoever attached it (`attachments`).",
      "fields": [
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "blob_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "mime",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "AxisData": {
      "kind": "record",
      "doc": "One row or column added to a sheet, or one deleted. Keyed by\n`\"{sheet_id}|r|{id}\"` / `\"{sheet_id}|c|{id}\"`; see the recalc crate's\n`layout` module for how entries order a sheet.",
      "fields": [
        {
          "name": "pos",
          "type": {
            "kind": "string"
          },
          "doc": "Fractional position: decimal digits, compared as strings."
        },
        {
          "name": "deleted",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "CellChange": {
      "kind": "record",
      "doc": "One cell's change within an activity entry: its raw value and format\nbefore and after.",
      "fields": [
        {
          "name": "row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "before_raw",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "before_format",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "after_raw",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "after_format",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "CellData": {
      "kind": "record",
      "doc": "A cell's value, stored in the shared UnorderedMap under\n`\"{sheet_id}|{row_id}|{col_id}\"`. Its format is a separate field\n(`formats`), so a value edit and a format edit never overwrite each other.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          },
          "doc": "Mirrors the map key for ABI convenience."
        },
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "raw_value",
          "type": {
            "kind": "string"
          },
          "doc": "Raw user input (may be a formula like `=SUM(A1:A5)`)."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "CellMeta": {
      "kind": "record",
      "doc": "Who last changed a cell and when, keyed like the cell.",
      "fields": [
        {
          "name": "author",
          "type": {
            "kind": "string"
          },
          "doc": "Member id (`whoami`)."
        },
        {
          "name": "at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "ChartData": {
      "kind": "record",
      "doc": "A chart of a range, anchored on corner row and column ids. Keyed by id.",
      "fields": [
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "top_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "left_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bottom_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "right_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "`bar` or `line`."
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "deleted",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "CommentData": {
      "kind": "record",
      "doc": "A comment on a cell, or a reply to one. Keyed by comment id, owned by its\nauthor (`comments`). Whether its thread is resolved is kept apart\n(`resolved`), since anyone may resolve and only the author edits.",
      "fields": [
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "text",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "mentions",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Member ids named with `@nickname` in the text."
        },
        {
          "name": "parent",
          "type": {
            "kind": "string"
          },
          "doc": "The comment this replies to; empty for a thread's first comment."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "FormatData": {
      "kind": "record",
      "doc": "A cell's display format, kept apart from its value so that formatting a\ncell and typing in it at the same moment both survive. Keyed like the cell.",
      "fields": [
        {
          "name": "format",
          "type": {
            "kind": "string"
          },
          "doc": "Empty means Automatic, and overrides a format the cell carried from v1."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Founding": {
      "kind": "record",
      "doc": "What a workbook is from the moment it exists: its id and creation time,\nfixed in `init` and changeable by nobody (`founding`).",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "LinkedData": {
      "kind": "record",
      "doc": "A range pushed here from another workbook (the receiving side of a link),\nshown as a read-only sheet whose id is the key. Values are row-major.",
      "fields": [
        {
          "name": "source_context",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "rows",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "cols",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "values",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "blocked",
          "type": {
            "kind": "bool"
          },
          "doc": "Removed here: later pushes are ignored."
        },
        {
          "name": "deleted",
          "type": {
            "kind": "bool"
          },
          "doc": "Withdrawn by the source."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "MemberData": {
      "kind": "record",
      "doc": "A collaborator's chosen nickname, in their account's own slot (`members`),\nso only they can set it.\n\nThis exists because the only thing the app could previously put next to a\ncursor was a raw 64-hex device key, which answers no question anyone has.\nA nickname has to live HERE and not in `localStorage`: localStorage is\nper-browser, so a name kept there is visible to exactly the one person who\ndoes not need it.",
      "fields": [
        {
          "name": "nickname",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "joined_at",
          "type": {
            "kind": "u64"
          },
          "doc": "First time this member announced themselves. Earliest wins on merge — a\nlater rename must not look like a later arrival."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "NamedRangeData": {
      "kind": "record",
      "doc": "A named range: a name that formulas can use in place of a reference.\nKeyed by the upper-case name; an empty target means deleted (a removed key\nwould tombstone the name and block defining it again).",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          },
          "doc": "The name as it was typed, for display."
        },
        {
          "name": "target",
          "type": {
            "kind": "string"
          },
          "doc": "A reference in stored form (`[sheet-id]!A1:B9`)."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "ProtectionData": {
      "kind": "record",
      "doc": "A protected range: only owners and the listed editors may change its cells.\nCorners are row and column ids, so the range follows its cells as rows and\ncolumns move; all four empty protects the whole sheet. Keyed by id.",
      "fields": [
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "top_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "left_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bottom_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "right_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "editors",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Member ids allowed to edit it besides owners."
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "deleted",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "PublicationData": {
      "kind": "record",
      "doc": "A range this workbook pushes to another workbook in the workspace (the\nsource side of a link). Keyed by id, owned by whoever linked it.",
      "fields": [
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "top_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "left_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bottom_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "right_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "target_context",
          "type": {
            "kind": "string"
          },
          "doc": "The receiving workbook's context id, hex."
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          },
          "doc": "What the linked sheet is called there."
        }
      ]
    },
    "RuleData": {
      "kind": "record",
      "doc": "A conditional format, colour scale or validation over a range, anchored on\ncorner row and column ids like a protected range. Keyed by id.",
      "fields": [
        {
          "name": "sheet_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "top_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "left_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "bottom_row_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "right_col_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "`format`, `scale` or `validate`."
        },
        {
          "name": "condition",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "args",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "style",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "StylePair"
            }
          },
          "doc": "The style a matching `format` rule applies, as (field, value) pairs."
        },
        {
          "name": "strict",
          "type": {
            "kind": "bool"
          },
          "doc": "A `validate` rule that refuses values instead of marking them."
        },
        {
          "name": "recipients",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Who an `alert` rule tells (member ids)."
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "deleted",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "SheetData": {
      "kind": "record",
      "doc": "A sheet tab stored in the shared UnorderedMap.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "position",
          "type": {
            "kind": "u32"
          },
          "doc": "Tab ordering hint (lower = further left)."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          },
          "doc": "Timestamp of the last rename — used for LWW name merge."
        }
      ]
    },
    "SheetViewData": {
      "kind": "record",
      "doc": "How a sheet is shown: its frozen rows and columns. Keyed by sheet id.",
      "fields": [
        {
          "name": "frozen_rows",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "frozen_cols",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "SizeData": {
      "kind": "record",
      "doc": "A resized row or column. Keyed `\"{sheet_id}|r|{id}\"` or `\"{sheet_id}|c|{id}\"`.",
      "fields": [
        {
          "name": "size",
          "type": {
            "kind": "u32"
          },
          "doc": "Pixels."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Span": {
      "kind": "record",
      "fields": [
        {
          "name": "text",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "attributes",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "string"
            }
          }
        }
      ]
    },
    "Spreadsheet": {
      "kind": "record",
      "fields": [
        {
          "name": "founding",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "$ref": "Founding"
            }
          },
          "doc": "The workbook's id and creation time, fixed in `init`."
        },
        {
          "name": "project_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          },
          "doc": "The workbook's name, set by `init_project`; empty until then. Only\nowners write it."
        },
        {
          "name": "acl",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          },
          "doc": "Workbook roles. Its admins are the owners; `viewer` and `commenter`\nare named roles. A member with neither and not an owner is an editor."
        },
        {
          "name": "sheets",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "SheetData"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Sheet tabs keyed by sheet id."
        },
        {
          "name": "cells",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CellData"
            },
            "crdt_type": "sorted_map"
          },
          "doc": "Cell values keyed by `\"{sheet_id}|{row_id}|{col_id}\"`, so one sheet's\ncells are one prefix."
        },
        {
          "name": "members",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "MemberData"
            }
          },
          "doc": "Chosen nicknames, one slot per account that only it writes."
        },
        {
          "name": "axes",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "AxisData"
            },
            "crdt_type": "sorted_map"
          },
          "doc": "Added and deleted rows and columns, keyed `\"{sheet_id}|r|{id}\"` and\n`\"{sheet_id}|c|{id}\"`."
        },
        {
          "name": "formats",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "FormatData"
            },
            "crdt_type": "sorted_map"
          },
          "doc": "Cell formats, keyed like `cells`."
        },
        {
          "name": "names",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "NamedRangeData"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Named ranges keyed by upper-case name."
        },
        {
          "name": "cell_meta",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CellMeta"
            },
            "crdt_type": "sorted_map"
          },
          "doc": "Who last changed each cell, keyed like `cells`."
        },
        {
          "name": "activity",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "ActivityData"
            },
            "crdt_type": "authored_map"
          },
          "doc": "The activity log: each entry owned by its author and never changed."
        },
        {
          "name": "comments",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CommentData"
            },
            "crdt_type": "authored_map"
          },
