{
  "schema_version": "wasm-abi/1",
  "types": {
    "Action": {
      "kind": "record",
      "doc": "One thing your agent did, or wants to do, on your behalf.\n\nEverything but `history` and `reviewed` is written once. `history` merges as\na union of steps, and `reviewed` only ever turns on.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_context",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "method",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "category",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "writes",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "undoable",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "why",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "intent_hash",
          "type": {
            "kind": "string"
          },
          "doc": "Hex `H(method ‖ args)` from the warrant. The arguments themselves never\nleave the agent: this is enough to match the feed row to the delta."
        },
        {
          "name": "executor",
          "type": {
            "kind": "string"
          },
          "doc": "The relay account that executed the warrant, as the agent was told."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "chain",
          "type": {
            "kind": "string"
          },
          "doc": "The chain this belongs to: the id of the row that started it."
        },
        {
          "name": "ask",
          "type": {
            "$ref": "Ask"
          }
        },
        {
          "name": "breach",
          "type": {
            "kind": "string"
          },
          "doc": "Why the rules say this needed you, when the agent acted anyway. Empty\nwhen it did not."
        },
        {
          "name": "reviewed",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "reviewed_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "history",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Step"
            }
          }
        }
      ]
    },
    "AgentState": {
      "kind": "record",
      "doc": "The agent's global switch, stored under the single key `\"main\"`.",
      "fields": [
        {
          "name": "paused",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Answers": {
      "kind": "record",
      "doc": "The question of your agent's that one of your messages answers, when you\nanswered it from its buttons. Kept beside your message by its id.",
      "fields": [
        {
          "name": "ask",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Archived": {
      "kind": "record",
      "doc": "A chain you put away. It stays out of the feed until something new\nhappens in it, or until `until` passes (\"later\"); `until` 0 has no return\ntime. Unarchiving keeps the row with `archived: false`, so the latest\ndecision wins on every device.",
      "fields": [
        {
          "name": "archived",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "at",
          "type": {
            "kind": "u64"
          },
          "doc": "The chain's latest activity when it was put away: anything newer brings it back."
        },
        {
          "name": "until",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Ask": {
      "kind": "record",
      "doc": "How a row is best resolved in place. See [`ASK_KINDS`].",
      "fields": [
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "`\"\"`, `confirm`, `reply` or `choose`."
        },
        {
          "name": "prompt",
          "type": {
            "kind": "string"
          },
          "doc": "What the control says: \"Reply in #launch\", \"Pick a slot\", \"Join the call\"."
        },
        {
          "name": "options",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "`choose`: the options (2 to 8). `reply`: suggested quick replies (up to 8)."
        },
        {
          "name": "draft",
          "type": {
            "kind": "string"
          },
          "doc": "`reply`: a draft to start from, e.g. the agent's proposed text."
        }
      ]
    },
    "Asked": {
      "kind": "record",
      "doc": "What your agent asked you in a message, kept beside it by the message's\nid, so messages written before agents could ask keep their layout.",
      "fields": [
        {
          "name": "ask",
          "type": {
            "$ref": "Ask"
          }
        }
      ]
    },
    "Attachment": {
      "kind": "record",
      "doc": "An image on a message: a blob on your node, announced to the feed's\ncontext, and what the client needs to show it before fetching it.",
      "fields": [
        {
          "name": "blob_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          },
          "doc": "The file's name as you picked it; may be empty for a pasted image."
        },
        {
          "name": "mime",
          "type": {
            "kind": "string"
          },
          "doc": "One of [`IMAGE_TYPES`]."
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          },
          "doc": "Bytes, at most 10 MiB."
        }
      ]
    },
    "Attachments": {
      "kind": "record",
      "doc": "A message's attachments. Kept beside the message, keyed by its id, so\nmessages written before attachments existed keep their layout.",
      "fields": [
        {
          "name": "items",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Attachment"
            }
          }
        }
      ]
    },
    "Checkpoint": {
      "kind": "record",
      "doc": "The latest checkpoint on one chain, kept by chain id. A new one replaces\nit whole: last writer wins.",
      "fields": [
        {
          "name": "done",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "next",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "branches",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "worktrees",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "prs",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "questions",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "author",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Guard": {
      "kind": "record",
      "doc": "One \"always ask me before\" switch.",
      "fields": [
        {
          "name": "category",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "enabled",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Headline": {
      "kind": "record",
      "doc": "A message's headline: one line for the feed row, its text behind \"more\".\nKept beside the message, keyed by its id, so messages written before\nheadlines keep their layout.",
      "fields": [
        {
          "name": "text",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Hyperfeed": {
      "kind": "record",
      "fields": [
        {
          "name": "owner",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          },
          "doc": "The account that created the feed; the only one that writes to it."
        },
        {
          "name": "actions",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Action"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "notifications",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Notification"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "policies",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Policy"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "guards",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Guard"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "agent",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "AgentState"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "messages",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Message"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "typed",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Typed"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "What a lens made of a notification, by the notification's id."
        },
        {
          "name": "lenses",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Lens"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "How each app version's events become feed items, by `<app>@<application id>`."
        },
        {
          "name": "archived",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Archived"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Chains you put away, by chain id."
        },
        {
          "name": "presence",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Presence"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Agents that report in, by name."
        },
        {
          "name": "asks",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Asked"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "What your agent asked you, by its message's id."
        },
        {
          "name": "progress",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Progress"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Your agent's latest step on each message it is working on, by message id."
        },
        {
          "name": "attachments",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Attachments"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Images on your messages, by the message's id."
        },
        {
          "name": "work",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Work"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Your agent's turn on each of your messages it worked on, by message id."
        },
        {
          "name": "stops",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "StopRequest"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Your requests to stop a turn, by message id."
        },
        {
          "name": "headlines",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Headline"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Headlines of messages written with one, by the message's id."
        },
        {
          "name": "superseded",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Superseded"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Questions a newer one in their chain replaced, by the question's id."
        },
        {
          "name": "answers",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Answers"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "The question each of your messages sent from its buttons answers, by\nyour message's id."
        },
        {
          "name": "leases",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Lease"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Which agent session works on each chain, by chain id."
        },
        {
          "name": "watches",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Watch"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "\"When X, do Y\", polled by your agent's runtime, by id. See [`watches`]."
        },
        {
          "name": "rules",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Rule"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Your standing rules, by id."
        },
        {
          "name": "rule_proposals",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "RuleProposal"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Rules your agent suggested, by id."
        },
        {
          "name": "checkpoints",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Checkpoint"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "Where each task stands, as your agent last wrote it, by chain id."
        },
        {
          "name": "prs",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "PrSeen"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "The PRs your tasks link to, as your agent's runtime last saw them on\nGitHub, by `owner/name#number`. See [`prs`]."
        }
      ]
    },
    "Lease": {
      "kind": "record",
      "doc": "Which agent session is working on a chain, until when. A session claims a\nchain before it starts a turn there, renews the lease while it works, and\nreleases it at the end; another session is refused the chain until then,\nor until the lease runs out (the session died). Kept by chain id.",
      "fields": [
        {
          "name": "session",
          "type": {
            "kind": "string"
          },
          "doc": "The session's own id: unique per running agent process."
        },
        {
          "name": "agent",
          "type": {
            "kind": "string"
          },
          "doc": "Who it is, in words: \"mero-bot@studio\"."
        },
        {
          "name": "claimed_at",
          "type": {
            "kind": "u64"
          },
          "doc": "When this session took the chain; kept while it renews."
        },
        {
          "name": "expires_at",
          "type": {
            "kind": "u64"
          },
          "doc": "When the lease runs out; 0 once released."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Lens": {
      "kind": "record",
      "doc": "How one app version's events become feed items, as your agent learned it\nfrom the app's ABI. Nothing uses a lens until you approve it.",
      "fields": [
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "application_id",
          "type": {
            "kind": "string"
          },
          "doc": "The app version it was learned from: a new version is learned again."
        },
        {
          "name": "spec",
          "type": {
            "kind": "string"
          },
          "doc": "The lens itself, JSON (see the app's `lens` module)."
        },
        {
          "name": "summary",
          "type": {
            "kind": "string"
          },
          "doc": "One line for you: what it records and how it answers."
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          },
          "doc": "[`LENS_PROPOSED`], [`LENS_APPROVED`] or [`LENS_REJECTED`]."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Message": {
      "kind": "record",
      "doc": "One message in a conversation with your agent, inside a chain.\n\nYou talk to your agent about a row by posting into its chain; a question\nasked from nowhere starts a chain of its own. The agent's answers, and\nanything it proposes or does because of them, land in the same chain.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "chain",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "from",
          "type": {
            "kind": "string"
          },
          "doc": "[`FROM_YOU`] or [`FROM_AGENT`]."
        },
        {
          "name": "text",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reply_to",
          "type": {
            "kind": "string"
          },
          "doc": "The message of yours this answers; empty for yours, and for an agent\nmessage nobody asked for."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "history",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Step"
            }
          }
        }
      ]
    },
    "Notification": {
      "kind": "record",
      "doc": "One notification an app sent you, as your client saw it.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          },
          "doc": "The dedupe key the client derived from the source event."
        },
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_context",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "from",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "event",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "needs_you",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "chain",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "ask",
          "type": {
            "$ref": "Ask"
          }
        },
        {
          "name": "seen",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "seen_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "history",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Step"
            }
          },
          "doc": "`received`, then `answered` (your answer as the note), then\n`delivered` or `failed` (the agent's note)."
        }
      ]
    },
    "Policy": {
      "kind": "record",
      "doc": "Your rules for one app.",
      "fields": [
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "agent",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "notifications",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "PrSeen": {
      "kind": "record",
      "doc": "One PR as the runtime last saw it, kept by `owner/name#number`.",
      "fields": [
        {
          "name": "chain",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "repo",
          "type": {
            "kind": "string"
          }
        },
