          "name": "category",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "why",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "intent_hash",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "executor",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "undoable",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "breach",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reviewed_at",
          "type": {
            "kind": "u64"
          },
