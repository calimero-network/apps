            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Policy"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "guards",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Guard"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "agent",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "AgentState"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "messages",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Message"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "typed",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Typed"
            },
            "crdt_type": "unordered_map"
          },
