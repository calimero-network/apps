    "Message": {
      "kind": "record",
      "doc": "One message in a conversation with your agent, inside a chain.\n\nYou talk to your agent about a row by posting into its chain; a question\nasked from nowhere starts a chain of its own. The agent's answers, and\nanything it proposes or does because of them, land in the same chain.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "chain",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "from",
          "type": {
            "kind": "string"
          },
          "doc": "[`FROM_YOU`] or [`FROM_AGENT`]."
        },
        {
          "name": "text",
          "type": {
            "kind": "string"
          }
        },
        {
