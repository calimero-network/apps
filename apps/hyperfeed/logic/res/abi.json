          "type": {
            "kind": "string"
          }
        },
        {
          "name": "summary",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
