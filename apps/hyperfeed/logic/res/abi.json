    "GuardView": {
      "kind": "record",
      "fields": [
        {
          "name": "category",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "enabled",
          "type": {
            "kind": "bool"
          }
        }
      ]
    },
    "Hyperfeed": {
      "kind": "record",
      "fields": [
        {
          "name": "owner",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
