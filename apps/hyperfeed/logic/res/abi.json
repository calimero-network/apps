    "Event_ArchiveChanged": {
      "kind": "record",
      "fields": [
        {
          "name": "count",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "Event_LensChanged": {
      "kind": "record",
      "fields": [
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_MessageChanged": {
