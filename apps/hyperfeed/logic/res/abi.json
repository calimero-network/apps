        {
          "name": "spec",
          "type": {
            "kind": "string"
          },
          "doc": "The lens itself, JSON (see the app's `lens` module)."
        },
        {
          "name": "summary",
          "type": {
            "kind": "string"
          },
          "doc": "One line for you: what it records and how it answers."
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          },
          "doc": "[`LENS_PROPOSED`], [`LENS_APPROVED`] or [`LENS_REJECTED`]."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
