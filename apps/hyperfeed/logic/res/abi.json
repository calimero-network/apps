{
  "schema_version": "wasm-abi/1",
  "types": {
    "Action": {
      "kind": "record",
      "doc": "One thing your agent did, or wants to do, on your behalf.\n\nEverything but `history` and `reviewed` is written once. `history` merges as\na union of steps, and `reviewed` only ever turns on.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_context",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "method",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "category",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "writes",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "undoable",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "why",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "intent_hash",
          "type": {
            "kind": "string"
          },
          "doc": "Hex `H(method ‖ args)` from the warrant. The arguments themselves never\nleave the agent: this is enough to match the feed row to the delta."
        },
        {
          "name": "executor",
          "type": {
            "kind": "string"
          },
          "doc": "The relay account that executed the warrant, as the agent was told."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "chain",
          "type": {
            "kind": "string"
          },
          "doc": "The chain this belongs to: the id of the row that started it."
        },
        {
          "name": "ask",
          "type": {
            "$ref": "Ask"
          }
        },
        {
          "name": "breach",
          "type": {
            "kind": "string"
          },
          "doc": "Why the rules say this needed you, when the agent acted anyway. Empty\nwhen it did not."
        },
        {
          "name": "reviewed",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "reviewed_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "history",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Step"
            }
          }
        }
      ]
    },
    "ActionInput": {
      "kind": "record",
      "doc": "What the agent reports for one action.",
      "fields": [
        {
          "name": "app",
          "type": {
            "kind": "string"
          },
          "doc": "Short app key, e.g. `chat`, `sign`, `crm`. Policies are keyed by it."
        },
        {
          "name": "source_context",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "method",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "category",
          "type": {
            "kind": "string"
          },
          "doc": "One of the guard categories, or empty for none."
        },
        {
          "name": "writes",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "undoable",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "why",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "outcome",
          "type": {
            "kind": "string"
          },
          "doc": "`proposed`, `done` or `failed`."
        },
        {
          "name": "intent_hash",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "executor",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "note",
          "type": {
            "kind": "string"
          },
          "doc": "What went wrong, for a `failed` outcome."
        },
        {
          "name": "chain",
          "type": {
            "kind": "string"
          },
          "doc": "The chain this continues: the id of the row that led to it (a\nnotification, or an earlier action). Empty starts a chain of its own."
        },
        {
          "name": "ask",
          "type": {
            "$ref": "Ask"
          },
          "doc": "For a proposal: how you resolve it, beyond approve or decline. A\n`choose` lets you approve with one of the options; a `reply` lets you\nedit the agent's draft before it goes."
        }
      ]
    },
    "AgentState": {
      "kind": "record",
      "doc": "The agent's global switch, stored under the single key `\"main\"`.",
      "fields": [
        {
          "name": "paused",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "AppCount": {
      "kind": "record",
      "fields": [
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "count",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "Ask": {
      "kind": "record",
      "doc": "How a row is best resolved in place. See [`ASK_KINDS`].",
      "fields": [
        {
          "name": "kind",
          "type": {
            "kind": "string"
          },
          "doc": "`\"\"`, `confirm`, `reply` or `choose`."
        },
        {
          "name": "prompt",
          "type": {
            "kind": "string"
          },
          "doc": "What the control says: \"Reply in #launch\", \"Pick a slot\", \"Join the call\"."
        },
        {
          "name": "options",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "`choose`: the options (2 to 8). `reply`: suggested quick replies (up to 8)."
        },
        {
          "name": "draft",
          "type": {
            "kind": "string"
          },
          "doc": "`reply`: a draft to start from, e.g. the agent's proposed text."
        }
      ]
    },
