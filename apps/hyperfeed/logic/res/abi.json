    {
      "name": "feed",
      "doc": "The feed: one row per chain, newest activity first.\n\nA row is the chain's **lead**: the latest step that needs you if any\ndoes, otherwise the latest row. Its `chain_len` says how many rows the\nchain holds and `needs_you` whether any of them needs you; read them all\nwith [`Hyperfeed::chain`].\n\n`filter` keeps chains holding an action (`agent`), a notification\n(`notifications`), or something that needs you (`needs_you`); `app_key`\nkeeps chains that touch that app; `before` pages by `chain_at` (0 = from\nthe newest). The counts are over chains, for the whole feed.",
      "params": [
        {
          "name": "filter",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "app_key",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "limit",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "before",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "$ref": "FeedPage"
      },
      "intent": "read_only"
    },
