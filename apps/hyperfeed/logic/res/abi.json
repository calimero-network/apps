          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "kind",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "chain",
          "type": {
            "kind": "string"
          },
          "doc": "The chain it belongs to, how many rows the chain has, and when anything\nin it last happened (what the feed is ordered and paged by)."
        },
        {
          "name": "chain_len",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "chain_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "app",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_context",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "source_label",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "body",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "needs_you",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          },
