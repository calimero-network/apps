          }
        },
        {
          "name": "status",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_NotificationRecorded": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_NotificationsSeen": {
      "kind": "record",
      "fields": [
        {
          "name": "count",
          "type": {
            "kind": "u32"
          }
        }
