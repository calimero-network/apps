        {
          "name": "from",
          "type": {
            "kind": "string"
          },
          "doc": "Who sent a notification; for a message, [`FROM_YOU`] or [`FROM_AGENT`]."
        },
        {
          "name": "event",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "seen",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "reply_to",
          "type": {
            "kind": "string"
          },
          "doc": "The message of yours an agent message answers."
        },
        {
          "name": "item_type",
          "type": {
            "kind": "string"
          },
          "doc": "One of [`ITEM_TYPES`]; `\"\"` for an untyped row."
        },
        {
          "name": "fields",
          "type": {
            "kind": "string"
          },
