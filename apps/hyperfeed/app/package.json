{
  "name": "hyperfeed",
  "private": true,
  "version": "0.0.0",
  "description": "Hyperfeed — one feed for everything your agent did and every notification your apps sent",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:node": "playwright test -c playwright.node.config.ts",
    "test:e2e:ci": "playwright test && playwright test -c playwright.node.config.ts",
    "codegen": "calimero-abi-codegen -i ../logic/res/abi.json -o src/generated --client-name HyperfeedClient --import-path @calimero-apps/cloud",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@calimero-apps/cloud": "workspace:*",
    "@calimero-apps/glass": "workspace:*",
    "@calimero-apps/names": "workspace:*",
    "@calimero-apps/node-served": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-platform": "catalog:",
    "@fontsource/ibm-plex-mono": "^5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@calimero-apps/e2e-node": "workspace:*",
    "@calimero-network/abi-codegen": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
