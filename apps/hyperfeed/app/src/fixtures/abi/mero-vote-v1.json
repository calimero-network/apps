            "$ref": "PollState"
          }
        },
        {
          "name": "ballots",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "TranscriptBallot"
            }
          }
        },
        {
          "name": "partials",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "TranscriptPartial"
            }
          }
        },
        {
          "name": "report",
          "type": {
            "$ref": "AuditReport"
          }
        }
      ]
    },
    "TranscriptBallot": {
      "kind": "record",
      "fields": [
        {
          "name": "voter",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "digest",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "ballot",
          "type": {
            "$ref": "WireBallot"
          }
        },
        {
          "name": "endorsed",
          "type": {
            "kind": "bool"
          },
          "doc": "Whether the voter's own slot still points at this ballot.\nInformational: authorship is the body's owner stamp, checked by\nthe audit as \"ballot authorship\"."
        }
      ]
    },
    "TranscriptPartial": {
      "kind": "record",
      "fields": [
        {
          "name": "trustee",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "index",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "options",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "WirePartial"
            }
          }
        }
      ]
    },
    "TransportKey": {
      "kind": "record",
      "doc": "A trustee's transport key and its proof of knowledge.",
      "fields": [
        {
          "name": "key",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "proof",
          "type": {
            "$ref": "WireBranch"
          }
        }
      ]
    },
    "TrusteeStatus": {
      "kind": "record",
      "fields": [
        {
          "name": "account",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "index",
          "type": {
            "kind": "u32"
          },
          "doc": "1-based Shamir index."
        },
        {
          "name": "transport_published",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "dealing_published",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "complaints_against",
          "type": {
            "kind": "u32"
          },
          "doc": "Valid complaints filed against this trustee's dealing."
        },
        {
          "name": "qualified",
          "type": {
            "kind": "bool"
          },
          "nullable": true,
          "doc": "Whether this trustee's dealing is part of the key (after open)."
        },
        {
          "name": "partial_published",
          "type": {
            "kind": "bool"
          }
        }
      ]
    },
    "Turnout": {
      "kind": "record",
      "doc": "Who has voted — never what.",
      "fields": [
        {
          "name": "voter",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "digest",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "cast_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "WireBallot": {
      "kind": "record",
      "doc": "An encrypted ballot exactly as the browser built it.",
      "fields": [
        {
          "name": "choices",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "WireChoice"
            }
          }
        },
        {
          "name": "sum_proof",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "WireBranch"
            }
          }
        }
      ]
    },
    "WireBranch": {
      "kind": "record",
      "doc": "One `(c, z)` pair of a proof, as 64-hex scalars.",
      "fields": [
        {
          "name": "c",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "z",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "WireChoice": {
      "kind": "record",
      "doc": "One option's ciphertext and its 0-or-1 proof.",
      "fields": [
        {
          "name": "a",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "b",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "proof",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "WireBranch"
            }
          }
        }
      ]
    },
    "WireCiphertext": {
      "kind": "record",
      "fields": [
        {
          "name": "a",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "b",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "WireDealing": {
      "kind": "record",
      "doc": "A trustee's contribution to the distributed key.",
      "fields": [
        {
          "name": "commitments",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "`t` Feldman commitments, constant term first."
        },
        {
          "name": "proof",
          "type": {
            "$ref": "WireBranch"
          },
          "doc": "Proof of knowledge of the constant term."
        },
        {
          "name": "shares",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "WireEncShare"
            }
          },
          "doc": "One per trustee, in the poll's trustee order."
        }
      ]
    },
    "WireEncShare": {
      "kind": "record",
      "doc": "One share of a dealing, encrypted to its recipient's transport key.",
      "fields": [
        {
          "name": "r",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "v",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "WirePartial": {
      "kind": "record",
      "doc": "A trustee's partial decryption of one option's aggregate.",
      "fields": [
        {
          "name": "d",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "proof",
          "type": {
            "$ref": "WireBranch"
          }
        }
      ]
    }
  },
  "methods": [
    {
      "name": "anchor_result",
      "doc": "Record where the transcript digest was published. Only for a fully\nverified result, and only with the digest this node computes.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "network",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reference",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "cast_ballot",
      "doc": "Submit a ballot the browser encrypted. Verified here before it is\nstored — and again by every reader, on every audit.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "ballot",
          "type": {
            "$ref": "WireBallot"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "ceremony",
      "doc": "Transport keys, dealings and complaints as they stand.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "Ceremony"
      },
      "intent": "read_only"
    },
    {
      "name": "close_poll",
      "doc": "Step one of closing: stop accepting ballots. Each node refuses new\nballots once it sees this; ballots cast before that keep syncing in,\nand the seal is what freezes the count.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "create_poll",
      "params": [
        {
          "name": "title",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "description",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "options",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "min_choices",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "max_choices",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "trustees",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "threshold",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "voters",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        },
        {
          "name": "closes_at",
          "type": {
            "kind": "u64"
          },
          "nullable": true
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "file_complaint",
      "doc": "A trustee proves `dealer` sent it a share that does not match the\ndealer's commitments. Refused unless the proof holds AND the share is\nreally bad — so a complaint can never frame an honest dealer.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "dealer",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "secret",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "proof",
          "type": {
            "$ref": "WireBranch"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "get_poll",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "PollView"
      },
      "intent": "read_only"
    },
    {
      "name": "get_result",
      "doc": "Re-verify everything and, once `t` trustees have published, the counts.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "AuditReport"
      },
      "intent": "read_only"
    },
    {
      "name": "get_transcript",
      "doc": "Every input of the tally plus this node's audit of it.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "Transcript"
      },
      "intent": "read_only"
    },
    {
      "name": "init",
      "params": [],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "list_polls",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "PollSummary"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "open_voting",
      "doc": "Freeze the election key and open voting. The qualified set is every\nverified dealing with no valid complaint against it, and it must hold\nat least `t` dealers — otherwise fewer than `t` colluders could know\nthe whole key.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "publish_dealing",
      "doc": "Round 2: a trustee deals shares of its polynomial to every trustee.\nThe contract checks the shape and the proof of knowledge; whether each\nencrypted share matches the commitments only its recipient can tell,\nwhich is what complaints are for. Write-once.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "dealing",
          "type": {
            "$ref": "WireDealing"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "publish_partial",
      "doc": "A trustee publishes `Dⱼ = xⱼ·Aⱼ` for every option's aggregate, each\nwith a DLEQ proof against its verification key `hⱼ`, which anyone can\nderive from the qualified commitments.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "partials",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "WirePartial"
            }
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "publish_transport_key",
      "doc": "Round 1: a trustee publishes the key dealers will encrypt its shares\nto. Write-once — dealings are addressed to it.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "key",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "proof",
          "type": {
            "$ref": "WireBranch"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "roster",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "Member"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "seal_poll",
      "doc": "Step two: freeze the ballots to count — every eligible voter's\ncurrent, re-verified ballot as this node sees it now.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "u32"
      },
      "intent": "mutating"
    },
    {
      "name": "set_name",
      "doc": "Put a display name in your slot. Doubles as \"I'm here\": the roster is\nhow a creator finds the accounts to name as trustees or voters.",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "tally_inputs",
      "doc": "The per-option aggregates a trustee decrypts. Recomputed from the\nfrozen ballots every call; nothing stored is trusted.",
      "params": [
        {
          "name": "poll_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "TallyInputs"
      },
      "intent": "read_only"
    },
    {
      "name": "whoami",
      "doc": "The caller's ACCOUNT — the id trustees and voter rolls are written in.",
      "params": [],
      "returns": {
        "$ref": "Identity"
      },
      "intent": "read_only"
    }
  ],
