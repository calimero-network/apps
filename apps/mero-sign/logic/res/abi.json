{
  "abiVersion": 1,
  "errors": {
    "Conflict": {
      "message": "string"
    },
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "id": "string",
      "what": "string"
    }
  },
  "events": {
    "ContextJoined": {
      "contextId": "string",
      "contextName": "string"
    },
    "ContextLeft": {
      "contextId": "string"
    },
    "DocumentDeleted": {
      "id": "string"
    },
    "DocumentSigned": {
      "documentId": "string",
      "signer": "string"
    },
    "DocumentUploaded": {
      "id": "string",
      "name": "string",
      "uploadedBy": "string"
    },
    "ParticipantJoined": {
      "userId": "string"
    },
    "ParticipantLeft": {
      "userId": "string"
    },
    "ParticipantPermissionChanged": {
      "permission": "PermissionLevel",
      "userId": "string"
    },
    "SignatureCreated": {
      "id": "u64",
      "name": "string",
      "size": "u64"
    },
    "SignatureDeleted": {
      "id": "u64"
    }
  },
  "methods": {
    "addParticipant": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds an account of the organization (guests included) at `permission`.\nAdmins only (`Forbidden`); `Conflict` for a participant (use\n`setParticipantPermission`), `Invalid` for an account outside the\norganization. Clears an earlier removal. Emits `ParticipantJoined`.",
      "kind": "call",
      "params": [
        [
          "userIdStr",
          "string"
        ],
        [
          "permission",
          "PermissionLevel"
        ]
      ],
      "public": false,
      "returns": null
    },
    "createSignature": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Saves a signature image the caller uploaded as blob `blobIdStr` and\nreturns its id (below 2^53). Private library, owner only.\nEmits `SignatureCreated`.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "blobIdStr",
          "string"
        ],
        [
          "dataSize",
          "u64"
        ]
      ],
      "public": false,
      "returns": "u64"
    },
    "deleteDocument": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a document with its search content, signatures and consents.\nAdmins only (`Forbidden`); `NotFound` for an unknown id. The blobs stay\nin the app until the owner deletes them. Emits `DocumentDeleted`.",
      "kind": "call",
      "params": [
        [
          "documentId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deleteSignature": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes a saved signature. Private library, owner only; `NotFound` for\nan unknown id. Emits `SignatureDeleted`.",
      "kind": "call",
      "params": [
        [
          "signatureId",
          "u64"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getContextDetails": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The agreement's name, owner, participants (at most 1,000) and document\ncount. `contextIdStr` is echoed back as `contextId`.",
      "kind": "view",
      "params": [
        [
          "contextIdStr",
          "string"
        ]
      ],
      "public": false,
      "returns": "ContextDetails"
    },
    "getContextId": {
      "allowSystem": false,
      "confirm": false,
      "doc": "This instance's app id (v1's context id).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "getDocumentSignatures": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The signatures on a document, in the order they were applied; empty\nfor an unknown document.",
      "kind": "view",
      "params": [
        [
          "documentId",
          "string"
        ]
      ],
      "public": false,
      "returns": "list<DocumentSignature>"
    },
    "getIdentityMapping": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The identity mapping recorded for a joined agreement. Private library,\nowner only; `NotFound` if none.",
      "kind": "view",
      "params": [
        [
          "contextIdStr",
          "string"
        ]
      ],
      "public": false,
      "returns": "IdentityMapping"
    },
    "getSharedIdentity": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The shared identity recorded for a joined agreement. Private library,\nowner only; `NotFound` if none.",
      "kind": "view",
      "params": [
        [
          "contextIdStr",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "getUserPermission": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A participant's level; `NotFound` for someone who is not one.",
      "kind": "view",
      "params": [
        [
          "userIdStr",
          "string"
        ]
      ],
      "public": false,
      "returns": "PermissionLevel"
    },
    "hasConsented": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Whether `userIdStr` consented to sign a document.",
      "kind": "view",
      "params": [
        [
          "userIdStr",
          "string"
        ],
        [
          "documentId",
          "string"
        ]
      ],
      "public": false,
      "returns": "bool"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The empty instance. The node runs it once, when the app is created;\nthe owner then calls `setup`.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "isDefaultPrivateContext": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Whether this is the account's default private library (set up private\nand named `\"default\"`). `false` before `setup`.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "bool"
    },
    "joinSharedContext": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Records that the owner joined the agreement `contextIdStr` (its app id)\nas `sharedIdentityStr` (their account). Private library, owner only;\n`Conflict` if already recorded. Emits `ContextJoined`.",
      "kind": "call",
      "params": [
        [
          "contextIdStr",
          "string"
        ],
        [
          "sharedIdentityStr",
          "string"
        ],
        [
          "contextName",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "leaveSharedContext": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Forgets a joined agreement. Private library, owner only; `NotFound` if\nit was not recorded. Emits `ContextLeft`.",
      "kind": "call",
      "params": [
        [
          "contextIdStr",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "listDocuments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every document (at most 1,000, in id order) with its current version\nand status, without its search content.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<DocumentInfo>"
    },
    "listJoinedContexts": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The joined agreements, at most 1,000, in app-id order. Private library,\nowner only.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<ContextMetadata>"
    },
    "listParticipants": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every participant's account, at most 1,000, in account order.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<string>"
    },
    "listSignatures": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The saved signatures, at most 1,000, in id order. Private library,\nowner only.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<SignatureRecord>"
    },
    "markParticipantSigned": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Confirms the CALLER's signature is on a document: `Forbidden` without\nconsent, `Invalid` if they have not signed it. Writes nothing.",
      "kind": "call",
      "params": [
        [
          "documentId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "registerSelfAsParticipant": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Joins the agreement as `Sign` (v1: after redeeming an open invitation).\nMembers of the organization only (a guest gets `Forbidden`), not after\nan admin removed you (`Forbidden`), and once (`Conflict`). Emits\n`ParticipantJoined`.",
      "kind": "call",
      "params": [],
      "public": false,
      "returns": null
    },
    "removeParticipant": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes a participant, and keeps them from registering again. Admins\nonly (`Forbidden`); `NotFound` for someone who is not one; `Conflict`\nfor the last admin. Emits `ParticipantLeft`.",
      "kind": "call",
      "params": [
        [
          "userIdStr",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "resolvePrivateIdentity": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The private identity behind a shared one, if recorded. Private library,\nowner only.",
      "kind": "view",
      "params": [
        [
          "sharedIdentityStr",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<string>"
    },
    "searchDocumentByEmbedding": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The most relevant passages of a document for a query embedding, as\ntext: by chunk when the document has chunks, else by its whole-document\nembedding. `NotFound` for an unknown document; `Invalid` for a document\nwith nothing to search or an embedding of another dimension.",
      "kind": "view",
      "params": [
        [
          "queryEmbedding",
          "list<f32>"
        ],
        [
          "documentId",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "setConsent": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Records the CALLER's consent to sign a document. Nobody can consent for\nyou, so there is no account parameter.",
      "kind": "call",
      "params": [
        [
          "documentId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setParticipantPermission": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Changes an existing participant's level, up or down. Admins only\n(`Forbidden`); `NotFound` for someone who is not one; `Conflict` for the\nlast admin stepping down. Setting the level they hold is a no-op.\nEmits `ParticipantPermissionChanged`.",
      "kind": "call",
      "params": [
        [
          "userIdStr",
          "string"
        ],
        [
          "permission",
          "PermissionLevel"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setup": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Makes this instance a private library (`isPrivate`) or a shared\nagreement named `contextName` (v1's `init(is_private, context_name)`).\nThe app's owner only (`Forbidden`), once (`Conflict`). A shared\nagreement's owner is its first admin.",
      "kind": "call",
      "params": [
        [
          "isPrivate",
          "bool"
        ],
        [
          "contextName",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "signDocument": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Records the CALLER's signature: the PDF at the document's current\nversion (`baseHash`) with their mark on it, uploaded as blob\n`pdfBlobIdStr`, is the document's new version `newHash`. `Sign` or\nabove (`Forbidden`), after consenting (`Forbidden`); `Conflict` for a\nfully signed document, a second signature, or a `baseHash` that is no\nlonger current (someone signed in between: reopen and sign again).\nEmits `DocumentSigned`.",
      "kind": "call",
      "params": [
        [
          "documentId",
          "string"
        ],
        [
          "baseHash",
          "string"
        ],
        [
          "pdfBlobIdStr",
          "string"
        ],
        [
          "fileSize",
          "u64"
        ],
        [
          "newHash",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "uploadDocument": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Adds a document the caller uploaded as blob `pdfBlobIdStr` and returns\nits id. `Sign` or above (`Forbidden`). Its required signers are every\nparticipant at `Sign` or above now (at most 1,000). Emits\n`DocumentUploaded`.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ],
        [
          "hash",
          "string"
        ],
        [
          "pdfBlobIdStr",
          "string"
        ],
        [
          "fileSize",
          "u64"
        ],
        [
          "embeddings",
          "option<list<f32>>"
        ],
        [
          "extractedText",
          "option<string>"
        ],
        [
          "chunks",
          "option<list<DocumentChunk>>"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "whoami": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's account, as this contract sees it.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    }
  },
  "state": {
    "fields": {
      "admins": "set",
      "consents": "unorderedMap",
      "documentChunks": "unorderedMap",
      "documentContent": "unorderedMap",
      "documentSignatures": "unorderedMap",
      "documents": "unorderedMap",
      "identityMappings": "unorderedMap",
      "info": "cell",
      "joinedContexts": "unorderedMap",
      "participants": "unorderedMap",
      "removed": "set",
      "signatures": "unorderedMap"
    },
    "search": {
      "admins": [],
      "consents": [],
