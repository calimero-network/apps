{
  "schema_version": "wasm-abi/1",
  "types": {
    "Consents": {
      "kind": "record",
      "doc": "One account's consents, in that account's own [`UserStorage`] slot: only\nthey can give (or forge) their consent, and nobody can occupy the entry.",
      "fields": [
        {
          "name": "documents",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "bool"
              }
            },
            "crdt_type": "unordered_map"
          }
        }
      ]
    },
    "ContextDetails": {
      "kind": "record",
      "doc": "Detailed information about a shared context",
      "fields": [
        {
          "name": "context_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "context_name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "is_private",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "participant_count",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "participants",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "ParticipantInfo"
            }
          }
        },
        {
          "name": "document_count",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "ContextMetadata": {
      "kind": "record",
      "doc": "Metadata for tracking joined shared contexts",
      "fields": [
        {
          "name": "context_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "context_name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "role",
          "type": {
            "$ref": "ParticipantRole"
          }
        },
        {
          "name": "joined_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "private_identity",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "shared_identity",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        }
      ]
    },
    "DocumentChunk": {
      "kind": "record",
      "doc": "Document chunk with its embedding",
      "fields": [
        {
          "name": "text",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "embedding",
          "type": {
            "kind": "list",
            "items": {
              "kind": "f32"
            }
          }
        },
        {
          "name": "start_position",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "end_position",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "DocumentInfo": {
      "kind": "record",
      "doc": "Document information as read: the uploaded document, its current version\n(the last signature's, or the upload's) and its status, derived every read\nfrom the write-once entries.\n\n`embeddings`, `extracted_text` and `chunks` are always `None` in\n`list_documents`, which returns every document; they stay in storage for\n`search_document_by_embedding`.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "hash",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "uploaded_by",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "uploaded_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "status",
          "type": {
            "$ref": "DocumentStatus"
          }
        },
        {
          "name": "pdf_blob_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "required_signers",
          "type": {
            "kind": "list",
            "items": {
              "kind": "bytes",
              "size": 32
            }
          }
        },
        {
          "name": "embeddings",
          "type": {
            "kind": "list",
            "items": {
              "kind": "f32"
            }
          },
          "nullable": true
        },
        {
          "name": "extracted_text",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "chunks",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "DocumentChunk"
            }
          },
          "nullable": true
        }
      ]
    },
    "DocumentSignature": {
      "kind": "record",
      "doc": "A signature on a document, as read. `signer` is the entry's owner stamp.",
      "fields": [
        {
          "name": "signer",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "signed_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "DocumentStatus": {
      "kind": "variant",
      "doc": "Document status, derived from the document's signatures.\n\n`FullySigned` IS TERMINAL. Completion is a fact about the past: the\nsigners a document waits for are fixed when it is uploaded, its signatures\nare written once, and a completed document refuses further signatures. A\nparticipant added later was not party to it; if they need to be, that is a\nnew document.",
      "variants": [
        {
          "name": "Pending"
        },
        {
          "name": "PartiallySigned"
        },
        {
          "name": "FullySigned"
        }
      ]
    },
    "IdentityMapping": {
      "kind": "record",
      "doc": "Identity mapping for tracking user identities across contexts",
      "fields": [
        {
          "name": "private_identity",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "shared_identity",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "context_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "MeroSignEvent_ContextJoined": {
      "kind": "record",
      "fields": [
        {
          "name": "context_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "context_name",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "MeroSignEvent_ContextLeft": {
      "kind": "record",
      "fields": [
        {
          "name": "context_id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "MeroSignEvent_DocumentDeleted": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "MeroSignEvent_DocumentSigned": {
      "kind": "record",
      "fields": [
        {
          "name": "document_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "signer",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        }
      ]
    },
    "MeroSignEvent_DocumentUploaded": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "uploaded_by",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        }
      ]
    },
    "MeroSignEvent_ParticipantInvited": {
      "kind": "record",
      "fields": [
        {
          "name": "user_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "role",
          "type": {
            "$ref": "ParticipantRole"
          }
        }
      ]
    },
    "MeroSignEvent_ParticipantJoined": {
      "kind": "record",
      "fields": [
        {
          "name": "user_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        }
      ]
    },
    "MeroSignEvent_ParticipantLeft": {
      "kind": "record",
      "fields": [
        {
          "name": "user_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        }
      ]
    },
    "MeroSignEvent_ParticipantPermissionChanged": {
      "kind": "record",
      "fields": [
        {
          "name": "user_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "permission",
          "type": {
            "$ref": "PermissionLevel"
          }
        }
      ]
    },
    "MeroSignEvent_SignatureCreated": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "MeroSignEvent_SignatureDeleted": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "MeroSignState": {
      "kind": "record",
      "doc": "Every field that decides who may do what is guarded by a storage type,\nbecause a member running a modified node skips every check in the methods\nbelow and writes plain fields directly:\n\n| field | who may write it, on every node |\n|---|---|\n| `is_private`, `owner`, `context_name` | nobody after `init` (`Frozen`) |\n| `roles` | admins (`AccessControl`'s writer set) |\n| `joined` | each account its own slot (`UserStorage`) |\n| `documents` | anyone adds; nobody edits; admins remove (`ModeratedOnce`) |\n| `document_signatures` | each signer their own; nobody edits or removes (`WriteOnce`) |\n| `consents` | each account its own slot (`UserStorage`) |\n\nThe private-context fields (`signatures`, `joined_contexts`,\n`identity_mappings`) are plain: a private context holds its owner's\naccount alone.",
      "fields": [
        {
          "name": "is_private",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "bool"
            }
          }
        },
        {
          "name": "owner",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "bytes",
              "size": 32
            }
          }
        },
        {
          "name": "context_name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "signatures",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "SignatureRecord"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "joined_contexts",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "ContextMetadata"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "identity_mappings",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "IdentityMapping"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "roles",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bool"
            },
            "crdt_type": "shared_storage"
          },
          "doc": "Admin, signer and viewer grants, and removals."
        },
        {
          "name": "joined",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "u64"
              }
            }
          },
          "doc": "Accounts that registered themselves through an open invitation: `Sign`\nunless an admin set another level or removed them."
        },
        {
          "name": "documents",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "StoredDocument"
            },
            "crdt_type": "authored_map"
          },
          "doc": "Moderated by the admins, kept equal to `roles.admins()`."
        },
        {
          "name": "document_signatures",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "SignedVersion"
            },
            "crdt_type": "authored_map"
          },
          "doc": "`\"{document_id}/{signer hex}/{nonce}\"`: a document's signatures are one\nprefix, and the nonce leaves no key for anyone to occupy first."
        },
        {
          "name": "consents",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Consents"
            }
          }
        }
      ]
    },
    "ParticipantInfo": {
      "kind": "record",
      "doc": "Participant information with permission level",
      "fields": [
        {
          "name": "user_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "permission_level",
          "type": {
            "$ref": "PermissionLevel"
          }
        }
      ]
    },
    "ParticipantRole": {
      "kind": "variant",
      "doc": "Participant roles in shared contexts",
      "variants": [
        {
          "name": "Owner"
        },
        {
          "name": "Signer"
        },
        {
          "name": "Viewer"
        },
        {
          "name": "Unknown"
        }
      ]
    },
    "PermissionLevel": {
      "kind": "variant",
      "doc": "Permission levels for participants",
      "variants": [
        {
          "name": "Read"
        },
        {
          "name": "Sign"
        },
        {
          "name": "Admin"
        }
      ]
    },
    "SignatureRecord": {
      "kind": "record",
      "doc": "Signature record - uses LWW based on created_at timestamp",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "blob_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "SignedVersion": {
      "kind": "record",
      "doc": "One signature: the signer (the entry's owner stamp) took the version at\n`base_hash`, put their mark on it, and produced the version at `new_hash`,\nstored as `pdf_blob_id`. Written once, so a signature can be neither\nwithdrawn nor edited, and the version it signed stays on record.",
      "fields": [
        {
          "name": "base_hash",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "new_hash",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "pdf_blob_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "signed_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "StoredDocument": {
      "kind": "record",
      "doc": "A document as uploaded. Written once: nobody, the uploader included, can\nchange it afterwards, and only an admin (a moderator of `documents`) can\nremove it. The uploader is the entry's owner stamp.\n\nWhat signing changes is recorded beside it, one write-once\n[`SignedVersion`] per signature, never by rewriting this.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "hash",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "pdf_blob_id",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        },
        {
          "name": "size",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "uploaded_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "required_signers",
          "type": {
            "kind": "list",
            "items": {
              "kind": "bytes",
              "size": 32
            }
          },
          "doc": "Who must sign it: every participant holding `Sign` or `Admin` when it\nwas uploaded. Fixed with the document, so completion is a fact about\nthe past — nobody who joins later reopens it."
        },
        {
          "name": "embeddings",
          "type": {
            "kind": "list",
            "items": {
              "kind": "f32"
            }
          },
          "nullable": true
        },
        {
          "name": "extracted_text",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "chunks",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "DocumentChunk"
            }
          },
          "nullable": true
        }
      ]
    }
  },
  "methods": [
    {
      "name": "add_participant",
      "doc": "Add participant to shared context (admin only)",
      "params": [
        {
          "name": "user_id_str",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "permission",
          "type": {
            "$ref": "PermissionLevel"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "create_signature",
      "doc": "Create a new signature and store its blob ID",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "blob_id_str",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "data_size",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "u64"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_document",
      "doc": "Delete a document by ID. Admins only: they are the documents'\nmoderators, and every node refuses anyone else's removal.",
      "params": [
        {
          "name": "document_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "delete_signature",
      "doc": "Delete a signature by ID",
      "params": [
        {
          "name": "signature_id",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "get_context_details",
      "doc": "Get detailed information about the shared context",
      "params": [
        {
          "name": "context_id_str",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "ContextDetails"
      },
      "intent": "read_only"
    },
    {
      "name": "get_context_id",
      "doc": "Get current context ID",
      "params": [],
      "returns": {
        "kind": "bytes",
        "size": 32
      },
      "intent": "read_only"
    },
    {
      "name": "get_document_signatures",
      "doc": "The signatures on a document, in the order they were applied.",
      "params": [
        {
          "name": "document_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "DocumentSignature"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_identity_mapping",
      "doc": "Get identity mapping for a specific context",
      "params": [
        {
          "name": "context_id_str",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "IdentityMapping"
      },
      "intent": "read_only"
    },
    {
      "name": "get_shared_identity",
      "doc": "Get shared identity for a specific context",
      "params": [
        {
          "name": "context_id_str",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "bytes",
        "size": 32
      },
      "intent": "read_only"
    },
    {
      "name": "get_user_permission",
      "doc": "Get user permission level",
      "params": [
        {
          "name": "user_id_str",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "PermissionLevel"
      },
      "intent": "read_only"
    },
    {
      "name": "has_consented",
      "doc": "Check if user has given consent for a document (public API)",
      "params": [
        {
          "name": "user_id_str",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "document_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "bool"
      },
      "intent": "read_only"
    },
    {
      "name": "init",
      "params": [
        {
          "name": "is_private",
          "type": {
            "kind": "bool"
          }
        },
        {
          "name": "context_name",
          "type": {
            "kind": "string"
          }
