{
  "schema_version": "wasm-abi/1",
  "types": {
    "Answer": {
      "kind": "record",
      "doc": "The defender's answer to the shot of the same turn, keyed\n`\"<defender account>/<turn>/<nonce>\"`.",
      "fields": [
        {
          "name": "hit",
          "type": {
            "kind": "bool"
          }
        }
      ]
    },
    "Event_AuditFailed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reason",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_AuditPassed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_BoardCommitted": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "commitment",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_BoardRevealed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_MatchEnded": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_RevealRequested": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_ShipsPlaced": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_ShotFired": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "result",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_ShotProposed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "Event_Winner": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "GameConfig": {
      "kind": "record",
      "doc": "Everything fixed when the match is created.",
      "fields": [
        {
          "name": "lobby_context_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "players",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Player"
            }
          },
          "doc": "`[player1, player2]`, or empty when `init` was not given both."
        }
      ]
    },
    "GameState": {
      "kind": "record",
      "fields": [
        {
          "name": "config",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "$ref": "GameConfig"
            }
          }
        },
        {
          "name": "commitments",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bytes",
              "size": 32
            },
            "crdt_type": "authored_map"
          },
          "doc": "`\"<account>/<nonce>\"` -> that player's SHA-256 board commitment."
        },
        {
          "name": "shots",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Shot"
            },
            "crdt_type": "authored_map"
          }
        },
        {
          "name": "answers",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Answer"
            },
            "crdt_type": "authored_map"
          }
        },
        {
          "name": "reveals",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Reveal"
            },
            "crdt_type": "authored_map"
          }
        }
      ]
    },
    "MatchStateView": {
      "kind": "record",
      "doc": "The match as every reader derives it, in one read: what a client needs to\nknow whether to commit, answer, reveal, or show a result.",
      "fields": [
        {
          "name": "standing",
          "type": {
            "kind": "string"
          },
          "doc": "`playing`, `awaiting_reveal`, `won` or `void`."
        },
        {
          "name": "committed",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Players, by key, whose commitment is on record."
        },
        {
          "name": "pending_shot",
          "type": {
            "$ref": "PendingShotView"
          },
          "nullable": true
        },
        {
          "name": "ended_by",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "Why the answers ended it: `sunk`, `equivocation` or\n`impossible_misses`. `None` while playing."
        },
        {
          "name": "loser",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "The player the answers say lost, by key."
        },
        {
          "name": "revealed",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Players whose revealed board matched their commitment."
        },
        {
          "name": "audit_failed",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          },
          "doc": "Players whose revealed board failed the audit — a lie about a shot, or\nan illegal fleet. Revealing is how a cheater is caught."
        },
        {
          "name": "winner",
          "type": {
            "kind": "string"
          },
          "nullable": true,
          "doc": "The audited winner, by key. Set only when `standing` is `won`."
        }
      ]
    },
    "PendingShotView": {
      "kind": "record",
      "doc": "The shot waiting for its defender's answer.",
      "fields": [
        {
          "name": "shot_id",
          "type": {
            "kind": "u32"
          },
          "doc": "What `acknowledge_shot` takes: the turn index of this shot, so an\nanswer meant for an earlier shot is refused instead of misfiled."
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "target",
          "type": {
            "kind": "string"
          },
          "doc": "The player who has to answer, by key."
        }
      ]
    },
    "Player": {
      "kind": "record",
      "doc": "One player: the context-member key the UI names them by, and the account\ncore stamps their rows with.\n\nA player id is a context member (a device); a row's owner stamp is the\nPERSON. Both are recorded because both are true, and the account is the one\nthe security rests on.",
      "fields": [
        {
          "name": "key",
          "type": {
            "$ref": "PublicKey"
          }
        },
        {
          "name": "account",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        }
      ]
    },
    "PublicKey": {
      "kind": "alias",
      "doc": "Player public key — 32-byte Ed25519 key with base58 encoding.\n\nNote: `from_executor_id()` lives in each service crate (requires calimero-sdk).",
      "target": {
        "kind": "bytes",
        "size": 32
      }
    },
    "Reveal": {
      "kind": "record",
      "doc": "A board opened at match end, keyed `\"<account>/<nonce>\"`.",
      "fields": [
        {
          "name": "board_bytes",
          "type": {
            "kind": "bytes"
          }
        },
        {
          "name": "salt",
          "type": {
            "kind": "bytes",
            "size": 16
          }
        }
      ]
    },
    "Shot": {
      "kind": "record",
      "doc": "A shot, keyed `\"<shooter account>/<turn>/<nonce>\"`.",
      "fields": [
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "ShotsView": {
      "kind": "record",
      "doc": "A grid of the caller's shots (`get_shots`) or of the shots fired at the\ncaller (`get_incoming_shots`): one [`Cell`] byte per square, row-major.",
      "fields": [
        {
          "name": "size",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "shots",
          "type": {
            "kind": "bytes"
          }
        }
      ]
    }
  },
  "methods": [
    {
      "name": "acknowledge_shot",
      "doc": "The defender's answer to the pending shot — `hit` or not — as their\nclient read it off the board on their device. A signed statement in\nshared state, write-once: it is what the reveal is replayed against,\nso a false answer here is the lie the audit catches.\n\n`shot_id` is the pending shot's turn index (see `get_match_state`), so\nan answer composed for one shot cannot land on the next.",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "shot_id",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "hit",
          "type": {
            "kind": "bool"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "commit_board",
      "doc": "File the caller's board commitment: `SHA256(borsh(board) || salt)` as\n64 hex characters, computed on the device that keeps the board and the\nsalt. Whether the board behind it is a legal fleet is settled at the\nreveal, by every reader — a commitment to nonsense is a loss, not a\nrefusal.",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "commitment",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "get_active_match_id",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "get_current_turn",
      "doc": "The player whose turn it is to shoot, or `None` once the match is over.",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "get_current_user",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "get_incoming_shots",
      "doc": "The opponent's shots at the caller, as a grid — what the client lays\nover the board on the device to draw \"your waters\": the answers the\ncaller gave, and the shot still waiting for one.",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "ShotsView"
      },
      "intent": "read_only"
    },
    {
      "name": "get_match_state",
      "doc": "Everything a client needs in one read, so a session on a relay is\nnot four round trips per event.",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "MatchStateView"
      },
      "intent": "read_only"
    },
    {
      "name": "get_shots",
      "doc": "The caller's shots at the opponent, as a grid.",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "ShotsView"
      },
      "intent": "read_only"
    },
    {
      "name": "get_winner",
      "doc": "The winner, once the match is over AND the winner's revealed board has\npassed every reader's audit. `None` while playing, while waiting for a\nreveal, and for a match both players cheated in.",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "init",
      "params": [
        {
          "name": "player1",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player2",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player2_account",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "lobby_context_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "propose_shot",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "reveal_board",
      "doc": "Publish the caller's `(board, salt)` for every reader to audit, and\nreport how the audit went. Only once the match is over: a board opened\nmid-game is a board handed to the opponent.\n\n`board_bytes` is `borsh(Vec<u8>)` of the 100 pristine cells (water or\nship), exactly what was hashed into the commitment. A pair that does\nnot hash to the commitment is refused, so the player can retry with\nthe right board; a pair that does is on record for good, and if the\nanswers the player gave do not match it, every reader marks them a\ncheater and the game goes to the opponent.",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "board_bytes",
          "type": {
            "kind": "bytes"
          }
        },
        {
          "name": "salt",
          "type": {
            "kind": "bytes",
            "size": 16
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    }
  ],
  "events": [
    {
      "name": "AuditFailed",
      "payload": {
        "$ref": "Event_AuditFailed"
      },
      "doc": "Audit failed for a player; reason gives the specific failure."
    },
    {
      "name": "AuditPassed",
      "payload": {
        "$ref": "Event_AuditPassed"
      },
      "doc": "Audit (commitment check + shot replay) passed for a player."
    },
    {
      "name": "BoardCommitted",
      "payload": {
        "$ref": "Event_BoardCommitted"
      },
      "doc": "A player's SHA256 board commitment has been recorded."
    },
    {
      "name": "BoardRevealed",
      "payload": {
        "$ref": "Event_BoardRevealed"
      },
      "doc": "A player revealed their board post-match and the audit passed/failed."
    },
    {
      "name": "MatchEnded",
      "payload": {
        "$ref": "Event_MatchEnded"
      },
      "doc": "The match ended."
    },
    {
      "name": "RevealRequested",
      "payload": {
        "$ref": "Event_RevealRequested"
      },
      "doc": "The answers ended the match: the other player's node opens its board."
    },
    {
      "name": "ShipsPlaced",
      "payload": {
        "$ref": "Event_ShipsPlaced"
      },
      "doc": "A player placed their ships."
    },
    {
      "name": "ShotFired",
      "payload": {
        "$ref": "Event_ShotFired"
      },
      "doc": "A shot was resolved."
    },
    {
      "name": "ShotProposed",
      "payload": {
        "$ref": "Event_ShotProposed"
      },
      "doc": "A player proposed a shot."
    },
    {
      "name": "Winner",
      "payload": {
        "$ref": "Event_Winner"
      },
      "doc": "A winner was determined."
    }
  ],
  "state_root": "GameState",
  "state_version": 1
}