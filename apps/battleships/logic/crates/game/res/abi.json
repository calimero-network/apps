{
  "schema_version": "wasm-abi/1",
  "types": {
    "Answer": {
      "kind": "record",
      "doc": "The defender's answer to the shot of the same turn, keyed\n`\"<defender account>/<turn>/<nonce>\"`.",
      "fields": [
        {
          "name": "hit",
          "type": {
            "kind": "bool"
          }
        }
      ]
    },
    "Event_AuditFailed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "reason",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_AuditPassed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_BoardCommitted": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "commitment",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_BoardRevealed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_MatchEnded": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_RevealRequested": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_ShipsPlaced": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_ShotFired": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "result",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_ShotProposed": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "Event_Winner": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "ExportedSeed": {
      "kind": "record",
      "doc": "Export payload for cross-device durability. Defined locally (not re-used from\n`battleships-types`) because the wasm-abi emitter resolves types by their\nlocal path and would otherwise not find it.",
      "fields": [
        {
          "name": "board_bytes",
          "type": {
            "kind": "bytes"
          }
        },
        {
          "name": "salt",
          "type": {
            "kind": "bytes",
            "size": 16
          }
        }
      ]
    },
    "GameConfig": {
      "kind": "record",
      "doc": "Everything fixed when the match is created.",
      "fields": [
        {
          "name": "lobby_context_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "players",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Player"
            }
          },
          "doc": "`[player1, player2]`, or empty when `init` was not given both."
        }
      ]
    },
    "GameState": {
      "kind": "record",
      "fields": [
        {
          "name": "config",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "$ref": "GameConfig"
            }
          }
        },
        {
          "name": "commitments",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "bytes",
              "size": 32
            },
            "crdt_type": "authored_map"
          },
          "doc": "`\"<account>/<nonce>\"` -> that player's SHA-256 board commitment."
        },
        {
          "name": "shots",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Shot"
            },
            "crdt_type": "authored_map"
          }
        },
        {
          "name": "answers",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Answer"
            },
            "crdt_type": "authored_map"
          }
        },
        {
          "name": "reveals",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Reveal"
            },
            "crdt_type": "authored_map"
          }
        }
      ]
    },
    "OwnBoardView": {
      "kind": "record",
      "fields": [
        {
          "name": "size",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "board",
          "type": {
            "kind": "bytes"
          }
        }
      ]
    },
    "Player": {
      "kind": "record",
      "doc": "One player: the context-member key the UI names them by, and the account\ncore stamps their rows with.\n\nA player id is a context member (a device); a row's owner stamp is the\nPERSON. Both are recorded because both are true, and the account is the one\nthe security rests on.",
      "fields": [
        {
          "name": "key",
          "type": {
            "$ref": "PublicKey"
          }
        },
        {
          "name": "account",
          "type": {
            "kind": "bytes",
            "size": 32
          }
        }
      ]
    },
    "PublicKey": {
      "kind": "alias",
      "doc": "Player public key — 32-byte Ed25519 key with base58 encoding.\n\nNote: `from_executor_id()` lives in each service crate (requires calimero-sdk).",
      "target": {
        "kind": "bytes",
        "size": 32
      }
    },
    "Reveal": {
      "kind": "record",
      "doc": "A board opened at match end, keyed `\"<account>/<nonce>\"`.",
      "fields": [
        {
          "name": "board_bytes",
          "type": {
            "kind": "bytes"
          }
        },
        {
          "name": "salt",
          "type": {
            "kind": "bytes",
            "size": 16
          }
        }
      ]
    },
    "Shot": {
      "kind": "record",
      "doc": "A shot, keyed `\"<shooter account>/<turn>/<nonce>\"`.",
      "fields": [
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "ShotsView": {
      "kind": "record",
      "fields": [
        {
          "name": "size",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "shots",
          "type": {
            "kind": "bytes"
          }
        }
      ]
    }
  },
  "methods": [
    {
      "name": "acknowledge_shot",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "string"
      },
      "intent": "mutating"
    },
    {
      "name": "acknowledge_shot_handler",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating",
      "handler": true
    },
    {
      "name": "export_board_seed",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "ExportedSeed"
      },
      "intent": "read_only"
    },
    {
      "name": "get_active_match_id",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "get_current_turn",
      "doc": "The player whose turn it is to shoot, or `None` once the match is over.",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "get_current_user",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "get_own_board",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "OwnBoardView"
      },
      "intent": "read_only"
    },
    {
      "name": "get_shots",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "ShotsView"
      },
      "intent": "read_only"
    },
    {
      "name": "get_winner",
      "doc": "The winner, once the match is over AND the winner's revealed board has\npassed every reader's audit. `None` while playing, while waiting for a\nreveal, and for a match both players cheated in.",
      "params": [],
      "returns": {
        "kind": "string"
      },
      "intent": "read_only"
    },
    {
      "name": "import_board_seed",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "board_bytes",
          "type": {
            "kind": "bytes"
          }
        },
        {
          "name": "salt",
          "type": {
            "kind": "bytes",
            "size": 16
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "init",
      "params": [
        {
          "name": "player1",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player2",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player2_account",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "lobby_context_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "place_ships",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "ships",
          "type": {
            "kind": "list",
            "items": {
              "kind": "string"
            }
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "propose_shot",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "u32"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "reveal_board",
      "doc": "Publish the caller's board for every reader to audit. Only once the\nmatch is over: a board opened mid-game is a board handed to the\nopponent.",
      "params": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "reveal_board_handler",
      "doc": "Runs on the other player's node when the answers end the match, so\nboth boards are opened without either player having to ask.",
      "params": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating",
      "handler": true
    }
  ],
  "events": [
    {
      "name": "AuditFailed",
      "payload": {
        "$ref": "Event_AuditFailed"
      },
      "doc": "Audit failed for a player; reason gives the specific failure."
    },
    {
      "name": "AuditPassed",
      "payload": {
        "$ref": "Event_AuditPassed"
      },
      "doc": "Audit (commitment check + shot replay) passed for a player."
    },
    {
      "name": "BoardCommitted",
      "payload": {
        "$ref": "Event_BoardCommitted"
      },
      "doc": "A player's SHA256 board commitment has been recorded."
    },
    {
      "name": "BoardRevealed",
      "payload": {
        "$ref": "Event_BoardRevealed"
      },
      "doc": "A player revealed their board post-match and the audit passed/failed."
    },
    {
      "name": "MatchEnded",
      "payload": {
        "$ref": "Event_MatchEnded"
      },
      "doc": "The match ended."
    },
    {
      "name": "RevealRequested",
      "payload": {
        "$ref": "Event_RevealRequested"
      },
      "doc": "The answers ended the match: the other player's node opens its board."
    },
    {
      "name": "ShipsPlaced",
      "payload": {
        "$ref": "Event_ShipsPlaced"
      },
      "doc": "A player placed their ships."
    },
    {
      "name": "ShotFired",
      "payload": {
        "$ref": "Event_ShotFired"
      },
      "doc": "A shot was resolved."
    },
    {
      "name": "ShotProposed",
      "payload": {
        "$ref": "Event_ShotProposed"
      },
      "doc": "A player proposed a shot."
    },
    {
      "name": "Winner",
      "payload": {
        "$ref": "Event_Winner"
      },
      "doc": "A winner was determined."
    }
  ],
  "state_root": "GameState",
  "state_version": 1
}