    },
    "Invalid": {
      "message": "string"
    },
    "MatchIdCollision": {},
    "NotFound": {
      "matchId": "string"
    }
  },
  "events": {
    "AuditFailed": {
      "id": "string",
      "player": "string",
      "reason": "string"
    },
    "AuditPassed": {
      "id": "string",
      "player": "string"
    },
    "BoardCommitted": {
      "commitment": "string",
      "id": "string",
      "player": "string"
    },
    "BoardRevealed": {
      "id": "string",
      "player": "string"
    },
    "MatchCreated": {
      "id": "string"
    },
    "MatchEnded": {
      "id": "string"
    },
    "MatchListUpdated": {},
    "PlayerStatsUpdated": {},
    "PlayersUpdated": {},
    "RevealRequested": {
      "id": "string"
    },
    "ShipsPlaced": {
      "id": "string"
    },
    "ShotFired": {
      "id": "string",
      "result": "string",
      "x": "u8",
      "y": "u8"
    },
    "ShotProposed": {
      "id": "string",
      "x": "u8",
      "y": "u8"
    },
    "Winner": {
      "id": "string"
    }
  },
  "methods": {
    "acknowledgeShot": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The defender's answer to the pending shot, as their client read it off\nthe board on their device: a signed statement, written once, that the\nreveal is replayed against. `shotId` is the pending shot's turn index\n(see `getMatchState`). Returns `\"hit\"` or `\"miss\"`. Emits `ShotFired`,\nand `RevealRequested` when the answers end the match.",
      "kind": "call",
      "params": [
        [
          "matchId",
          "string"
        ],
        [
          "shotId",
          "u32"
        ],
        [
          "hit",
          "bool"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "commitBoard": {
      "allowSystem": false,
      "confirm": false,
      "doc": "File the caller's board commitment: `SHA256(borsh(board) || salt)` as\n64 hex characters, computed on the device that keeps the board and the\nsalt. Whether the board behind it is a legal fleet is settled at the\nreveal, by every reader: a commitment to nonsense is a loss, not a\nrefusal. Once per player. Emits `BoardCommitted` and `ShipsPlaced`.",
      "kind": "call",
      "params": [
        [
          "matchId",
          "string"
        ],
        [
          "commitment",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "createMatch": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Challenge `player2` (an account that has opened the lobby, still in\nthe app's org, and not the caller). Returns the new match id,\n`{creator}-{ms}-{nonce}`. Emits `MatchCreated` and `MatchListUpdated`.",
      "kind": "call",
      "params": [
        [
          "player2",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "getActiveMatchId": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's newest match that is not over yet (being played, or\nwaiting for a reveal), or `None`. v1 answered the one match its game\ncontext was for.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "option<string>"
    },
    "getCurrentTurn": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The player whose turn it is to shoot, or `None` once the match is over.",
      "kind": "view",
      "params": [
        [
          "matchId",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<string>"
    },
    "getCurrentUser": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's account: the id they play as.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "getHistory": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every finished match, in the order the results were recorded (oldest\nfirst).",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<MatchRecord>"
    },
    "getIncomingShots": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The opponent's shots at the caller, as a grid: what the client lays\nover the board on the device to draw \"your waters\". Players only.",
      "kind": "view",
      "params": [
        [
          "matchId",
          "string"
        ]
      ],
      "public": false,
      "returns": "ShotsView"
    },
    "getMatchState": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Everything a client needs about a match in one read. Players only.",
      "kind": "view",
      "params": [
        [
          "matchId",
          "string"
        ]
      ],
      "public": false,
      "returns": "MatchStateView"
    },
    "getMatches": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every match, oldest id first.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<MatchSummary>"
    },
    "getPlayerStats": {
      "allowSystem": false,
      "confirm": false,
      "doc": "A player's record, or `None` before their first result.",
      "kind": "view",
      "params": [
        [
          "player",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<PlayerStatsView>"
    },
    "getPlayers": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Every registered player, by account.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<PlayerEntry>"
    },
    "getShots": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's shots at the opponent, as a grid. Players only.",
      "kind": "view",
      "params": [
        [
          "matchId",
          "string"
        ]
      ],
      "public": false,
      "returns": "ShotsView"
    },
    "getWinner": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The winner, once the match is over AND the winner's revealed board has\npassed the audit. `None` while playing, while waiting for a reveal, and\nfor a match both players cheated in.",
      "kind": "view",
      "params": [
        [
          "matchId",
          "string"
        ]
      ],
      "public": false,
      "returns": "option<string>"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The empty lobby. The node runs it once, when the instance is created.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "proposeShot": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Fire at `(x, y)` on the opponent's board: the caller's turn, both\nboards committed, no shot waiting for an answer, a cell not shot\nbefore. Emits `ShotProposed`; the defender's CLIENT answers it.",
      "kind": "call",
      "params": [
        [
          "matchId",
          "string"
        ],
        [
          "x",
          "u8"
        ],
        [
          "y",
          "u8"
        ]
      ],
      "public": false,
      "returns": null
    },
    "registerPlayer": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Put the caller on the lobby's roster, so others can challenge them,\nand return the id they play as: their account. Idempotent, and cheap\nenough to call on every lobby open. Anyone the app reaches may,\nguests included. Emits `PlayersUpdated` when the caller is new.",
      "kind": "call",
      "params": [],
      "public": false,
      "returns": "string"
    },
    "revealBoard": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Publish the caller's `(board, salt)` for every reader to audit, once\nthe match is over (a board opened mid-game is a board handed to the\nopponent). `boardBytes` is `borsh(Vec<u8>)` of the 100 pristine cells,\nexactly what was hashed into the commitment; `salt` is its 16 bytes.\nA pair that does not hash to the commitment is refused\n(`CommitmentMismatch`), so the player can retry with the right board.\nA pair that does is on record for good, and if the answers the player\ngave do not fit it, they fail the audit and the game goes to the\nopponent. When this decides the match, the result is recorded in the\nlobby (history, stats) in the same call. Emits `BoardRevealed`,\n`AuditPassed`/`AuditFailed`, then `Winner` and `MatchEnded` (or only\n`MatchEnded` for a void match), `MatchListUpdated` and\n`PlayerStatsUpdated`.",
      "kind": "call",
      "params": [
        [
          "matchId",
          "string"
        ],
        [
          "boardBytes",
          "bytes"
        ],
        [
          "salt",
          "bytes"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
  "state": {
    "fields": {
      "history": "vector",
      "matches": "unorderedMap",
      "players": "set",
      "results": "unorderedMap",
      "reveals": "unorderedMap",
      "stats": "unorderedMap",
      "turns": "unorderedMap"
    },
    "search": {
      "history": [],
      "matches": [],
      "players": [],
      "results": [],
      "reveals": [],
      "stats": [],
      "turns": []
    },
    "version": 1
  },
