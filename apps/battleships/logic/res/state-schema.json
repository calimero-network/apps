{
  "schema_version": "wasm-abi/1",
  "types": {
    "LobbyState": {
      "kind": "record",
      "fields": [
        {
          "name": "created_ms",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "matches",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "MatchEntry"
            },
            "crdt_type": "authored_map"
          },
          "doc": "match id -> the match, owned by the member who created it."
        },
        {
          "name": "results",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "MatchRecord"
            },
            "crdt_type": "authored_map"
          },
          "doc": "`\"<match_id>/<nonce>\"` -> a result a game context reported."
        },
        {
          "name": "players",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "kind": "record",
              "fields": [],
              "crdt_type": "lww_register",
              "inner_type": {
                "kind": "string"
              }
            }
          },
          "doc": "account -> the player key that account plays as, written only by it.\n\n`LwwRegister` so a member who rejoins with a fresh context identity\nconverges on the newer key."
        }
      ]
    },
    "MatchEntry": {
      "kind": "record",
      "doc": "A match as its creator recorded it, keyed by match id and owned by them.",
      "fields": [
        {
          "name": "player1",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player2",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "player2_account",
          "type": {
            "kind": "string"
          },
          "doc": "The ACCOUNT player 2 registered their key under — what the game\ncontext checks player 2's rows against."
        },
        {
          "name": "context_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "created_ms",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "MatchRecord": {
      "kind": "record",
      "doc": "One reported result, keyed `\"<match_id>/<nonce>\"`.\n\nIndexed by winner and loser, so a player's stats are two index seeks rather\nthan a scan of every match, and by match, so the reader can gather every\nreport of one match.",
      "fields": [
        {
          "name": "match_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "winner",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "loser",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "finished_ms",
          "type": {
            "kind": "u64"
          }
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "LobbyState",
  "state_version": 1
}