# Battleships app environment variables — ALL OPTIONAL.
#
# Nothing in this file has to be set to build or deploy the app. The package
# name and registry URL both have committed defaults in src/App.tsx, and the
# applicationId is resolved per node off the registry during login. Copy this
# file to `.env.local` (git-ignored) only to point at a local registry or node.

# Override the registry package id (default: com.calimero.battleships).
# VITE_PACKAGE_NAME=com.calimero.battleships

# Override the registry (default: https://apps.calimero.network).
# VITE_REGISTRY_URL=http://localhost:8082

# ⚠️ Do NOT set this for a deployment. An ApplicationId is assigned PER
# INSTALL, so an id baked at build time is wrong on every node but the one it
# was copied from — and core answers a request naming an unknown application
# with an opaque 500, not a 404. It exists only as a last-resort fallback for
# non-component code on an offline/self-hosted node.
# VITE_APPLICATION_ID=

# Node the match page talks to (default: http://node1.127.0.0.1.nip.io).
# VITE_NODE_URL=http://localhost:2428
