{
  "name": "battleships",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@calimero-network/mero-js": "catalog:",
    "@calimero-network/mero-react": "catalog:",
    "@calimero-network/mero-ui": "catalog:",
    "axios": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "styled-components": "^6.1.11",
    "vite-plugin-environment": "^1.1.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@calimero-network/abi-codegen": "catalog:",
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "catalog:",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^7.3.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "prettier": "3.3.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^7.1.11",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "catalog:"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "codegen": "calimero-abi-codegen -i ../logic/res/abi.json -o src/generated/lobby --client-name LobbyClient && calimero-abi-codegen -i ../logic/crates/game/res/abi.json -o src/generated/game --client-name GameClient",
    "lint": "concurrently \"pnpm:lint:*(!fix)\"",
    "lint:src": "eslint . --ext .ts,.tsx src --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\"",
    "lint:src:fix": "eslint . --ext .ts,.tsx --fix src",
    "preview": "vite preview",
    "predeploy": "pnpm run build",
    "prettier": "exec prettier . --write",
    "test": "vitest run",
    "e2e:landing": "playwright test --project=landing",
    "e2e:integration": "playwright test --project=integration",
    "e2e:report": "playwright show-report playwright-report"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "e2e/**"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
