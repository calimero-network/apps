# Rust / WASM
logic/target/
# NOT `res/` wholesale — that hides res/abi.json, and the Components workflow's
# ABI-staleness check then has nothing to diff. The root .gitignore covers the
# built res/*.wasm.
logic/res/*.mpk
logic/res/bundle-temp/
logic/dist/

# Frontend
app/node_modules/
app/dist/
app/dist-types/
app/.env.development.local

# misc
.DS_Store
*.log
/data/

# Publisher keypair — never commit real keys
logic/calimero.json
logic/key.json
