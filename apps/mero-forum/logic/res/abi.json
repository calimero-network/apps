{
  "abiVersion": 1,
  "errors": {
    "Forbidden": {
      "message": "string"
    },
    "Invalid": {
      "message": "string"
    },
    "NotFound": {
      "id": "string",
      "what": "string"
    }
  },
  "events": {
    "CommentCreated": {
      "id": "string",
      "postId": "string"
    },
    "CommentDeleted": {
      "id": "string",
      "postId": "string"
    },
    "CommentEdited": {
      "id": "string",
      "postId": "string"
    },
    "CommentVoted": {
      "commentId": "string",
      "postId": "string"
    },
    "ModeratorsChanged": {
      "count": "u64"
    },
    "PostCreated": {
      "id": "string"
    },
    "PostDeleted": {
      "id": "string"
    },
    "PostEdited": {
      "id": "string"
    },
    "ProfileSet": {
      "account": "string"
    },
    "Voted": {
      "postId": "string"
    }
  },
  "methods": {
    "createComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replies to a post as the caller and returns the comment's id. `body` must\nnot be blank (at most 10,000 bytes); `NotFound` for a missing post.\nEmits `CommentCreated`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "createPost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Starts a thread written by the caller and returns its id. `title` (at\nmost 300 bytes) and `body` (at most 10,000) must not be blank, else\n`Invalid`. Emits `PostCreated`.",
      "kind": "call",
      "params": [
        [
          "title",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "deleteComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes the caller's own comment and its votes. Only its author may\n(`Forbidden`; a moderator uses `moderateComment`). Emits `CommentDeleted`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "deletePost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Deletes the caller's own post, with its comments and every vote on them.\nOnly its author may (`Forbidden`; a moderator uses `moderatePost`).\nEmits `PostDeleted`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replaces a comment's body. Only its author may (`Forbidden`). Emits\n`CommentEdited`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "editPost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replaces a post's title and body. Only its author may (`Forbidden`);\n`NotFound` for a missing post. Emits `PostEdited`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "title",
          "string"
        ],
        [
          "body",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "getNickname": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The name `account` chose, or \"\" when it has not chosen one.",
      "kind": "view",
      "params": [
        [
          "account",
          "string"
        ]
      ],
      "public": false,
      "returns": "string"
    },
    "getPost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One post with its score, comment count and the caller's vote.\n`NotFound` for a missing (or deleted) post.",
      "kind": "view",
      "params": [
        [
          "postId",
          "string"
        ]
      ],
      "public": false,
      "returns": "PostView"
    },
    "init": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The empty forum. The node runs it once, when the app is created; its\nowner (v1's founder) is the first moderator.",
      "kind": "init",
      "params": [],
      "public": false,
      "returns": null
    },
    "listComments": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One page of a post's comments, oldest first. `cursor` is the previous\npage's `nextCursor`, `null` for the first; `limit` as in `listPosts`. A\npost with no comments (or none at all) is an empty page.",
      "kind": "view",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "cursor",
          "option<string>"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "CommentPage"
    },
    "listPosts": {
      "allowSystem": false,
      "confirm": false,
      "doc": "One page of the feed. `sort` is `\"new\"` (default: newest first) or\n`\"top\"` (highest score first, then newest). `cursor` is the previous\npage's `nextCursor` (opaque, and only good for the same sort), `null` for\nthe first page. `limit` 0 means 20; more than 100 means 100.",
      "kind": "view",
      "params": [
        [
          "sort",
          "option<string>"
        ],
        [
          "cursor",
          "option<string>"
        ],
        [
          "limit",
          "u32"
        ]
      ],
      "public": false,
      "returns": "PostPage"
    },
    "moderateComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes anyone's comment as a moderator, with its votes (`Forbidden` for\nanyone else). Emits `CommentDeleted`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "moderatePost": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Removes anyone's post as a moderator, with its comments and votes\n(`Forbidden` for anyone else). Emits `PostDeleted`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "moderators": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The accounts that may remove any post or comment, in key order.",
      "kind": "view",
      "params": [],
      "public": false,
      "returns": "list<string>"
    },
    "setModerators": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Replaces the moderators. Only a moderator may (`Forbidden`). Every\naccount must be the forum's owner or in its organization, and the list\nmust not be empty (`Invalid`). Emits `ModeratorsChanged`.",
      "kind": "call",
      "params": [
        [
          "accounts",
          "list<string>"
        ]
      ],
      "public": false,
      "returns": null
    },
    "setNickname": {
      "allowSystem": false,
      "confirm": false,
      "doc": "Claims a display name for the CALLER (trimmed, at most 64 bytes, else\n`Invalid`); an empty name clears it. Names are not unique and authorise\nnothing. Emits `ProfileSet`.",
      "kind": "call",
      "params": [
        [
          "name",
          "string"
        ]
      ],
      "public": false,
      "returns": null
    },
    "vote": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's vote on a post: up (1), down (-1) or retract (0); anything\nelse is `Invalid`. One per account: voting again replaces it. `NotFound`\nfor a missing post. Emits `Voted`.",
      "kind": "call",
      "params": [
        [
          "postId",
          "string"
        ],
        [
          "value",
          "i8"
        ]
      ],
      "public": false,
      "returns": null
    },
    "voteComment": {
      "allowSystem": false,
      "confirm": false,
      "doc": "The caller's vote on a comment, as `vote` for a post. `NotFound` for a\nmissing comment. Emits `CommentVoted`.",
      "kind": "call",
      "params": [
        [
          "commentId",
          "string"
        ],
        [
          "value",
          "i8"
        ]
      ],
      "public": false,
      "returns": null
    }
  },
  "state": {
    "fields": {
      "commentVotes": "unorderedMap",
      "comments": "table",
      "moderators": "set",
      "posts": "table",
      "profiles": "perUser",
      "votes": "unorderedMap"
    },
    "search": {
      "commentVotes": [],
      "comments": [],
      "moderators": [],
      "posts": [],
      "profiles": [],
      "votes": []
    },
    "version": 1
  },
  "types": {
    "CommentPage": {
      "fields": [
        [
          "items",
          "list<CommentView>"
        ],
        [
          "nextCursor",
          "option<string>"
        ]
      ],
      "kind": "record"
    },
    "CommentView": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "postId",
          "string"
        ],
        [
          "author",
          "string"
        ],
        [
          "authorName",
          "string"
        ],
        [
          "body",
          "string"
        ],
        [
          "createdAt",
          "u64"
        ],
        [
          "editedAt",
          "u64"
        ],
        [
          "score",
          "i64"
        ],
        [
          "myVote",
          "i8"
        ]
      ],
      "kind": "record"
    },
    "PostPage": {
      "fields": [
        [
          "items",
          "list<PostView>"
        ],
        [
          "nextCursor",
          "option<string>"
        ]
      ],
      "kind": "record"
    },
    "PostView": {
      "fields": [
        [
          "id",
          "string"
        ],
        [
          "author",
          "string"
        ],
        [
          "authorName",
          "string"
        ],
        [
          "title",
          "string"
        ],
        [
          "body",
          "string"
        ],
        [
          "createdAt",
          "u64"
        ],
        [
          "editedAt",
          "u64"
        ],
        [
          "score",
          "i64"
        ],
        [
          "commentCount",
          "u64"
        ],
        [
          "myVote",
          "i8"
        ]
      ],
      "kind": "record"
    }
  },
  "world": "calimero:app@0.5.7"
}
