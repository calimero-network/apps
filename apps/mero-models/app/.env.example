# The node this frontend talks to. mero-react discovers a local node on the
# usual local ports when this is unset, so local development needs no .env.
VITE_NODE_URL=http://localhost:2528

# The registry the login callback resolves this app's package against. Defaults
# to the public registry; only set it when pointing at a staging one.
VITE_REGISTRY_URL=https://apps.calimero.network
