{
  "name": "mero-models",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "codegen": "calimero-abi-codegen -i ../logic/res/abi.json -o src/generated --client-name MeroModelsClient --import-path @calimero-network/mero-js",
    "icons": "node scripts/gen-icons.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@calimero-apps/invite": "workspace:*",
    "@calimero-network/mero-icons": "catalog:",
    "@calimero-network/mero-js": "catalog:",
    "@calimero-network/mero-platform": "catalog:",
    "@calimero-network/mero-platform-react": "catalog:",
    "@calimero-network/mero-react": "catalog:",
    "bs58": "catalog:",
    "fflate": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "three": "^0.185.1",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@calimero-apps/e2e-node": "workspace:*",
    "@calimero-network/abi-codegen": "catalog:",
    "@playwright/test": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "tweetnacl": "^1.0.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
