{
  "schema_version": "wasm-abi/1",
  "types": {
    "BlockOverride": {
      "kind": "record",
      "doc": "A stored block edit: block id `b` and the stamp that orders concurrent edits.",
      "fields": [
        {
          "name": "b",
          "type": {
            "kind": "u32"
          },
          "doc": "Block id, 0 to 15; 0 is air (a broken block)."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          },
          "doc": "Room-clock unix seconds; the larger stamp wins when two players edit one block."
        }
      ]
    },
    "MeroBlocks": {
      "kind": "record",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "string"
            }
          }
        },
        {
          "name": "seed",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "lww_register",
            "inner_type": {
              "kind": "u64"
            }
          }
        },
        {
          "name": "overrides",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "BlockOverride"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "\"x,y,z\" -> override. Set-only (break = b:0), never removed."
        },
        {
          "name": "players",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Player"
            },
            "crdt_type": "unordered_map"
          }
        },
        {
          "name": "reap_marks",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "ReapMark"
            },
            "crdt_type": "unordered_map"
          }
        }
      ]
    },
    "Player": {
      "kind": "record",
      "doc": "A player row: presence and last known transform, keyed by the player's identity.",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          },
          "doc": "The player's context identity (device key, 64 hex)."
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "z",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "yaw",
          "type": {
            "kind": "f64"
          },
          "doc": "Radians."
        },
        {
          "name": "pitch",
          "type": {
            "kind": "f64"
          },
          "doc": "Radians."
        },
        {
          "name": "sel",
          "type": {
            "kind": "u32"
          },
          "doc": "Selected hotbar slot, 0 to 8; peers render what the player holds."
        },
        {
          "name": "left",
          "type": {
            "kind": "bool"
          },
          "doc": "explicitly left (or reaped); row is kept, never removed"
        },
        {
          "name": "joined_at",
          "type": {
            "kind": "u64"
          },
          "doc": "Room-clock unix seconds."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "u64"
          },
          "doc": "Room-clock unix seconds."
        }
      ]
    },
    "ReapMark": {
      "kind": "record",
      "doc": "Presence bookkeeping: when a silent player was marked stale, and the row stamp seen then.",
      "fields": [
        {
          "name": "marked_at",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "row_ts",
          "type": {
            "kind": "u64"
          }
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "MeroBlocks",
  "state_version": 1
}