{
  "schema_version": "wasm-abi/1",
  "types": {
    "Avatars": {
      "kind": "record",
      "doc": "One account's avatars, keyed by device (see `caller`). The slot belongs to\nthe account, and so does the map nested in it: every node refuses another\naccount's write to either, so nobody can move, rename or evict someone\nelse's avatar, or squat a device id before its owner first joins.",
      "fields": [
        {
          "name": "devices",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Player"
            },
            "crdt_type": "unordered_map"
          }
        }
      ]
    },
    "BlockOverride": {
      "kind": "record",
      "doc": "One block override: `b` is the block id (0 = air / broken).",
      "fields": [
        {
          "name": "b",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "room-time stamp for LWW convergence when two peers edit the same block"
        }
      ]
    },
    "MeroBlocks": {
      "kind": "record",
      "fields": [
        {
          "name": "meta",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "$ref": "WorldMeta"
            }
          },
          "doc": "name + seed + day-clock anchor. Every client derives the terrain from\nthe seed, so changing it after creation would rebuild the world under\neveryone's edits: frozen, nobody (the creator included) can."
        },
        {
          "name": "overrides",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "BlockOverride"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "\"x,y,z\" -> override. Set-only (break = b:0), never removed. Public on\npurpose: the world is collaborative."
        },
        {
          "name": "players",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Avatars"
            }
          }
        }
      ]
    },
    "Player": {
      "kind": "record",
      "doc": "A player row: identity-keyed presence + last known transform.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "z",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "yaw",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "pitch",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "sel",
          "type": {
            "kind": "u32"
          },
          "doc": "selected hotbar slot (cosmetic — lets peers render what you hold)"
        },
        {
          "name": "left",
          "type": {
            "kind": "bool"
          },
          "doc": "explicitly left; row is kept, never removed"
        },
        {
          "name": "joinedAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "WorldMeta": {
      "kind": "record",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "seed",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    }
  },
  "methods": [],
  "events": [],
  "state_root": "MeroBlocks",
  "state_version": 1
}