{
  "schema_version": "wasm-abi/1",
  "types": {
    "Avatars": {
      "kind": "record",
      "doc": "One account's avatars, keyed by device (see `caller`). The slot belongs to\nthe account, and so does the map nested in it: every node refuses another\naccount's write to either, so nobody can move, rename or evict someone\nelse's avatar, or squat a device id before its owner first joins.",
      "fields": [
        {
          "name": "devices",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Player"
            },
            "crdt_type": "unordered_map"
          }
        }
      ]
    },
    "BlockEntry": {
      "kind": "record",
      "fields": [
        {
          "name": "k",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "b",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "BlockOverride": {
      "kind": "record",
      "doc": "One block override: `b` is the block id (0 = air / broken).",
      "fields": [
        {
          "name": "b",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          },
          "doc": "room-time stamp for LWW convergence when two peers edit the same block"
        }
      ]
    },
    "Edit": {
      "kind": "record",
      "doc": "One edit in a `set_blocks` batch.",
      "fields": [
        {
          "name": "x",
          "type": {
            "kind": "i32"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "i32"
          }
        },
        {
          "name": "z",
          "type": {
            "kind": "i32"
          }
        },
        {
          "name": "b",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "MeroBlocks": {
      "kind": "record",
      "fields": [
        {
          "name": "meta",
          "type": {
            "kind": "record",
            "fields": [],
            "crdt_type": "shared_storage",
            "inner_type": {
              "$ref": "WorldMeta"
            }
          },
          "doc": "name + seed + day-clock anchor. Every client derives the terrain from\nthe seed, so changing it after creation would rebuild the world under\neveryone's edits: frozen, nobody (the creator included) can."
        },
        {
          "name": "overrides",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "BlockOverride"
            },
            "crdt_type": "unordered_map"
          },
          "doc": "\"x,y,z\" -> override. Set-only (break = b:0), never removed. Public on\npurpose: the world is collaborative."
        },
        {
          "name": "players",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "Avatars"
            }
          }
        }
      ]
    },
    "Player": {
      "kind": "record",
      "doc": "A player row: identity-keyed presence + last known transform.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "z",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "yaw",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "pitch",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "sel",
          "type": {
            "kind": "u32"
          },
          "doc": "selected hotbar slot (cosmetic — lets peers render what you hold)"
        },
        {
          "name": "left",
          "type": {
            "kind": "bool"
          },
          "doc": "explicitly left; row is kept, never removed"
        },
        {
          "name": "joinedAt",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "updatedAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "PlayerView": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "z",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "yaw",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "pitch",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "sel",
          "type": {
            "kind": "u32"
          }
        },
        {
          "name": "online",
          "type": {
            "kind": "bool"
          }
        }
      ]
    },
    "Transform": {
      "kind": "record",
      "doc": "Incoming transform for `heartbeat`.",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "x",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "y",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "z",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "yaw",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "pitch",
          "type": {
            "kind": "f64"
          }
        },
        {
          "name": "sel",
          "type": {
            "kind": "u32"
          }
        }
      ]
    },
    "WorldMeta": {
      "kind": "record",
      "fields": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "seed",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "createdAt",
          "type": {
            "kind": "u64"
          }
        }
      ]
    }
  },
  "methods": [
    {
      "name": "get_overrides",
      "doc": "Full override map — join/reconcile pull. O(edits), not O(world).",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "BlockEntry"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "get_players",
      "doc": "Roster with liveness — peers render everyone `online`. A player who\nvanished without `leave` simply ages out of the TTL here; nobody\nwrites to another account's row to mark it.",
      "params": [
        {
          "name": "now",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "PlayerView"
        }
      },
      "intent": "read_only"
    },
    {
      "name": "heartbeat",
      "doc": "Liveness + transform ping. SILENT (no event): peers poll `get_players`\nevery ~1.5s; emitting per-heartbeat would spam SSE for every member\n(mero-meet's silent-heartbeat pattern).",
      "params": [
        {
          "name": "t",
          "type": {
            "$ref": "Transform"
          }
        },
        {
          "name": "now",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "init",
      "doc": "`now` is the creator's unix-seconds clock — it anchors the shared\nday/night cycle (WASM has no wall clock; mero-meet convention).",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "seed",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "now",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "join",
      "doc": "Join (or rejoin) the world. Idempotent upsert of my player row.",
      "params": [
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "now",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "$ref": "PlayerView"
      },
      "intent": "mutating"
    },
    {
      "name": "leave",
      "params": [
        {
          "name": "now",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      },
      "intent": "mutating"
    },
    {
      "name": "override_count",
      "params": [],
      "returns": {
        "kind": "u32"
      },
      "intent": "read_only"
    },
    {
      "name": "set_blocks",
      "doc": "Apply a batch of block edits. Out-of-bounds edits are skipped (not an\nerror: a stale client must not poison a whole batch). Returns the\nnumber of edits applied.",
      "params": [
        {
          "name": "edits",
          "type": {
            "kind": "list",
            "items": {
              "$ref": "Edit"
            }
          }
        },
        {
          "name": "now",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "u32"
      },
      "intent": "mutating"
    },
    {
      "name": "world_meta",
      "params": [],
      "returns": {
        "$ref": "WorldMeta"
      },
      "intent": "read_only"
    }
  ],
  "events": [
    {
      "name": "BlocksChanged",
      "payload": {
        "kind": "string"
      },
      "doc": "Blocks changed by this member (payload = editor id). Clients re-pull\n`get_overrides` on receipt — event is a nudge, the state is the truth."
    },
    {
      "name": "Initialized"
    },
    {
      "name": "PlayerJoined",
      "payload": {
        "kind": "string"
      }
    },
    {
      "name": "PlayerLeft",
      "payload": {
        "kind": "string"
      }
    }
  ],
  "state_root": "MeroBlocks",
  "state_version": 1
}