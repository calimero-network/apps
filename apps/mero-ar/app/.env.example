# Where the page connects (packages/connect). Under `vite` it is merod local;
# the iOS app on a development node signs in with a software passkey itself and
# never opens this page, so nothing here is needed for local development.
#
# VITE_CALIMERO_TARGET=local
# VITE_CALIMERO_NODES=http://127.0.0.1:2501,http://127.0.0.1:2502,http://127.0.0.1:2503

# A production build (`vite build`) is the page the cluster serves from Mero
# AR's bundle. It refuses to start without the release floor; the release
# workflow passes both. Set them there, never per developer.
VITE_CALIMERO_CLUSTER=
VITE_CALIMERO_MIN_RELEASE=

# Optional: try this zone's nodes first; another node directory (staging).
# VITE_CALIMERO_ZONE=
# VITE_CALIMERO_DIRECTORY=
