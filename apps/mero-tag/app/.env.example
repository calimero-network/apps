# Where the page connects (packages/connect). The page is the iOS app's
# Calimero Cloud sign-in, so it only does anything on the cluster that serves
# it; locally `pnpm -F mero-tag dev` talks to merod local on 2501-2503.
#
# VITE_CALIMERO_TARGET=local
# VITE_CALIMERO_NODES=http://127.0.0.1:2501,http://127.0.0.1:2502,http://127.0.0.1:2503

# A production build (`vite build`) refuses to start without the release floor.
# Set it where the bundle's frontend is built (the release workflow), never per
# developer. On the page a cluster serves, its own node list is used.
VITE_CALIMERO_CLUSTER=
VITE_CALIMERO_MIN_RELEASE=
