{
  "name": "@calimero-network/apps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "codegen": "pnpm -r codegen",
    "check:metadata": "bash scripts/check-app-metadata.sh",
    "landing:generate": "node scripts/landing/generate.mjs",
    "landing:check": "node scripts/landing/generate.mjs --check"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "base-x@2.0.6": "3.0.11",
      "@calimero-network/mero-js": "link:../mero-js-signer",
      "@calimero-network/mero-react": "link:../mero-react",
      "@calimero-network/abi-codegen": "link:../mero-devtools-js/abi-codegen"
    }
  }
}
