{
  "name": "@calimero-apps/install",
  "version": "0.1.0",
  "private": true,
  "description": "Installing an app as a desktop / home-screen app: its service worker, the browser's install prompt and the button that opens it.",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./vite": {
      "types": "./src/vite.d.ts",
